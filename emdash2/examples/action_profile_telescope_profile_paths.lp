  : τ (@= (Hom (Functor_cat (Hom_cat B W (@fapp0 A B F X)) (Hom_cat B W (@fapp0 A B F Y))) (@hom_postcomp_func B A F W X Y f) (@hom_postcomp_func B A F W X Y h)) (@comp_fapp0 (Functor_cat (Hom_cat B W (@fapp0 A B F X)) (Hom_cat B W (@fapp0 A B F Y))) (@hom_postcomp_func B A F W X Y f) (@hom_postcomp_func B A F W X Y g) (@hom_postcomp_func B A F W X Y h) (@hom_postcomp_tele_transf B A F W X Y g h beta) (@hom_postcomp_tele_transf B A F W X Y f g alpha)) (@hom_postcomp_tele_transf B A F W X Y f h (@comp_fapp0 (Hom_cat A X Y) f g h beta alpha)))
≔ @eq_ap (Hom (Functor_cart_cat (Hom_cat B W (@fapp0 A B F X)) (Hom_cat B W (@fapp0 A B F Y))) (@hom_postcomp_func B A F W X Y f) (@hom_postcomp_func B A F W X Y h)) (Hom (Functor_cat (Hom_cat B W (@fapp0 A B F X)) (Hom_cat B W (@fapp0 A B F Y))) (@hom_postcomp_func B A F W X Y f) (@hom_postcomp_func B A F W X Y h))
    (λ theta : τ (Hom (Functor_cart_cat (Hom_cat B W (@fapp0 A B F X)) (Hom_cat B W (@fapp0 A B F Y))) (@hom_postcomp_func B A F W X Y f) (@hom_postcomp_func B A F W X Y h)), @fapp1_fapp0 (Functor_cart_cat (Hom_cat B W (@fapp0 A B F X)) (Hom_cat B W (@fapp0 A B F Y))) (Functor_cat (Hom_cat B W (@fapp0 A B F X)) (Hom_cat B W (@fapp0 A B F Y))) (Functor_cart_include (Hom_cat B W (@fapp0 A B F X)) (Hom_cat B W (@fapp0 A B F Y))) (@hom_postcomp_func B A F W X Y f) (@hom_postcomp_func B A F W X Y h) theta)
    (@comp_fapp0 (Functor_cart_cat (Hom_cat B W (@fapp0 A B F X)) (Hom_cat B W (@fapp0 A B F Y))) (@hom_postcomp_func B A F W X Y f) (@hom_postcomp_func B A F W X Y g) (@hom_postcomp_func B A F W X Y h) (@hom_postcomp_tele_fapp1_fapp0 B A F W X Y g h beta) (@hom_postcomp_tele_fapp1_fapp0 B A F W X Y f g alpha))
    (@hom_postcomp_tele_fapp1_fapp0 B A F W X Y f h (@comp_fapp0 (Hom_cat A X Y) f g h beta alpha))
    (@eq_sym (Hom (Functor_cart_cat (Hom_cat B W (@fapp0 A B F X)) (Hom_cat B W (@fapp0 A B F Y))) (@hom_postcomp_func B A F W X Y f) (@hom_postcomp_func B A F W X Y h)) (@hom_postcomp_tele_fapp1_fapp0 B A F W X Y f h (@comp_fapp0 (Hom_cat A X Y) f g h beta alpha)) (@comp_fapp0 (Functor_cart_cat (Hom_cat B W (@fapp0 A B F X)) (Hom_cat B W (@fapp0 A B F Y))) (@hom_postcomp_func B A F W X Y f) (@hom_postcomp_func B A F W X Y g) (@hom_postcomp_func B A F W X Y h) (@hom_postcomp_tele_fapp1_fapp0 B A F W X Y g h beta) (@hom_postcomp_tele_fapp1_fapp0 B A F W X Y f g alpha))
    (@profile_composition_path (Hom_cat A X Y) (Functor_cart_cat (Hom_cat B W (@fapp0 A B F X)) (Hom_cat B W (@fapp0 A B F Y))) (@hom_postcomp_tele_func B A F W X Y) PT f g h beta alpha));

