require open emdash.emdash3_2;

assert [Z : Cat] (x y z : τ (Obj Z))
  (p : τ (Hom Z x y))
  (q : τ (Hom Z y z)) ⊢
  @fapp0
    (Hom_cat Z y z)
    (Hom_cat Z x z)
    (@tapp0_fapp0
      Z
      Cat_cart
      (@Rep_catd Z y)
      (@Rep_catd Z x)
      z
      (@piapp0 (@PathOut_cat Z x) (@CompMotive_catd Z x)
        (@fapp0
            (Fibre_cat (@CompMotive_catd Z x) (@pathout_refl_obj Z x))
            (@Pi_cat (@PathOut_cat Z x) (@CompMotive_catd Z x))
            (@tapp0_fapp0
              _ Cat_cart _ _
              (@CompMotive_catd Z x)
              (@strict_transfor _ _ _ _ (@tdapp0_fapp0
                Z
                (@PathOutMotives_catd Z)
                (@Const_catd Z Cat_cart)
                (@PathOutReflEval_funcd Z)
                (@PathOutPi_funcd Z)
                x
                (@PathInd_transfd Z))))
            (@id_funcd Z (@Rep_catd Z x)))
        (@pathout_obj Z x y p)))
    q
    ≡ @hom_precomp_along_fapp0 Z Z (@id_func Z) z x y p q;

assert [Z : Cat] (x y z : τ (Obj Z))
  (p : τ (Hom Z x y))
  (q : τ (Hom Z y z)) ⊢
  @fapp0
    (Hom_cat Z y z)
    (Hom_cat Z x z)
    (@tapp0_fapp0
      Z
      Cat_cart
      (@Rep_catd Z y)
      (@Rep_catd Z x)
      z
      (@piapp0 (@PathOut_cat Z x) (@CompMotive_catd Z x)
        (@fapp0
            (Fibre_cat (@CompMotive_catd Z x) (@pathout_refl_obj Z x))
            (@Pi_cat (@PathOut_cat Z x) (@CompMotive_catd Z x))
            (@tapp0_fapp0
              (@Sigma_cat Z (@PathOutMotives_catd Z))
              Cat_cart
              (@PathIndSrc_catd Z)
              (@PathIndTgt_catd Z)
              (Struct_sigma x (@CompMotive_catd Z x))
              (@PathInd_funcd Z))
            (@id_funcd Z (@Rep_catd Z x)))
        (@pathout_obj Z x y p)))
    q
    ≡ @hom_precomp_along_fapp0 Z Z (@id_func Z) z x y p q;
