assert [B I C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
  (D : τ (Functor B (Functor_oplax_cat I C))) ⊢
  @eq_refl (Functor B (Functor_oplax_cat I C))
    (@fapp0 _ _ (@one_cat_family_oplax_exchange_func I B C C1)
      (@diagram_oplax_family_shape_func B I C D))
  : τ (@= (Functor B (Functor_oplax_cat I C))
      (@fapp0 _ _ (@one_cat_family_oplax_exchange_func I B C C1)
        (@diagram_oplax_family_shape_func B I C D)) D);
assertnot [B I C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
  (D E : τ (Functor B (Functor_oplax_cat I C))) ⊢
  @eq_refl (Functor B (Functor_oplax_cat I C))
    (@fapp0 _ _ (@one_cat_family_oplax_exchange_func I B C C1)
      (@diagram_oplax_family_shape_func B I C D))
  : τ (@= (Functor B (Functor_oplax_cat I C))
      (@fapp0 _ _ (@one_cat_family_oplax_exchange_func I B C C1)
        (@diagram_oplax_family_shape_func B I C D)) E);
// This is a proof-time comparison, preserving the existing runtime owners.
assertnot [B I C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
  (D : τ (Functor B (Functor_oplax_cat I C))) ⊢
  @fapp0 (Functor_cat I (Functor_cat B C)) (Functor_cat B (Functor_oplax_cat I C))
    (@one_cat_family_oplax_exchange_func I B C C1)
    (@diagram_oplax_family_shape_func B I C D)
  ≡ D;
