// Existing component-first intrinsic composition, before the new whole comparison.
assert [K B : Cat] (H : τ (Functor K B)) [P Q : τ (Obj B)]
  (e : τ (Hom B P Q)) (E : τ (Catd K))
  (L : τ (@Functord K E (@hom_ B K H Q)))
  [x y : τ (Obj K)] (p : τ (Hom K x y)) (u : τ (Obj (Fibre_cat E x))) ⊢
  (@fdapp1_int_cell K E (@hom_ B K H P) (@comp_catd_fapp0 K E (@hom_ B K H Q) (@hom_ B K H P) (@strict_transfor K Cat_cart (@hom_ B K H Q) (@hom_ B K H P) (@hom_int_precomp_func B K H Q P e)) L) x y p u)
  ≡ @fapp1_fapp0 (Fibre_cat (@hom_ B K H Q) y) (Fibre_cat (@hom_ B K H P) y)
    (@Fibre_func K (@hom_ B K H Q) (@hom_ B K H P) (@strict_transfor K Cat_cart (@hom_ B K H Q) (@hom_ B K H P) (@hom_int_precomp_func B K H Q P e)) y)
    (fapp0 (@catd_transport_func K (@hom_ B K H Q) x y p) (fapp0 (@Fibre_func K E (@hom_ B K H Q) L x) u))
    (fapp0 (@Fibre_func K E (@hom_ B K H Q) L y) (fapp0 (@catd_transport_func K E x y p) u))
    (@fdapp1_int_cell K E (@hom_ B K H Q) L x y p u);

// The actual whole extraction agrees with the same native component at proof time.
assert [K B : Cat] (H : τ (Functor K B)) [P Q : τ (Obj B)]
  (e : τ (Hom B P Q)) (E : τ (Catd K))
  (L : τ (@Functord K E (@hom_ B K H Q)))
  [x y : τ (Obj K)] (p : τ (Hom K x y)) (u : τ (Obj (Fibre_cat E x))) ⊢
  @eq_refl _ (@tapp0_fapp0 (Fibre_cat E x) (Fibre_cat (@hom_ B K H P) y)
    (@functord_transport_lhs_func K E (@hom_ B K H P) (@comp_catd_fapp0 K E (@hom_ B K H Q) (@hom_ B K H P) (@strict_transfor K Cat_cart (@hom_ B K H Q) (@hom_ B K H P) (@hom_int_precomp_func B K H Q P e)) L) x y p)
    (@functord_transport_rhs_func K E (@hom_ B K H P) (@comp_catd_fapp0 K E (@hom_ B K H Q) (@hom_ B K H P) (@strict_transfor K Cat_cart (@hom_ B K H Q) (@hom_ B K H P) (@hom_int_precomp_func B K H Q P e)) L) x y p) u
    (@functord_laxity_transf K E (@hom_ B K H P) (@comp_catd_fapp0 K E (@hom_ B K H Q) (@hom_ B K H P) (@strict_transfor K Cat_cart (@hom_ B K H Q) (@hom_ B K H P) (@hom_int_precomp_func B K H Q P e)) L) x y p))
  : τ (@= _ (@tapp0_fapp0 (Fibre_cat E x) (Fibre_cat (@hom_ B K H P) y)
    (@functord_transport_lhs_func K E (@hom_ B K H P) (@comp_catd_fapp0 K E (@hom_ B K H Q) (@hom_ B K H P) (@strict_transfor K Cat_cart (@hom_ B K H Q) (@hom_ B K H P) (@hom_int_precomp_func B K H Q P e)) L) x y p)
    (@functord_transport_rhs_func K E (@hom_ B K H P) (@comp_catd_fapp0 K E (@hom_ B K H Q) (@hom_ B K H P) (@strict_transfor K Cat_cart (@hom_ B K H Q) (@hom_ B K H P) (@hom_int_precomp_func B K H Q P e)) L) x y p) u
    (@functord_laxity_transf K E (@hom_ B K H P) (@comp_catd_fapp0 K E (@hom_ B K H Q) (@hom_ B K H P) (@strict_transfor K Cat_cart (@hom_ B K H Q) (@hom_ B K H P) (@hom_int_precomp_func B K H Q P e)) L) x y p)) (@fdapp1_int_cell K E (@hom_ B K H P) (@comp_catd_fapp0 K E (@hom_ B K H Q) (@hom_ B K H P) (@strict_transfor K Cat_cart (@hom_ B K H Q) (@hom_ B K H P) (@hom_int_precomp_func B K H Q P e)) L) x y p u));

// The capped square keeps its actual middle arrow.
assertnot [K B : Cat] (H : τ (Functor K B)) [P Q : τ (Obj B)]
  (e : τ (Hom B P Q)) [x y : τ (Obj K)] (p : τ (Hom K x y))
  (a other : τ (Hom B Q (@fapp0 K B H x))) ⊢
  @eq_refl (Hom B P (@fapp0 K B H y))
    (@hom_precomp_along_fapp0 B B (@id_func B) (@fapp0 K B H y) P Q e
      (@hom_postcomp_fapp0 B K H Q x y p a))
  : τ (@= (Hom B P (@fapp0 K B H y))
    (@hom_precomp_along_fapp0 B B (@id_func B) (@fapp0 K B H y) P Q e
      (@hom_postcomp_fapp0 B K H Q x y p a))
    (@hom_postcomp_fapp0 B K H P x y p
      (@hom_precomp_along_fapp0 B B (@id_func B) (@fapp0 K B H x) P Q e other)));

// A supplied modification on the composite is not its canonical intrinsic action.
assertnot   [K B : Cat] (H : τ (Functor K B))
  (P Q : τ (Obj B)) (e : τ (Hom B P Q))
  (E : τ (Catd K))
  (L : τ (@Functord K E (@hom_ B K H Q)))
  (omega : τ (@Transfd K E (fapp0 (Homd_target_index_func K) (@Homd_coeff_diagram K E))
    (@fdapp1_projection_target K E (@hom_ B K H P) (@comp_catd_fapp0 K E (@hom_ B K H Q) (@hom_ B K H P) (@strict_transfor K Cat_cart (@hom_ B K H Q) (@hom_ B K H P) (@hom_int_precomp_func B K H Q P e)) L))
    (@fdapp1_projection_source K E)))
  [x y : τ (Obj K)] (p : τ (Hom K x y))
  ⊢ let M : τ (Catd K) ≔ @hom_ B K H Q in
  let D : τ (Catd K) ≔ @hom_ B K H P in
  let A : τ (@Functord K M D) ≔ @strict_transfor K Cat_cart M D
    (@hom_int_precomp_func B K H Q P e) in
  let C : τ (@Functord K E D) ≔ @comp_catd_fapp0 K E M D A L in
  let S : Cat ≔ @Fibre_cat K E x in
  let Mx : Cat ≔ @Fibre_cat K M x in
  let Ey : Cat ≔ @Fibre_cat K E y in
  let My : Cat ≔ @Fibre_cat K M y in
  let Dy : Cat ≔ @Fibre_cat K D y in
  let targetL : τ (Functor S My) ≔
    @hom_postcomp_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) S Ey My
      (@Fibre_func K E M L y) (@catd_transport_func K E x y p) in
  @eq_refl (@Transf S Dy
      (@comp_cat_fapp0 S Mx Dy
        (@Hom_func B Q P (@fapp0 K B H x) (@fapp0 K B H y) e (@fapp1_fapp0 K B H x y p))
        (@Fibre_func K E M L x))
      (@hom_postcomp_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) S My Dy
        (@hom_precomp_along_func B B (@id_func B) (@fapp0 K B H y) P Q e) targetL))
    (@fdapp1_comma_projection_transf K E D C omega x y p)
  : let M : τ (Catd K) ≔ @hom_ B K H Q in
    let D : τ (Catd K) ≔ @hom_ B K H P in
    let A : τ (@Functord K M D) ≔ @strict_transfor K Cat_cart M D
      (@hom_int_precomp_func B K H Q P e) in
    let C : τ (@Functord K E D) ≔ @comp_catd_fapp0 K E M D A L in
    let S : Cat ≔ @Fibre_cat K E x in
    let Mx : Cat ≔ @Fibre_cat K M x in
    let Ey : Cat ≔ @Fibre_cat K E y in
    let My : Cat ≔ @Fibre_cat K M y in
    let Dy : Cat ≔ @Fibre_cat K D y in
    let Hy : τ (Functor My Dy) ≔
      @hom_precomp_along_func B B (@id_func B) (@fapp0 K B H y) P Q e in
    let sourceL : τ (Functor S My) ≔
      @hom_postcomp_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) S Mx My
        (@catd_transport_func K M x y p) (@Fibre_func K E M L x) in
    let targetL : τ (Functor S My) ≔
      @hom_postcomp_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) S Ey My
        (@Fibre_func K E M L y) (@catd_transport_func K E x y p) in
    let sourceC : τ (Functor S Dy) ≔ @comp_cat_fapp0 S Mx Dy
      (@Hom_func B Q P (@fapp0 K B H x) (@fapp0 K B H y) e (@fapp1_fapp0 K B H x y p))
      (@Fibre_func K E M L x) in
    let targetC : τ (Functor S Dy) ≔
      @hom_postcomp_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) S My Dy Hy targetL in
    let post : τ (Functor (Functor_cat S My) (Functor_cat S Dy)) ≔
      @hom_postcomp_func Cat_cat Cat_cat (@id_func Cat_cat) S My Dy Hy in
    τ (@= (@Transf S Dy sourceC targetC)
      (@fdapp1_comma_projection_transf K E D C omega x y p)
      (@fapp1_fapp0 (Functor_cat S My) (Functor_cat S Dy) post
        sourceL targetL
        (@functord_laxity_transf K E M L x y p)));

// The retained earlier modification must also be its actual intrinsic action.
assertnot   [K B : Cat] (H : τ (Functor K B))
  (P Q : τ (Obj B)) (e : τ (Hom B P Q))
  (E : τ (Catd K))
  (L : τ (@Functord K E (@hom_ B K H Q)))
  (omega : τ (@Transfd K E (fapp0 (Homd_target_index_func K) (@Homd_coeff_diagram K E))
    (@fdapp1_projection_target K E (@hom_ B K H Q) L)
    (@fdapp1_projection_source K E)))
  [x y : τ (Obj K)] (p : τ (Hom K x y))
  ⊢ let M : τ (Catd K) ≔ @hom_ B K H Q in
  let D : τ (Catd K) ≔ @hom_ B K H P in
  let A : τ (@Functord K M D) ≔ @strict_transfor K Cat_cart M D
    (@hom_int_precomp_func B K H Q P e) in
  let C : τ (@Functord K E D) ≔ @comp_catd_fapp0 K E M D A L in
  let S : Cat ≔ @Fibre_cat K E x in
  let Mx : Cat ≔ @Fibre_cat K M x in
  let Ey : Cat ≔ @Fibre_cat K E y in
  let My : Cat ≔ @Fibre_cat K M y in
  let Dy : Cat ≔ @Fibre_cat K D y in
  let targetL : τ (Functor S My) ≔
    @hom_postcomp_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) S Ey My
      (@Fibre_func K E M L y) (@catd_transport_func K E x y p) in
  @eq_refl (@Transf S Dy
      (@comp_cat_fapp0 S Mx Dy
        (@Hom_func B Q P (@fapp0 K B H x) (@fapp0 K B H y) e (@fapp1_fapp0 K B H x y p))
        (@Fibre_func K E M L x))
      (@hom_postcomp_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) S My Dy
        (@hom_precomp_along_func B B (@id_func B) (@fapp0 K B H y) P Q e) targetL))
    (@functord_laxity_transf K E D C x y p)
  : let M : τ (Catd K) ≔ @hom_ B K H Q in
    let D : τ (Catd K) ≔ @hom_ B K H P in
    let A : τ (@Functord K M D) ≔ @strict_transfor K Cat_cart M D
      (@hom_int_precomp_func B K H Q P e) in
    let C : τ (@Functord K E D) ≔ @comp_catd_fapp0 K E M D A L in
    let S : Cat ≔ @Fibre_cat K E x in
    let Mx : Cat ≔ @Fibre_cat K M x in
    let Ey : Cat ≔ @Fibre_cat K E y in
    let My : Cat ≔ @Fibre_cat K M y in
    let Dy : Cat ≔ @Fibre_cat K D y in
    let Hy : τ (Functor My Dy) ≔
      @hom_precomp_along_func B B (@id_func B) (@fapp0 K B H y) P Q e in
    let sourceL : τ (Functor S My) ≔
      @hom_postcomp_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) S Mx My
        (@catd_transport_func K M x y p) (@Fibre_func K E M L x) in
    let targetL : τ (Functor S My) ≔
      @hom_postcomp_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) S Ey My
        (@Fibre_func K E M L y) (@catd_transport_func K E x y p) in
    let sourceC : τ (Functor S Dy) ≔ @comp_cat_fapp0 S Mx Dy
      (@Hom_func B Q P (@fapp0 K B H x) (@fapp0 K B H y) e (@fapp1_fapp0 K B H x y p))
      (@Fibre_func K E M L x) in
    let targetC : τ (Functor S Dy) ≔
      @hom_postcomp_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) S My Dy Hy targetL in
    let post : τ (Functor (Functor_cat S My) (Functor_cat S Dy)) ≔
      @hom_postcomp_func Cat_cat Cat_cat (@id_func Cat_cat) S My Dy Hy in
    τ (@= (@Transf S Dy sourceC targetC)
      (@functord_laxity_transf K E D C x y p)
      (@fapp1_fapp0 (Functor_cat S My) (Functor_cat S Dy) post
        sourceL targetL
        (@fdapp1_comma_projection_transf K E M L omega x y p)));
