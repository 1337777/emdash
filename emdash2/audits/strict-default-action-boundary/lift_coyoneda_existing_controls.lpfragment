// NON-LIBRARY existing-owner controls. These add no new computation rule.
// The restored unchanged co-Yoneda beta consumes an actual tensor generator.
assert [I A B : Cat] (P : τ (Prof A B))
  (a : τ (Functor I A)) (m : τ (Functor I B))
  (p : τ (@Prof_hom I A B a P m)) ⊢
  @Prof_cell_apply I A B A B
    (@Prof_tensor A B B P (@Unit_prof B)) P
    (@id_func A) (@id_func B) a m
    (@Prof_coyoneda_cov_map A B P)
    (@Prof_tensor_hom_hom I A B B P (@Unit_prof B) a m m
      p (@Prof_func_hom I B m))
  ≡ p;

// Direct eval(lambda(co-Yoneda)) followed by the same existing shaped beta.
assert [I A B : Cat] (P : τ (Prof A B))
  (a : τ (Functor I A)) (m : τ (Functor I B))
  (p : τ (@Prof_hom I A B a P m)) ⊢
  @Prof_cell_apply I A B A B
    (@Prof_tensor A B B P (@Unit_prof B)) P
    (@id_func A) (@id_func B) a m
    (@Prof_eval_cov_map A B B P (@Unit_prof B) P
      (@Prof_lambda_cov_map A B B P (@Unit_prof B) P
        (@Prof_coyoneda_cov_map A B P)))
    (@Prof_tensor_hom_hom I A B B P (@Unit_prof B) a m m
      p (@Prof_func_hom I B m))
  ≡ p;

// The actual canonical raw counit at id_B needs no reindex/eval bridge.
assert [I B : Cat] (a m : τ (Functor I B))
  (p : τ (@Prof_hom I B B a (@Unit_prof B) m)) ⊢
  @Prof_cell_apply I B B B B
    (@Prof_tensor B B B (@Unit_prof B) (@Unit_prof B)) (@Unit_prof B)
    (@id_func B) (@id_func B) a m
    (@raw_represented_counit B B (@id_func B))
    (@Prof_tensor_hom_hom I B B B (@Unit_prof B) (@Unit_prof B) a m m
      p (@Prof_func_hom I B m))
  ≡ p;

// Existing beta retains the actual shaped element.
assertnot [I A B : Cat] (P : τ (Prof A B))
  (a : τ (Functor I A)) (m : τ (Functor I B))
  (p p' : τ (@Prof_hom I A B a P m)) ⊢
  @Prof_cell_apply I A B A B
    (@Prof_tensor A B B P (@Unit_prof B)) P
    (@id_func A) (@id_func B) a m
    (@Prof_coyoneda_cov_map A B P)
    (@Prof_tensor_hom_hom I A B B P (@Unit_prof B) a m m
      p (@Prof_func_hom I B m))
  ≡ p';
