// The ordinary counterpart of the existing native/Cartesian arrow-point
// comparisons, after exchange has distributed over the admission composite.
// The literal comparison constructor supplies the original OneCat scope.
unif_rule @comp_fapp0 Cat_cat _ _ _
    (@sym_fapp0_func _ $K $C
      (@defiso_to _ _ _ (@one_cat_mapping_comparison $K $C _)) $x)
    (@join_elim_func Terminal_cat Terminal_cat _
      (@Const_func _ _ $F) (@Const_func _ _ $G) (@Const_func _ _ $eta))
  ≡ @join_elim_func $A $B $E
      (@Const_func _ _ $Fx) (@Const_func _ _ $Gx) (@Const_func _ _ $etax)
  ↪ [ $A ≡ Terminal_cat; $B ≡ Terminal_cat; $E ≡ $C;
      $Fx ≡ @fapp0 $K $C $F $x; $Gx ≡ @fapp0 $K $C $G $x;
      $etax ≡ @tapp0_fapp0 $K $C $F $G $x $eta ];

// The same point comparison after the outer ordinary exchange has already
// exposed its admission and inverse factors. Retain that actual comparison
// and compare the three supplied walking-arrow data explicitly.
unif_rule @comp_fapp0 Cat_cat _ _ _
    (@defiso_from _ _ _ (@one_cat_mapping_comparison (Join_cat Terminal_cat Terminal_cat) $C $ord))
    (@sym_func _ $B $C
      (@comp_fapp0 Cat_cat _ _ _
        (@comp_fapp0 Cat_cat _ _ _
          (@defiso_to _ _ _ (@one_cat_mapping_comparison $B $C $ord))
          (@sym_fapp0_func _ $I (Functor_cat $B $C)
            (@defiso_to _ _ _ (@one_cat_mapping_comparison $I (Functor_cat $B $C) _)) $i))
        (@join_elim_func Terminal_cat Terminal_cat _
          (@Const_func _ _ $F) (@Const_func _ _ $G) (@Const_func _ _ $eta))))
  ≡ @comp_fapp0 Cat_cat _ _ _
    (@defiso_from _ _ _ (@one_cat_mapping_comparison (Join_cat Terminal_cat Terminal_cat) $C $ord))
    (@sym_func _ $B $C
      (@comp_fapp0 Cat_cat _ _ _
        (@defiso_to _ _ _ (@one_cat_mapping_comparison $B $C $ord))
        (@join_elim_func Terminal_cat Terminal_cat _
          (@Const_func _ _ $Fi) (@Const_func _ _ $Gi) (@Const_func _ _ $etai))))
  ↪ [ $Fi ≡ @fapp0 $I (Functor_cat $B $C) $F $i;
      $Gi ≡ @fapp0 $I (Functor_cat $B $C) $G $i;
      $etai ≡ @tapp0_fapp0 $I (Functor_cat $B $C) $F $G $i $eta ];
