// Public Cat and both Q mapping levels keep the default lax transfors.
assert [A B : Cat] ⊢ Hom_cat Cat_cat A B ≡ Functor_cat A B;
assert [A B : Cat] ⊢ Hom_cat sf_q_cat A B
  ≡ Functor_cat A (Functor_cat (Op_cat B) Cat_cat);

assert [A B : Cat] (F : τ (Functor A B)) (a : τ (Obj A)) (b : τ (Obj B)) ⊢
  fapp0 (fapp0 (@sf_q_rep A B F) a) b ≡ Hom_cat B b (fapp0 F a);
assert [A : Cat] ⊢ @sf_q_rep A A (@id_func A) ≡ @id sf_q_cat A;
assert [A B C : Cat] (F : τ (Functor A B)) (G : τ (Functor B C)) ⊢
  @comp_fapp0 sf_q_cat A B C (@sf_q_rep B C G) (@sf_q_rep A B F)
  ≡ @sf_q_rep A C (@comp_cat_fapp0 A B C G F);

assert [A B C : Cat] (F : τ (Functor A B)) (P : τ (Hom sf_q_cat B C)) ⊢
  @comp_fapp0 sf_q_cat A B C P (@sf_q_rep A B F)
  ≡ @comp_cat_fapp0 A B (Functor_cat (Op_cat C) Cat_cat) P F;

// The covariant inclusion retains actual lax transformation components.
assert [A B : Cat] [F G : τ (Functor A B)] (eta : τ (@Transf A B F G))
  (a : τ (Obj A)) (b : τ (Obj B)) ⊢
  @tapp0_fapp0 (Op_cat B) Cat_cat
    (@hom_con B (fapp0 F a) B (@id_func B))
    (@hom_con B (fapp0 G a) B (@id_func B)) b
    (@tapp0_fapp0 A (Functor_cat (Op_cat B) Cat_cat)
      (@sf_q_rep A B F) (@sf_q_rep A B G) a
      (@fapp1_fapp0 (Functor_cat A B) (Functor_cat A (Functor_cat (Op_cat B) Cat_cat))
        (sf_q_rep_func A B) F G eta))
  ≡ @hom_postcomp_func B B (@id_func B) b (fapp0 F a) (fapp0 G a)
      (@tapp0_fapp0 A B F G a eta);

assert [K : Cat] [E D : τ (Functor K Cat_cat)]
  (U : τ (Obj (@sf_family_map_cat K E D))) (y : τ (Obj K)) ⊢
  @tapp0_fapp0 K sf_q_cat (@sf_q_diagram K D) (@sf_q_diagram K E) y
    (@sf_q_mate K E D U)
  ≡ @hom_con_int (fapp0 D y) (fapp0 E y)
      (@tapp0_fapp0 K Cat_cat E D y (@sf_family_map_view K E D U));

assertnot [K : Cat] [E D : τ (Functor K Cat_cat)]
  (U : τ (@Transf K Cat_cat E D)) ⊢
  @sf_q_mate K E D U
  : τ (@Transf K sf_q_cat (@sf_q_diagram K D) (@sf_q_diagram K E));

assert [K : Cat] (E : τ (Functor K Cat_cat)) ⊢
  @sf_q_mate K E E (@id (sf_family_cat K) E)
  ≡ @id (Functor_cat K sf_q_cat) (@sf_q_diagram K E);

// The actual internal y-section and its direct telescope.
assert [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  (u : τ (Obj (fapp0 E x))) ⊢
  @sf_homd_id_src_sec K E x u
  : τ (@Transf K sf_q_cat (@sf_q_diagram K E)
      (@sf_q_diagram K (@hom_ K K (@id_func K) x)));

assert [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  (u : τ (Obj (fapp0 E x))) (y : τ (Obj K)) ⊢
  @sf_homd_id_tgt_func K E x u y
  ≡ @hom_con_int (fapp0 E y) (Hom_cat K x y) (@fib_cov_tapp0_func K E x y u);

assert [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  (u : τ (Obj (fapp0 E x))) (y : τ (Obj K))
  (v : τ (Obj (fapp0 E y))) (f : τ (Hom K x y)) ⊢
  fapp0 (@sf_homd_id_ K E x u y v) f
  ≡ Hom_cat (fapp0 E y) (fapp0 (@fapp1_fapp0 K Cat_cat E x y f) u) v;

// Noninvertible index two-cells enter with the corrected T direction.
assert [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  (u : τ (Obj (fapp0 E x))) (y : τ (Obj K)) (v : τ (Obj (fapp0 E y)))
  [f g : τ (Hom K x y)] (alpha : τ (Hom (Hom_cat K x y) f g)) ⊢
  @fapp1_fapp0 (Op_cat (Hom_cat K x y)) Cat_cat (@sf_homd_id_ K E x u y v) g f alpha
  : τ (Functor
      (Hom_cat (fapp0 E y) (fapp0 (@fapp1_fapp0 K Cat_cat E x y g) u) v)
      (Hom_cat (fapp0 E y) (fapp0 (@fapp1_fapp0 K Cat_cat E x y f) u) v));

assertnot [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  (u : τ (Obj (fapp0 E x))) (y : τ (Obj K)) (v : τ (Obj (fapp0 E y)))
  [f g : τ (Hom K x y)] (alpha : τ (Hom (Hom_cat K x y) f g)) ⊢
  @fapp1_fapp0 (Op_cat (Hom_cat K x y)) Cat_cat (@sf_homd_id_ K E x u y v) f g alpha
  : τ (Functor
      (Hom_cat (fapp0 E y) (fapp0 (@fapp1_fapp0 K Cat_cat E x y f) u) v)
      (Hom_cat (fapp0 E y) (fapp0 (@fapp1_fapp0 K Cat_cat E x y g) u) v));

assert [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  (u : τ (Obj (fapp0 E x))) (y z : τ (Obj K)) (q : τ (Hom K y z)) ⊢
  fapp0 (@tapp1_func K sf_q_cat (@sf_q_diagram K E)
    (@sf_q_diagram K (@hom_ K K (@id_func K) x)) y z
    (@sf_homd_id_src_sec K E x u)) q
  ≡ @tapp1_fapp0 K sf_q_cat (@sf_q_diagram K E)
      (@sf_q_diagram K (@hom_ K K (@id_func K) x)) y z
      (@sf_homd_id_src_sec K E x u) q;

// Whole y-arrow action computes through the curried represented composition.
assert [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  (u : τ (Obj (fapp0 E x))) (y z : τ (Obj K)) (q : τ (Hom K y z))
  (v : τ (Obj (fapp0 E y))) (f : τ (Hom K x z)) ⊢
  fapp0 (fapp0
    (@tapp1_fapp0 K sf_q_cat (@sf_q_diagram K E)
      (@sf_q_diagram K (@hom_ K K (@id_func K) x)) y z
      (@sf_homd_id_src_sec K E x u) q) v) f
  ≡ Hom_cat (fapp0 E z)
      (fapp0 (@fapp1_fapp0 K Cat_cat E x z f) u)
      (fapp0 (@fapp1_fapp0 K Cat_cat E y z q) v);

assert [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  (u : τ (Obj (fapp0 E x))) (y : τ (Obj K)) ⊢
  @tapp1_fapp0 K sf_q_cat (@sf_q_diagram K E)
    (@sf_q_diagram K (@hom_ K K (@id_func K) x)) y y
    (@sf_homd_id_src_sec K E x u) (@id K y)
  ≡ @sf_homd_id_tgt_func K E x u y;

// The full Hom of the base-action functor remains iterable and preserves
// the possibility of a nonidentity higher base cell.
assert [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  (u : τ (Obj (fapp0 E x))) (y z : τ (Obj K)) [q r : τ (Hom K y z)]
  (alpha : τ (Hom (Hom_cat K y z) q r)) ⊢
  @fapp1_fapp0 (Hom_cat K y z)
    (Functor_cat (fapp0 E y) (Functor_cat (Op_cat (Hom_cat K x z)) Cat_cat))
    (@sf_q_mate_action K (@hom_ K K (@id_func K) x) E (@sf_fibcov K E x u) y z)
    q r alpha
  : τ (@Transf (fapp0 E y) (Functor_cat (Op_cat (Hom_cat K x z)) Cat_cat)
      (fapp0 (@sf_q_mate_action K (@hom_ K K (@id_func K) x) E (@sf_fibcov K E x u) y z) q)
      (fapp0 (@sf_q_mate_action K (@hom_ K K (@id_func K) x) E (@sf_fibcov K E x u) y z) r));
