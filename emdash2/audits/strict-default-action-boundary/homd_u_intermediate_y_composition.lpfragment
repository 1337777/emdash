// Generic modification evaluation versus composition in the Cartesian Q Hom.
// h:u0->u1 and k:u1->u2 induce the reversed section/component order.
assert [K : Cat] (E : τ (Catd K)) (x : τ (Obj K)) [u0 u1 u2 : τ (Obj (@Fibre_cat K E x))]
  (h : τ (Hom (@Fibre_cat K E x) u0 u1)) (k : τ (Hom (@Fibre_cat K E x) u1 u2)) (y : τ (Obj K)) ⊢
  (@tapp0_hom_fapp0 K Prof_cov_universe
    (@Prof_cov_diagram K E) (@Prof_cov_diagram K (@hom_ K K (@id_func K) x))
    (@homd_id_src_sec K E x u2) (@homd_id_src_sec K E x u0) y
    (@comp_fapp0 (@Homd_section_cat K E x) (@homd_id_src_sec K E x u2) (@homd_id_src_sec K E x u1) (@homd_id_src_sec K E x u0)
      (@homd_id_u_map K E x u0 u1 h) (@homd_id_u_map K E x u1 u2 k)))
  ≡ (@comp_fapp0 (Functor_cart_cat (@Fibre_cat K E y) (Functor_cart_cat (Op_cat (Hom_cat K x y)) Cat_cat)) (@homd_id_tgt_func K E x u2 y) (@homd_id_tgt_func K E x u1 y) (@homd_id_tgt_func K E x u0 y)
    (@homd_id_u_y K E x u0 u1 h y) (@homd_id_u_y K E x u1 u2 k y));

// Compare that actual generic projection with the stable composite-input rung.
assert [K : Cat] (E : τ (Catd K)) (x : τ (Obj K)) [u0 u1 u2 : τ (Obj (@Fibre_cat K E x))]
  (h : τ (Hom (@Fibre_cat K E x) u0 u1)) (k : τ (Hom (@Fibre_cat K E x) u1 u2)) (y : τ (Obj K)) ⊢
  (@tapp0_hom_fapp0 K Prof_cov_universe
    (@Prof_cov_diagram K E) (@Prof_cov_diagram K (@hom_ K K (@id_func K) x))
    (@homd_id_src_sec K E x u2) (@homd_id_src_sec K E x u0) y
    (@comp_fapp0 (@Homd_section_cat K E x) (@homd_id_src_sec K E x u2) (@homd_id_src_sec K E x u1) (@homd_id_src_sec K E x u0)
      (@homd_id_u_map K E x u0 u1 h) (@homd_id_u_map K E x u1 u2 k)))
  ≡ (@homd_id_u_y K E x u0 u2 (@comp_fapp0 (@Fibre_cat K E x) u0 u1 u2 k h) y);
