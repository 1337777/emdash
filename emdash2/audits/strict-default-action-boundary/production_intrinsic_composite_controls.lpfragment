// Contravariance of the actual target-index functor, before any new law.
assert [K : Cat] (E D C : τ (Catd K))
  (FF : τ (Functord E D)) (GG : τ (Functord D C)) ⊢
  @eq_refl (Hom (Functor_cart_cat K Cat_cart)
      (@Homd_target_catd K C) (@Homd_target_catd K E))
    (@Homd_target_map K E C (@comp_fapp0 (Functor_cat K Cat_cart) E D C GG FF))
  : τ (@= (Hom (Functor_cart_cat K Cat_cart)
      (@Homd_target_catd K C) (@Homd_target_catd K E))
    (@Homd_target_map K E C (@comp_fapp0 (Functor_cat K Cat_cart) E D C GG FF))
    (@comp_fapp0 (Functor_cart_cat K Cat_cart)
      (@Homd_target_catd K C) (@Homd_target_catd K D) (@Homd_target_catd K E)
      (@Homd_target_map K E D FF) (@Homd_target_map K D C GG)));

// Contravariance of the actual target-index functor, before any new law.
assert [K : Cat] (E D C : τ (Catd K))
  (FF : τ (Functord E D)) (GG : τ (Functord D C)) ⊢
  @eq_refl (Hom (Functor_cart_cat K Cat_cart)
      (@Homd_target_catd K C) (@Homd_target_catd K E))
    (@Homd_target_map K E C (@comp_catd_fapp0 K E D C GG FF))
  : τ (@= (Hom (Functor_cart_cat K Cat_cart)
      (@Homd_target_catd K C) (@Homd_target_catd K E))
    (@Homd_target_map K E C (@comp_catd_fapp0 K E D C GG FF))
    (@comp_fapp0 (Functor_cart_cat K Cat_cart)
      (@Homd_target_catd K C) (@Homd_target_catd K D) (@Homd_target_catd K E)
      (@Homd_target_map K E D FF) (@Homd_target_map K D C GG)));


// A whole candidate constructed only from the two existing intrinsic maps.
symbol intrinsic_comp_check [K : Cat] [E D C : τ (Catd K)]
  (FF : τ (Functord E D)) (GG : τ (Functord D C))
  : τ (@Transfd K E (fapp0 (Homd_target_index_func K) (@Homd_coeff_diagram K E)) (@comp_catd_fapp0 K E C (fapp0 (Homd_target_index_func K) (@Homd_coeff_diagram K E)) (@homd_int K E C (@comp_catd_fapp0 K E D C GG FF)) (@comp_catd_fapp0 K E D C GG FF)) (@strict_transfor K Cat_cart E (fapp0 (Homd_target_index_func K) (@Homd_coeff_diagram K E)) (@homd_id_int K E)))
≔ let W : τ (Functor (@Functord_cat K D (fapp0 (Homd_target_index_func K) (@Homd_coeff_diagram K D))) (@Functord_cat K E (fapp0 (Homd_target_index_func K) (@Homd_coeff_diagram K E))))
    ≔ @Hom_func (Catd_cat K) D E (fapp0 (Homd_target_index_func K) (@Homd_coeff_diagram K D)) (fapp0 (Homd_target_index_func K) (@Homd_coeff_diagram K E)) FF (@strict_transfor K Cat_cart (fapp0 (Homd_target_index_func K) (@Homd_coeff_diagram K D)) (fapp0 (Homd_target_index_func K) (@Homd_coeff_diagram K E)) (@Homd_target_map K E D FF)) in
  @comp_fapp0 (@Functord_cat K E (fapp0 (Homd_target_index_func K) (@Homd_coeff_diagram K E)))
    (@comp_catd_fapp0 K E C (fapp0 (Homd_target_index_func K) (@Homd_coeff_diagram K E)) (@homd_int K E C (@comp_catd_fapp0 K E D C GG FF)) (@comp_catd_fapp0 K E D C GG FF))
    (@comp_catd_fapp0 K E D (fapp0 (Homd_target_index_func K) (@Homd_coeff_diagram K E)) (@homd_int K E D FF) FF)
    (@strict_transfor K Cat_cart E (fapp0 (Homd_target_index_func K) (@Homd_coeff_diagram K E)) (@homd_id_int K E))
    (@fdapp1_int_transfd K E D FF)
    (@fapp1_fapp0 (@Functord_cat K D (fapp0 (Homd_target_index_func K) (@Homd_coeff_diagram K D))) (@Functord_cat K E (fapp0 (Homd_target_index_func K) (@Homd_coeff_diagram K E)))
      W (@comp_catd_fapp0 K D C (fapp0 (Homd_target_index_func K) (@Homd_coeff_diagram K D)) (@homd_int K D C GG) GG) (@strict_transfor K Cat_cart D (fapp0 (Homd_target_index_func K) (@Homd_coeff_diagram K D)) (@homd_id_int K D)) (@fdapp1_int_transfd K D C GG));


symbol intrinsic_comp_check_section [K : Cat] [E D C : τ (Catd K)]
  (FF : τ (Functord E D)) (GG : τ (Functord D C))
  (x : τ (Obj K)) (u : τ (Obj (Fibre_cat E x)))
  : τ (Obj (Hom_cat (@Homd_target_section_cat K E x) (@homd_id_src_sec K E x u)
      (@homd_ff_src_sec K E C (@comp_catd_fapp0 K E D C GG FF) x u)))
≔ @tapp0_fapp0 (Fibre_cat E x) (Op_cat (@Homd_target_section_cat K E x)) _ _ u
    (@strict_transfor (Fibre_cat E x) (Op_cat (@Homd_target_section_cat K E x)) _ _
      (tdapp0_fapp0 x (@intrinsic_comp_check K E D C FF GG)));

// Actual projection of the constructed whole modification, with no native
// composite rule installed on fdapp1_int_transfd or its lower heads.
symbol intrinsic_comp_check_index [K : Cat] [E D C : τ (Catd K)]
  (FF : τ (Functord E D)) (GG : τ (Functord D C))
  (x : τ (Obj K)) (u : τ (Obj (Fibre_cat E x)))
  (y : τ (Obj K)) (v : τ (Obj (Fibre_cat E y)))
  : τ (Obj (Hom_cat (Homd_index_cat (Hom_cat K x y))
      (fapp0 (@homd_id_tgt_func K E x u y) v)
      (fapp0 (@homd_ff_tgt_func K E C (@comp_catd_fapp0 K E D C GG FF) x u y) v)))
≔ tapp0_fapp0 v (strict_transfor
    (@tapp0_hom_fapp0 K Homd_coeff_cat (@Homd_coeff_diagram K E)
      (@Homd_coeff_diagram K (@hom_ K K (@id_func K) x))
      (@homd_id_src_sec K E x u) (@homd_ff_src_sec K E C (@comp_catd_fapp0 K E D C GG FF) x u) y
      (@intrinsic_comp_check_section K E D C FF GG x u)));

assert [K : Cat] [E D C : τ (Catd K)]
  (FF : τ (Functord E D)) (GG : τ (Functord D C))
  (x y : τ (Obj K)) (p : τ (Hom K x y))
  (u : τ (Obj (Fibre_cat E x))) (v : τ (Obj (Fibre_cat E y))) ⊢
  @tapp0_fapp0 (Hom_cat K x y) (Op_cat Cat_cart)
    (fapp0 (@homd_ff_tgt_func K E C (@comp_catd_fapp0 K E D C GG FF) x u y) v)
    (fapp0 (@homd_id_tgt_func K E x u y) v) p
    (@intrinsic_comp_check_index K E D C FF GG x u y v)
  ≡ comp_cat_fapp0
      (@fdapp1_int_hom_func K D C GG x y p
        (fapp0 (@Fibre_func K E D FF x) u) (fapp0 (@Fibre_func K E D FF y) v))
      (@fdapp1_int_hom_func K E D FF x y p u v);


// Whole represented body and both next-Hom observation orders.
assert [A B : Cat] (F : τ (Functor A B)) ⊢
  @eq_refl (Functor A (Homd_index_cat B)) (@Homd_coeff_rep A B F)
  : τ (@= (Functor A (Homd_index_cat B)) (@Homd_coeff_rep A B F) (@Homd_coeff_rep_body A B F));
assertnot [A B : Cat] (F G : τ (Functor A B)) ⊢
  @eq_refl (Functor A (Homd_index_cat B)) (@Homd_coeff_rep A B F)
  : τ (@= (Functor A (Homd_index_cat B)) (@Homd_coeff_rep A B F) (@Homd_coeff_rep_body A B G));
assert [A B : Cat] (F : τ (Functor A B)) (a b : τ (Obj A)) (h : τ (Hom A a b)) ⊢
  @fapp1_fapp0 A (Homd_index_cat B) (@Homd_coeff_rep A B F) a b h
  ≡ fapp0 (@fapp1_func A (Homd_index_cat B) (@Homd_coeff_rep_body A B F) a b) h;

// Native root and the original ladder heads compute to the independently
// assembled whole composite and its actual observations.
assert [K : Cat] [E D C : τ (Catd K)]
  (FF : τ (Functord E D)) (GG : τ (Functord D C)) ⊢
  @fdapp1_int_transfd K E C (@comp_catd_fapp0 K E D C GG FF)
  ≡ @intrinsic_comp_check K E D C FF GG;
assert [K : Cat] [E D C : τ (Catd K)]
  (FF : τ (Functord E D)) (GG : τ (Functord D C))
  (x : τ (Obj K)) (u : τ (Obj (Fibre_cat E x))) ⊢
  @fdapp1_int_section_arrow K E C (@comp_catd_fapp0 K E D C GG FF) x u
  ≡ @intrinsic_comp_check_section K E D C FF GG x u;
assert [K : Cat] [E D C : τ (Catd K)]
  (FF : τ (Functord E D)) (GG : τ (Functord D C))
  (x y : τ (Obj K)) (u : τ (Obj (Fibre_cat E x))) ⊢
  @fdapp1_int_tgt_arrow K E C (@comp_catd_fapp0 K E D C GG FF) x u y
  ≡ @tapp0_hom_fapp0 K Homd_coeff_cat (@Homd_coeff_diagram K E)
      (@Homd_coeff_diagram K (@hom_ K K (@id_func K) x))
      (@homd_id_src_sec K E x u)
      (@homd_ff_src_sec K E C (@comp_catd_fapp0 K E D C GG FF) x u) y
      (@intrinsic_comp_check_section K E D C FF GG x u);
assert [K : Cat] [E D C : τ (Catd K)]
  (FF : τ (Functord E D)) (GG : τ (Functord D C))
  (x y : τ (Obj K)) (u : τ (Obj (Fibre_cat E x))) (v : τ (Obj (Fibre_cat E y))) ⊢
  @fdapp1_int_presheaf_arrow K E C (@comp_catd_fapp0 K E D C GG FF) x u y v
  ≡ @intrinsic_comp_check_index K E D C FF GG x u y v;

symbol intrinsic_comp_check_filler [K : Cat] [E D C : τ (Catd K)]
  (FF : τ (Functord E D)) (GG : τ (Functord D C))
  (x y : τ (Obj K)) (p : τ (Hom K x y))
  (u : τ (Obj (Fibre_cat E x))) (v : τ (Obj (Fibre_cat E y)))
  : τ (Functor (Hom_cat (Fibre_cat E y) (fapp0 (catd_transport_func E p) u) v)
      (Hom_cat (Fibre_cat C y)
        (fapp0 (catd_transport_func C p) (fapp0 (Fibre_func (@comp_catd_fapp0 K E D C GG FF) x) u))
        (fapp0 (Fibre_func (@comp_catd_fapp0 K E D C GG FF) y) v)))
≔ @tapp0_fapp0 (Hom_cat K x y) (Op_cat Cat_cart)
    (fapp0 (@homd_ff_tgt_func K E C (@comp_catd_fapp0 K E D C GG FF) x u y) v)
    (fapp0 (@homd_id_tgt_func K E x u y) v) p
    (@intrinsic_comp_check_index K E D C FF GG x u y v);

assert [K : Cat] [E D C : τ (Catd K)]
  (FF : τ (Functord E D)) (GG : τ (Functord D C))
  (x y : τ (Obj K)) (p : τ (Hom K x y))
  (u : τ (Obj (Fibre_cat E x))) (v : τ (Obj (Fibre_cat E y))) ⊢
  @fdapp1_int_hom_func K E C (@comp_catd_fapp0 K E D C GG FF) x y p u v ≡ (@intrinsic_comp_check_filler K E D C FF GG x y p u v);

assert [K : Cat] [E D C : τ (Catd K)]
  (FF : τ (Functord E D)) (GG : τ (Functord D C))
  (x y : τ (Obj K)) (p : τ (Hom K x y))
  (u : τ (Obj (Fibre_cat E x))) (v : τ (Obj (Fibre_cat E y))) (a b : τ (Obj (Hom_cat (Fibre_cat E y) (fapp0 (catd_transport_func E p) u) v))) (theta : τ (Hom (Hom_cat (Fibre_cat E y) (fapp0 (catd_transport_func E p) u) v) a b)) ⊢
  fapp0 (@fapp1_func _ _ (@intrinsic_comp_check_filler K E D C FF GG x y p u v) a b) theta
  ≡ fapp0 (@fapp1_func _ _ (@fdapp1_int_hom_func K D C GG x y p (fapp0 (Fibre_func FF x) u) (fapp0 (Fibre_func FF y) v)) (fapp0 (@fdapp1_int_hom_func K E D FF x y p u v) a) (fapp0 (@fdapp1_int_hom_func K E D FF x y p u v) b))
      (fapp0 (@fapp1_func _ _ (@fdapp1_int_hom_func K E D FF x y p u v) a b) theta);

assertnot [K : Cat] [E D C : τ (Catd K)]
  (FF : τ (Functord E D)) (GG : τ (Functord D C))
  (x y : τ (Obj K)) (p : τ (Hom K x y))
  (u : τ (Obj (Fibre_cat E x))) (v : τ (Obj (Fibre_cat E y))) (a : τ (Obj (Hom_cat (Fibre_cat E y) (fapp0 (catd_transport_func E p) u) v))) (theta : τ (Hom (Hom_cat (Fibre_cat E y) (fapp0 (catd_transport_func E p) u) v) a a)) ⊢
  fapp0 (@fapp1_func _ _ (@intrinsic_comp_check_filler K E D C FF GG x y p u v) a a) theta ≡ @id (Hom_cat (Fibre_cat C y) (fapp0 (catd_transport_func C p) (fapp0 (Fibre_func (@comp_catd_fapp0 K E D C GG FF) x) u)) (fapp0 (Fibre_func (@comp_catd_fapp0 K E D C GG FF) y) v)) (fapp0 (@intrinsic_comp_check_filler K E D C FF GG x y p u v) a);

assert [K : Cat] [E D C : τ (Catd K)]
  (FF : τ (Functord E D)) (GG : τ (Functord D C))
  (x y : τ (Obj K)) (p : τ (Hom K x y)) (u : τ (Obj (Fibre_cat E x))) ⊢
  fapp0 (@intrinsic_comp_check_filler K E D C FF GG x y p u (fapp0 (catd_transport_func E p) u))
      (@id (Fibre_cat E y) (fapp0 (catd_transport_func E p) u))
  ≡ @fdapp1_int_cell K E C (@comp_catd_fapp0 K E D C GG FF) x y p u;
