require open emdash.emdash3_2_arrow_diagram_families;
assert [K C : Cat] (F G : τ (Functor K C)) (eta : τ (@Transf K C F G)) (x : τ (Obj K)) ⊢
 @eq_refl (Obj (Functor_oplax_cat WalkingArrow_cat C))
   (@fapp0 K (Functor_oplax_cat WalkingArrow_cat C) (@transf_arrow_diagram_func K C F G eta) x)
 : τ (@= (Obj (Functor_oplax_cat WalkingArrow_cat C))
   (@fapp0 K (Functor_oplax_cat WalkingArrow_cat C) (@transf_arrow_diagram_func K C F G eta) x)
   (@OddDual_func WalkingArrow_cat C (@walking_arrow_func C (@fapp0 K C F x) (@fapp0 K C G x) (@tapp0_fapp0 K C F G x eta))));
assertnot [K C : Cat] (F G : τ (Functor K C)) (eta : τ (@Transf K C F G)) (x : τ (Obj K))
 (other : τ (Hom C (@fapp0 K C F x) (@fapp0 K C G x))) ⊢
 @eq_refl (Obj (Functor_oplax_cat WalkingArrow_cat C))
   (@fapp0 K (Functor_oplax_cat WalkingArrow_cat C) (@transf_arrow_diagram_func K C F G eta) x)
 : τ (@= (Obj (Functor_oplax_cat WalkingArrow_cat C))
   (@fapp0 K (Functor_oplax_cat WalkingArrow_cat C) (@transf_arrow_diagram_func K C F G eta) x)
   (@OddDual_func WalkingArrow_cat C (@walking_arrow_func C (@fapp0 K C F x) (@fapp0 K C G x) other)));
