// Typed comparisons after source action has already projected. These are
// observations of the selected pre/right convention, not operational proofs.

// ID-SOURCE
symbol conventional_lax_identity_source_join [A : Cat]
  [G : τ (Functor A A)] (epsilon : τ (Transf (@id_func A) G))
  [x y : τ (Obj A)] (p : τ (Hom A x y))
  : τ (@= (Hom A x (fapp0 G y))
      (@comp_fapp0 A _ _ _ (@tapp0_fapp0 A A (@id_func A) G y epsilon) p)
      (@tapp1_fapp0 A A (@id_func A) G x y epsilon p))
≔ @eq_refl (Hom A x (fapp0 G y))
    (@tapp1_fapp0 A A (@id_func A) G x y epsilon p);

// COMPOSITE-SOURCE
symbol conventional_lax_composite_source_join [A B C : Cat]
  [F : τ (Functor A B)] [H : τ (Functor B C)] [G : τ (Functor A C)]
  (epsilon : τ (Transf (@comp_cat_fapp0 A B C H F) G))
  [x y : τ (Obj A)] (p : τ (Hom A x y))
  : τ (@= (Hom C (fapp0 H (fapp0 F x)) (fapp0 G y))
      (@comp_fapp0 C _ _ _
        (@tapp0_fapp0 A C (@comp_cat_fapp0 A B C H F) G y epsilon)
        (@fapp1_fapp0 B C H _ _ (@fapp1_fapp0 A B F x y p)))
      (@tapp1_fapp0 A C (@comp_cat_fapp0 A B C H F) G x y epsilon p))
≔ @eq_refl (Hom C (fapp0 H (fapp0 F x)) (fapp0 G y))
    (@tapp1_fapp0 A C (@comp_cat_fapp0 A B C H F) G x y epsilon p);

// VERTICAL-COMPONENT
symbol conventional_lax_vertical_component_join [A B : Cat]
  [F G H : τ (Functor A B)] (epsilon : τ (Transf F G)) (eta : τ (Transf G H))
  [x y : τ (Obj A)] (p : τ (Hom A x y))
  : τ (@= (Hom B (fapp0 F x) (fapp0 H y))
      (@comp_fapp0 B _ _ _
        (@comp_fapp0 B _ _ _
          (@tapp0_fapp0 A B G H y eta) (@tapp0_fapp0 A B F G y epsilon))
        (@fapp1_fapp0 A B F x y p))
      (@tapp1_fapp0 A B F H x y
        (@comp_fapp0 (Functor_cat A B) F G H eta epsilon) p))
≔ @eq_refl (Hom B (fapp0 F x) (fapp0 H y))
    (@tapp1_fapp0 A B F H x y
      (@comp_fapp0 (Functor_cat A B) F G H eta epsilon) p);

// OPPOSITE-CODOMAIN: ordinary composition has already reversed its factors.
symbol conventional_lax_opposite_codomain_join [A B : Cat]
  [F G : τ (Functor A (Op_cat B))] (epsilon : τ (Transf F G))
  [x y : τ (Obj A)] (p : τ (Hom A x y))
  : τ (@= (Hom B (@fapp0 A (Op_cat B) G y) (@fapp0 A (Op_cat B) F x))
      (@comp_fapp0 B
        (@fapp0 A (Op_cat B) G y)
        (@fapp0 A (Op_cat B) F y)
        (@fapp0 A (Op_cat B) F x)
        (@fapp1_fapp0 A (Op_cat B) F x y p)
        (@tapp0_fapp0 A (Op_cat B) F G y epsilon))
      (@tapp1_fapp0 A (Op_cat B) F G x y epsilon p))
≔ @eq_refl (Hom B (@fapp0 A (Op_cat B) G y) (@fapp0 A (Op_cat B) F x))
    (@tapp1_fapp0 A (Op_cat B) F G x y epsilon p);

// The reversed raw composition reading does not identify the post boundary.
assertnot [A B : Cat] [F G : τ (Functor A (Op_cat B))]
  (epsilon : τ (Transf F G)) [x y : τ (Obj A)] (p : τ (Hom A x y)) ⊢
  @eq_refl (Hom B (@fapp0 A (Op_cat B) G y) (@fapp0 A (Op_cat B) F x))
    (@tapp1_fapp0 A (Op_cat B) F G x y epsilon p)
  : τ (@= (Hom B (@fapp0 A (Op_cat B) G y) (@fapp0 A (Op_cat B) F x))
      (@comp_fapp0 B
        (@fapp0 A (Op_cat B) G y)
        (@fapp0 A (Op_cat B) G x)
        (@fapp0 A (Op_cat B) F x)
        (@tapp0_fapp0 A (Op_cat B) F G x epsilon)
        (@fapp1_fapp0 A (Op_cat B) G x y p))
      (@tapp1_fapp0 A (Op_cat B) F G x y epsilon p));
