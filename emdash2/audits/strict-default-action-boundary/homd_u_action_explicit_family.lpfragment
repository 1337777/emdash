// Explicit intermediate categories for the same derived whole observation.
// No new primitive or computation rule: this isolates composite elaboration.
symbol homd_u_action_family_y [K : Cat] (E : τ (Catd K)) (x : τ (Obj K))
  [u0 u1 : τ (Obj (Fibre_cat E x))] (y : τ (Obj K))
  : τ (Functor (Hom_cat (Fibre_cat E x) u0 u1)
      (Hom_cat (Functor_cart_cat (Fibre_cat E y) (Functor_cart_cat (Op_cat (Hom_cat K x y)) Cat_cat)) (@homd_id_tgt_func K E x u1 y) (@homd_id_tgt_func K E x u0 y)))
≔ @comp_cat_fapp0 (Hom_cat (Fibre_cat E x) u0 u1)
    (Hom_cat (@Homd_section_cat K E x) (@homd_id_src_sec K E x u1) (@homd_id_src_sec K E x u0))
    (Hom_cat (Functor_cart_cat (Fibre_cat E y) (Functor_cart_cat (Op_cat (Hom_cat K x y)) Cat_cat)) (@homd_id_tgt_func K E x u1 y) (@homd_id_tgt_func K E x u0 y))
    (@fapp1_func (@Homd_section_cat K E x) (Functor_cart_cat (Fibre_cat E y) (Functor_cart_cat (Op_cat (Hom_cat K x y)) Cat_cat))
      (@tapp0_func K Prof_cov_universe (@Prof_cov_diagram K E)
        (@Prof_cov_diagram K (@hom_ K K (@id_func K) x)) y) (@homd_id_src_sec K E x u1) (@homd_id_src_sec K E x u0))
    (@fapp1_func (Op_cat (Fibre_cat E x)) (@Homd_section_cat K E x) (@homd_id_src_func K E x) u1 u0);

symbol homd_u_action_family_v [K : Cat] (E : τ (Catd K)) (x : τ (Obj K))
  [u0 u1 : τ (Obj (Fibre_cat E x))] (y : τ (Obj K))
  (v : τ (Obj (Fibre_cat E y)))
  : τ (Functor (Hom_cat (Fibre_cat E x) u0 u1)
      (Hom_cat (Functor_cart_cat (Op_cat (Hom_cat K x y)) Cat_cat) (@homd_id_ K E x u1 y v) (@homd_id_ K E x u0 y v)))
≔ @comp_cat_fapp0 (Hom_cat (Fibre_cat E x) u0 u1)
    (@Transf_cat (Fibre_cat E y) (Functor_cart_cat (Op_cat (Hom_cat K x y)) Cat_cat) (@homd_id_tgt_func K E x u1 y) (@homd_id_tgt_func K E x u0 y))
    (Hom_cat (Functor_cart_cat (Op_cat (Hom_cat K x y)) Cat_cat) (@homd_id_ K E x u1 y v) (@homd_id_ K E x u0 y v))
    (@tapp0_func (Fibre_cat E y) (Functor_cart_cat (Op_cat (Hom_cat K x y)) Cat_cat) (@homd_id_tgt_func K E x u1 y) (@homd_id_tgt_func K E x u0 y) v)
    (@comp_cat_fapp0 (Hom_cat (Fibre_cat E x) u0 u1)
      (Hom_cat (Functor_cart_cat (Fibre_cat E y) (Functor_cart_cat (Op_cat (Hom_cat K x y)) Cat_cat)) (@homd_id_tgt_func K E x u1 y) (@homd_id_tgt_func K E x u0 y))
      (@Transf_cat (Fibre_cat E y) (Functor_cart_cat (Op_cat (Hom_cat K x y)) Cat_cat) (@homd_id_tgt_func K E x u1 y) (@homd_id_tgt_func K E x u0 y))
      (@fapp1_func (Functor_cart_cat (Fibre_cat E y) (Functor_cart_cat (Op_cat (Hom_cat K x y)) Cat_cat)) (Functor_cat (Fibre_cat E y) (Functor_cart_cat (Op_cat (Hom_cat K x y)) Cat_cat))
        (cart_functor_include (Fibre_cat E y) (Functor_cart_cat (Op_cat (Hom_cat K x y)) Cat_cat)) (@homd_id_tgt_func K E x u1 y) (@homd_id_tgt_func K E x u0 y))
      (@homd_u_action_family_y K E x u0 u1 y));

symbol homd_u_action_leaf_family [K : Cat] (E : τ (Catd K)) (x : τ (Obj K))
  [u0 u1 : τ (Obj (Fibre_cat E x))] (y : τ (Obj K))
  (v : τ (Obj (Fibre_cat E y))) (f : τ (Hom K x y))
  : τ (Functor (Hom_cat (Fibre_cat E x) u0 u1)
      (Functor_cart_cat (Hom_cat (Fibre_cat E y) (fapp0 (@fib_cov_tapp0_func K E x y u1) f) v) (Hom_cat (Fibre_cat E y) (fapp0 (@fib_cov_tapp0_func K E x y u0) f) v)))
≔ @comp_cat_fapp0 (Hom_cat (Fibre_cat E x) u0 u1)
    (@Transf_cat (Op_cat (Hom_cat K x y)) Cat_cat (@homd_id_ K E x u1 y v) (@homd_id_ K E x u0 y v))
    (Functor_cart_cat (Hom_cat (Fibre_cat E y) (fapp0 (@fib_cov_tapp0_func K E x y u1) f) v) (Hom_cat (Fibre_cat E y) (fapp0 (@fib_cov_tapp0_func K E x y u0) f) v))
    (@tapp0_func (Op_cat (Hom_cat K x y)) Cat_cat (@homd_id_ K E x u1 y v) (@homd_id_ K E x u0 y v) f)
    (@comp_cat_fapp0 (Hom_cat (Fibre_cat E x) u0 u1)
      (Hom_cat (Functor_cart_cat (Op_cat (Hom_cat K x y)) Cat_cat) (@homd_id_ K E x u1 y v) (@homd_id_ K E x u0 y v))
      (@Transf_cat (Op_cat (Hom_cat K x y)) Cat_cat (@homd_id_ K E x u1 y v) (@homd_id_ K E x u0 y v))
      (@fapp1_func (Functor_cart_cat (Op_cat (Hom_cat K x y)) Cat_cat) (Functor_cat (Op_cat (Hom_cat K x y)) Cat_cat)
        (cart_functor_include (Op_cat (Hom_cat K x y)) Cat_cat) (@homd_id_ K E x u1 y v) (@homd_id_ K E x u0 y v))
      (@homd_u_action_family_v K E x u0 u1 y v));
