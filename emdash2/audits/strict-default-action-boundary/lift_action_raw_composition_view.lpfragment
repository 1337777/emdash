// NON-LIBRARY proof-time reading of the existing runtime owner.
// The predecessor already compares identity-family hom_postcomp_fapp0
// with raw comp_fapp0 by a unif_rule. No runtime fold is added here.
assert [K : Cat] [E D : τ (Catd K)]
  (U : τ (@StrictTransfor K Cat_cat E D)) [x y : τ (Obj K)]
  (q : τ (Hom K x y)) ⊢
  @eq_refl (Hom Prof_cov_universe (Fibre_cat D x) (Fibre_cat E y))
    (@hom_postcomp_fapp0 Prof_cov_universe Prof_cov_universe (@id_func Prof_cov_universe)
      (Fibre_cat D x) (Fibre_cat D y) (Fibre_cat E y)
      (@Prof_cov_companion (Fibre_cat E y) (Fibre_cat D y)
        (@tapp0_fapp0 K Cat_cat E D y (@strict_transfor K Cat_cat E D U)))
      (@fapp1_fapp0 K Prof_cov_universe (@Prof_cov_diagram K D) x y q))
  : τ (@= (Hom Prof_cov_universe (Fibre_cat D x) (Fibre_cat E y))
    (@hom_postcomp_fapp0 Prof_cov_universe Prof_cov_universe (@id_func Prof_cov_universe)
      (Fibre_cat D x) (Fibre_cat D y) (Fibre_cat E y)
      (@Prof_cov_companion (Fibre_cat E y) (Fibre_cat D y)
        (@tapp0_fapp0 K Cat_cat E D y (@strict_transfor K Cat_cat E D U)))
      (@fapp1_fapp0 K Prof_cov_universe (@Prof_cov_diagram K D) x y q))
    (@comp_fapp0 Prof_cov_universe (Fibre_cat D x) (Fibre_cat D y) (Fibre_cat E y)
      (@Prof_cov_companion (Fibre_cat E y) (Fibre_cat D y)
        (@tapp0_fapp0 K Cat_cat E D y (@strict_transfor K Cat_cat E D U)))
      (@fapp1_fapp0 K Prof_cov_universe (@Prof_cov_diagram K D) x y q)));
