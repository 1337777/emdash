// Original row-only assertions 1-4 and 11; the complete column reviewer remains required.
require open emdash.emdash3_2_one_cat_zero_cone_row_families;
assert [B C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C)) [t : τ (Obj C)] (T : τ (@TerminalObject C t)) (R S : τ (Functor B (@ZeroArrowCone_cat C t T))) (m : τ (@Transf B (@ZeroArrowCone_cat C t T) R S)) ⊢ (@one_cat_zero_cone_row_incoming_square_path B C C1 t T R S m) : τ (@= (@Transf B C (@zero_cone_row_family_source_func B C t T R) (@zero_cone_row_family_vertex_func B C t T S walking_arrow_src)) (@comp_fapp0 (Functor_cat B C) (@zero_cone_row_family_source_func B C t T R) (@zero_cone_row_family_vertex_func B C t T R walking_arrow_src) (@zero_cone_row_family_vertex_func B C t T S walking_arrow_src) (@zero_cone_row_family_vertex_map B C t T R S m walking_arrow_src) (@one_cat_zero_cone_row_family_incoming B C C1 t T R)) (@comp_fapp0 (Functor_cat B C) (@zero_cone_row_family_source_func B C t T R) (@zero_cone_row_family_source_func B C t T S) (@zero_cone_row_family_vertex_func B C t T S walking_arrow_src) (@one_cat_zero_cone_row_family_incoming B C C1 t T S) (@zero_cone_row_family_source_map B C t T R S m)));

assert [B C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C)) [t : τ (Obj C)] (T : τ (@TerminalObject C t)) (R S : τ (Functor B (@ZeroArrowCone_cat C t T))) (m : τ (@Transf B (@ZeroArrowCone_cat C t T) R S)) ⊢ (@one_cat_zero_cone_row_outgoing_square_path B C C1 t T R S m) : τ (@= (@Transf B C (@zero_cone_row_family_vertex_func B C t T R walking_arrow_src) (@zero_cone_row_family_vertex_func B C t T S walking_arrow_tgt)) (@comp_fapp0 (Functor_cat B C) (@zero_cone_row_family_vertex_func B C t T R walking_arrow_src) (@zero_cone_row_family_vertex_func B C t T R walking_arrow_tgt) (@zero_cone_row_family_vertex_func B C t T S walking_arrow_tgt) (@zero_cone_row_family_vertex_map B C t T R S m walking_arrow_tgt) (@zero_cone_row_family_outgoing B C t T R)) (@comp_fapp0 (Functor_cat B C) (@zero_cone_row_family_vertex_func B C t T R walking_arrow_src) (@zero_cone_row_family_vertex_func B C t T S walking_arrow_src) (@zero_cone_row_family_vertex_func B C t T S walking_arrow_tgt) (@zero_cone_row_family_outgoing B C t T S) (@zero_cone_row_family_vertex_map B C t T R S m walking_arrow_src)));

assert [B C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C)) [t : τ (Obj C)] (T : τ (@TerminalObject C t)) (R S : τ (Functor B (@ZeroArrowCone_cat C t T))) (m : τ (@Transf B (@ZeroArrowCone_cat C t T) R S)) (x : τ (Obj B)) ⊢ (@tapp0_fapp0 B C (@zero_cone_row_family_source_func B C t T R) (@zero_cone_row_family_source_func B C t T S) x (@zero_cone_row_family_source_map B C t T R S m)) ≡ (@fapp1_fapp0 (@ZeroArrowCone_cat C t T) C (@zero_arrow_cone_first_func C t T) (@fapp0 B (@ZeroArrowCone_cat C t T) R x) (@fapp0 B (@ZeroArrowCone_cat C t T) S x) (@tapp0_fapp0 B (@ZeroArrowCone_cat C t T) R S x m));

assert [B C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C)) [t : τ (Obj C)] (T : τ (@TerminalObject C t)) (R S : τ (Functor B (@ZeroArrowCone_cat C t T))) (m : τ (@Transf B (@ZeroArrowCone_cat C t T) R S)) (x : τ (Obj B)) ⊢ (@tapp0_fapp0 B C (@zero_cone_row_family_vertex_func B C t T R walking_arrow_src) (@zero_cone_row_family_vertex_func B C t T S walking_arrow_src) x (@zero_cone_row_family_vertex_map B C t T R S m walking_arrow_src)) ≡ (@fapp1_fapp0 (@ZeroArrowCone_cat C t T) C (@zero_arrow_cone_vertex_func C t T walking_arrow_src) (@fapp0 B (@ZeroArrowCone_cat C t T) R x) (@fapp0 B (@ZeroArrowCone_cat C t T) S x) (@tapp0_fapp0 B (@ZeroArrowCone_cat C t T) R S x m));

assertnot [B C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C)) [t : τ (Obj C)] (T : τ (@TerminalObject C t)) (R S : τ (Functor B (@ZeroArrowCone_cat C t T))) (m : τ (@Transf B (@ZeroArrowCone_cat C t T) R S)) (m2 : τ (@Transf B (@ZeroArrowCone_cat C t T) R S)) ⊢ (@zero_cone_row_family_source_map B C t T R S m) ≡ (@zero_cone_row_family_source_map B C t T R S m2);
