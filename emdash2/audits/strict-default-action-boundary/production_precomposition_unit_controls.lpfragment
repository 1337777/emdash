// The identity at the raw composite acts on its existing stable presentation.
assert [A B C : Cat] (F : τ (Functor A B)) (G : τ (Functor B C))
  (H : τ (Functor A C))
  (eta : τ (@Transf A C H
    (@hom_precomp_along_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) C A B F G))) ⊢
  @comp_fapp0 (Functor_cat A C) H
    (@hom_precomp_along_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) C A B F G)
    (@hom_precomp_along_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) C A B F G)
    (@id (Functor_cat A C) (@comp_cat_fapp0 A B C G F)) eta
  ≡ eta;

// The overlap with the original right-unit cut agrees at proof time.
assert [A B C : Cat] (F : τ (Functor A B)) (G : τ (Functor B C)) ⊢
  @eq_refl
    (Hom (Functor_cat A C)
      (@hom_precomp_along_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) C A B F G)
      (@hom_precomp_along_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) C A B F G))
    (@id (Functor_cat A C)
      (@hom_precomp_along_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) C A B F G))
  : τ (@=
      (Hom (Functor_cat A C)
        (@hom_precomp_along_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) C A B F G)
        (@hom_precomp_along_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) C A B F G))
      (@id (Functor_cat A C)
        (@hom_precomp_along_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) C A B F G))
      (@id (Functor_cat A C) (@comp_cat_fapp0 A B C G F)));

// An arbitrary endotransformation at that same object is not an identity.
assertnot [A B C : Cat] (F : τ (Functor A B)) (G : τ (Functor B C))
  (H : τ (Functor A C))
  (alpha : τ (@Transf A C
    (@hom_precomp_along_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) C A B F G)
    (@hom_precomp_along_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) C A B F G)))
  (eta : τ (@Transf A C H
    (@hom_precomp_along_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) C A B F G))) ⊢
  @comp_fapp0 (Functor_cat A C) H
    (@hom_precomp_along_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) C A B F G)
    (@hom_precomp_along_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) C A B F G)
    alpha eta
  ≡ eta;
