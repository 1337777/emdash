// Both alternating source profiles preserve identity after its tag projects.
assert [A B : Cat] (F : τ (Functor (OddDual_cat A) B)) (x : τ (Obj A)) ⊢
  @fapp1_fapp0 (OddDual_cat A) B F x x (@id A x)
  ≡ @id B (@fapp0 (OddDual_cat A) B F x);

assert [A B : Cat] (F : τ (Functor (EvenDual_cat A) B)) (x : τ (Obj A)) ⊢
  @fapp1_fapp0 (EvenDual_cat A) B F x x (@id A x)
  ≡ @id B (@fapp0 (EvenDual_cat A) B F x);

// The source-category join does not discard an arbitrary endomorphism.
assertnot [A B : Cat] (F : τ (Functor (OddDual_cat A) B)) (x : τ (Obj A))
  (p : τ (Hom (OddDual_cat A) x x)) ⊢
  @fapp1_fapp0 (OddDual_cat A) B F x x p
  ≡ @id B (@fapp0 (OddDual_cat A) B F x);

assertnot [A B : Cat] (F : τ (Functor (EvenDual_cat A) B)) (x : τ (Obj A))
  (p : τ (Hom (EvenDual_cat A) x x)) ⊢
  @fapp1_fapp0 (EvenDual_cat A) B F x x p
  ≡ @id B (@fapp0 (EvenDual_cat A) B F x);

// The transfor unit is unchanged if the source identity projects first.
assert [A B : Cat] (F G : τ (Functor (OddDual_cat A) B))
  (eta : τ (@Transf (OddDual_cat A) B F G)) (x : τ (Obj A)) ⊢
  @tapp1_fapp0 (OddDual_cat A) B F G x x eta (@id A x)
  ≡ @tapp0_fapp0 (OddDual_cat A) B F G x eta;
assert [A B : Cat] (F G : τ (Functor (OddDual_cat A) B))
  (eta : τ (@Transf (OddDual_cat A) B F G)) (x : τ (Obj A)) ⊢
  @tapp1_fapp0 (OddDual_cat A) B F G x x eta (@id (OddDual_cat A) x)
  ≡ @tapp0_fapp0 (OddDual_cat A) B F G x eta;
assert [A B : Cat] (F : τ (Functor (OddDual_cat A) B)) (x : τ (Obj A)) ⊢
  @tapp1_fapp0 (OddDual_cat A) B F F x x
    (@id (Functor_cat (OddDual_cat A) B) F) (@id A x)
  ≡ @id B (@fapp0 (OddDual_cat A) B F x);
assertnot [A B : Cat] (F G : τ (Functor (OddDual_cat A) B))
  (eta : τ (@Transf (OddDual_cat A) B F G)) (x : τ (Obj A))
  (p : τ (Hom (OddDual_cat A) x x)) ⊢
  @tapp1_fapp0 (OddDual_cat A) B F G x x eta p
  ≡ @tapp0_fapp0 (OddDual_cat A) B F G x eta;
