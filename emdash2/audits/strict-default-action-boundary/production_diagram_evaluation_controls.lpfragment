// General fixed evaluation still accepts arbitrary lax diagram maps.
assert (I C : Cat) (i : τ (Obj I)) (F : τ (Functor I C))
  ⊢ @fapp0 _ _ (@diagram_evaluation_at_func I C i) F ≡ @fapp0 I C F i;
assert (I C : Cat) (i : τ (Obj I)) (F G : τ (Functor I C))
  (eta : τ (@Transf I C F G))
  ⊢ @fapp1_fapp0 _ _ (@diagram_evaluation_at_func I C i) F G eta
    ≡ @tapp0_fapp0 I C F G i eta;
assert (K I C : Cat) (i : τ (Obj I))
  (D : τ (Functor K (Functor_cat I C))) (x : τ (Obj K))
  ⊢ @fapp0 K C (@diagram_family_at_func K I C D i) x
    ≡ @fapp0 I C (@fapp0 K (Functor_cat I C) D x) i;
assert (K I C : Cat) (i : τ (Obj I))
  (D : τ (Functor K (Functor_cat I C))) (x y : τ (Obj K))
  (p : τ (Hom K x y))
  ⊢ @fapp1_fapp0 K C (@diagram_family_at_func K I C D i) x y p
    ≡ @tapp0_fapp0 I C (@fapp0 K (Functor_cat I C) D x)
      (@fapp0 K (Functor_cat I C) D y) i
      (@fapp1_fapp0 K (Functor_cat I C) D x y p);
assertnot (I C : Cat) (i j : τ (Obj I)) (F : τ (Functor I C))
  ⊢ @fapp0 _ _ (@diagram_evaluation_at_func I C i) F ≡ @fapp0 I C F j;

// Whole mixed action is derived, including modifications of eta.
assert (I C : Cat) (i j : τ (Obj I)) (u : τ (Hom I i j))
  (F G : τ (Functor I C)) (eta : τ (@Transf I C F G))
  ⊢ @fapp0 _ _ (@diagram_evaluation_mixed_func I C i j u F G) eta
    ≡ @tapp1_fapp0 I C F G i j eta u;
assert (I C : Cat) (i j : τ (Obj I)) (u : τ (Hom I i j))
  (F G : τ (Functor I C)) (eta theta : τ (@Transf I C F G))
  ⊢ @fapp1_func _ _ (@diagram_evaluation_mixed_func I C i j u F G) eta theta
    : τ (Functor (Hom_cat (@Transf_cat I C F G) eta theta)
      (Hom_cat (Hom_cat C (@fapp0 I C F i) (@fapp0 I C G j))
        (@tapp1_fapp0 I C F G i j eta u) (@tapp1_fapp0 I C F G i j theta u)));

// The alternating duals differ from dimension-one transpose at dimension 3.
assert (C : Cat) (x y : τ (Obj C)) (f g : τ (Hom C x y))
  (alpha beta : τ (Hom (Hom_cat C x y) f g))
  ⊢ Hom_cat (Hom_cat (Hom_cat (OddDual_cat C) y x) f g) alpha beta
    ≡ EvenDual_cat (Hom_cat (Hom_cat (Hom_cat C x y) f g) beta alpha);
assertnot (C : Cat) (x y : τ (Obj C)) (f g : τ (Hom C x y))
  (alpha beta : τ (Hom (Hom_cat C x y) f g))
  ⊢ Hom_cat (Hom_cat (Hom_cat (OddDual_cat C) y x) f g) alpha beta
    ≡ Hom_cat (Hom_cat (Hom_cat C x y) f g) alpha beta;
assert (A B : Cat) (F : τ (Functor A B)) (x y : τ (Obj A))
  ⊢ @fapp1_func _ _ (@OddDual_func _ _ (@OddDual_func A B F)) x y
    ≡ @fapp1_func A B F x y;
assert (A B : Cat) (F : τ (Functor A B)) (x y : τ (Obj A))
  ⊢ @fapp1_func _ _ (@EvenDual_func _ _ (@EvenDual_func A B F)) x y
    ≡ @fapp1_func A B F x y;
assertnot (A B : Cat) (F : τ (Functor A B))
  ⊢ @OddDual_func A B F : τ (Functor (Op_cat A) (Op_cat B));

// Root projections retain the oplax Hom, including its Even higher action.
assert (I C : Cat) (i : τ (Obj I))
  ⊢ @fapp0 _ _ (@diagram_evaluation_func I C) i
    ≡ @OddDual_func (Functor_cat I C) C (@diagram_evaluation_at_func I C i);
assert (I C : Cat) (i j : τ (Obj I))
  ⊢ @fapp1_func _ _ (@diagram_evaluation_func I C) i j
    : τ (Functor (Hom_cat I i j)
      (@Transf_oplax_cat (Functor_cat I C) C
        (@diagram_evaluation_at_func I C i) (@diagram_evaluation_at_func I C j)));
assert (I C : Cat) (i j : τ (Obj I)) (u : τ (Hom I i j)) (F : τ (Functor I C))
  ⊢ @tapp0_fapp0 _ _ _ _ F (@diagram_evaluation_transf I C i j u)
    ≡ @fapp1_fapp0 I C F i j u;
assert (I C : Cat) (i j : τ (Obj I)) (u : τ (Hom I i j))
  (F G : τ (Functor I C)) (eta : τ (@Transf I C F G))
  ⊢ @fapp0 _ _ (@tapp1_func _ _ _ _ G F (@diagram_evaluation_transf I C i j u)) eta
    ≡ @fapp0 _ _
      (@EvenDual_func (@Transf_cat I C F G)
        (Hom_cat C (@fapp0 I C F i) (@fapp0 I C G j))
        (@diagram_evaluation_mixed_func I C i j u F G)) eta;
assertnot (I C : Cat) (i j : τ (Obj I)) (u : τ (Hom I i j))
  ⊢ @diagram_evaluation_transf I C i j u
    : τ (@Transf (Functor_cat I C) C
      (@diagram_evaluation_at_func I C i) (@diagram_evaluation_at_func I C j));

// Extract the real comparison from the encoded evaluation transformation.
// This must have the original eta square's direction, not its inverse.
assert (I C : Cat) (i j : τ (Obj I)) (u : τ (Hom I i j))
  (F G : τ (Functor I C)) (eta : τ (@Transf I C F G))
  ⊢ @tapp1_post_laxity_cell
      (OddDual_cat (Functor_cat I C)) (OddDual_cat C)
      (@OddDual_func _ _ (@diagram_evaluation_at_func I C j))
      (@OddDual_func _ _ (@diagram_evaluation_at_func I C i))
      (@diagram_evaluation_transf I C i j u) G G F eta (@id (Functor_cat I C) G)
    : τ (Hom (EvenDual_cat (Hom_cat C (@fapp0 I C F i) (@fapp0 I C G j)))
      (@comp_fapp0 C (@fapp0 I C F i) (@fapp0 I C G i) (@fapp0 I C G j)
        (@fapp1_fapp0 I C G i j u) (@tapp0_fapp0 I C F G i eta))
      (@tapp1_fapp0 I C F G i j eta u));

// Root projection joins for strict functor identity/composition and components.
assert (I C : Cat) (i : τ (Obj I))
  ⊢ @diagram_evaluation_transf I C i i (@id I i)
    ≡ @id (Functor_oplax_cat (Functor_cat I C) C)
      (@OddDual_func _ _ (@diagram_evaluation_at_func I C i));
assert (I C : Cat) (i j k : τ (Obj I)) (u : τ (Hom I i j)) (v : τ (Hom I j k))
  ⊢ @comp_fapp0 (Functor_oplax_cat (Functor_cat I C) C)
      (@OddDual_func _ _ (@diagram_evaluation_at_func I C i))
      (@OddDual_func _ _ (@diagram_evaluation_at_func I C j))
      (@OddDual_func _ _ (@diagram_evaluation_at_func I C k))
      (@diagram_evaluation_transf I C j k v) (@diagram_evaluation_transf I C i j u)
    ≡ @diagram_evaluation_transf I C i k (@comp_fapp0 I i j k v u);
assert (I C : Cat) (i : τ (Obj I)) (F : τ (Functor I C))
  ⊢ @tapp0_fapp0 _ _ _ _ F (@diagram_evaluation_transf I C i i (@id I i))
    ≡ @id C (@fapp0 I C F i);
assert (I C : Cat) (i j : τ (Obj I)) (F : τ (Functor I C))
  ⊢ @comp_cat_fapp0 (Hom_cat I i j)
      (@Transf_oplax_cat (Functor_cat I C) C
        (@diagram_evaluation_at_func I C i) (@diagram_evaluation_at_func I C j))
      (Hom_cat C (@fapp0 I C F i) (@fapp0 I C F j))
      (@EvenDual_func _ _
        (@tapp0_func (OddDual_cat (Functor_cat I C)) (OddDual_cat C)
          (@OddDual_func _ _ (@diagram_evaluation_at_func I C j))
          (@OddDual_func _ _ (@diagram_evaluation_at_func I C i)) F))
      (@diagram_evaluation_hom_func I C i j)
    ≡ @fapp1_func I C F i j;
assertnot (I C : Cat) (i j : τ (Obj I)) (u : τ (Hom I i j))
  (F G : τ (Functor I C)) (eta : τ (@Transf I C F G))
  ⊢ @comp_fapp0 C (@fapp0 I C F i) (@fapp0 I C G i) (@fapp0 I C G j)
      (@fapp1_fapp0 I C G i j u) (@tapp0_fapp0 I C F G i eta)
    ≡ @tapp1_fapp0 I C F G i j eta u;
