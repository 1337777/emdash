assert [A B : Cat] (F : τ (Functor A B)) ⊢
  @fapp0 (Functor_cart_cat A B) (Functor_oplax_cat A B)
    (Functor_cart_oplax_include A B) F ≡ @OddDual_func A B F;
assert [A B : Cat] (F G : τ (Functor A B))
  (U : τ (@StrictTransfor A B F G)) (x : τ (Obj A)) ⊢
  @tapp0_fapp0 (OddDual_cat A) (OddDual_cat B)
    (@OddDual_func A B G) (@OddDual_func A B F) x
    (@fapp1_fapp0 (Functor_cart_cat A B) (Functor_oplax_cat A B)
      (Functor_cart_oplax_include A B) F G U)
  ≡ @tapp0_fapp0 A B F G x (@strict_transfor A B F G U);
assertnot [A B : Cat] (F G : τ (Functor A B))
  (eta : τ (@Transf A B F G)) ⊢
  @OddDual_transf A B F G eta
  : τ (@StrictTransfor (OddDual_cat A) (OddDual_cat B)
      (@OddDual_func A B G) (@OddDual_func A B F));

// Whole first-Hom action and its canonical unit/composite projections.
assert [A B : Cat] (F G : τ (Functor A B))
  (U : τ (@StrictTransfor A B F G)) ⊢
  @fapp1_fapp0 _ _ (OddDual_cart_func_func A B) G F U
  ≡ @OddDual_transf A B F G U;
assert [A B : Cat] (F : τ (Functor A B)) ⊢
  @OddDual_transf A B F F (@id (Functor_cart_cat A B) F)
  ≡ @id (Functor_cart_cat (OddDual_cat A) (OddDual_cat B)) (@OddDual_func A B F);
assert [A B : Cat] (F G H : τ (Functor A B))
  (U : τ (@StrictTransfor A B F G)) (V : τ (@StrictTransfor A B G H)) ⊢
  @comp_fapp0 (Functor_cart_cat (OddDual_cat A) (OddDual_cat B))
    (@OddDual_func A B H) (@OddDual_func A B G) (@OddDual_func A B F)
    (@OddDual_transf A B F G U) (@OddDual_transf A B G H V)
  ≡ @OddDual_transf A B F H (@comp_fapp0 (Functor_cart_cat A B) F G H V U);
// The entire next-Hom functor is retained; capped action is its projection.
assert [A B : Cat] (F G : τ (Functor A B))
  (U : τ (@StrictTransfor A B F G)) (x y : τ (Obj A)) ⊢
  @tapp1_func (OddDual_cat A) (OddDual_cat B) _ _ x y
    (@strict_transfor _ _ _ _ (@OddDual_transf A B F G U))
  ≡ @EvenDual_func (Hom_cat A y x) (Hom_cat B (fapp0 F y) (fapp0 G x))
    (@tapp1_func A B F G y x (@strict_transfor A B F G U));
assert [A B : Cat] (F G : τ (Functor A B))
  (U : τ (@StrictTransfor A B F G)) (x y : τ (Obj A))
  (p : τ (Obj (Hom_cat A y x))) ⊢
  @eq_refl (Obj (Hom_cat B (fapp0 F y) (fapp0 G x)))
    (@tapp1_fapp0 (OddDual_cat A) (OddDual_cat B) _ _ x y
      (@strict_transfor _ _ _ _ (@OddDual_transf A B F G U)) p)
  : τ (@= (Obj (Hom_cat B (fapp0 F y) (fapp0 G x)))
      (@tapp1_fapp0 (OddDual_cat A) (OddDual_cat B) _ _ x y
        (@strict_transfor _ _ _ _ (@OddDual_transf A B F G U)) p)
      (@tapp1_fapp0 A B F G y x (@strict_transfor A B F G U) p));
assert [A B : Cat] (F : τ (Functor A B)) ⊢
  @fapp1_fapp0 (Functor_cart_cat A B) (Functor_oplax_cat A B)
    (Functor_cart_oplax_include A B) F F (@id (Functor_cart_cat A B) F)
  ≡ @id (Functor_oplax_cat A B) (@OddDual_func A B F);
assertnot [A B : Cat] (F G : τ (Functor A B))
  (U V : τ (@StrictTransfor A B F G)) (x : τ (Obj A)) ⊢
  @tapp0_fapp0 _ _ _ _ x (@strict_transfor _ _ _ _ (@OddDual_transf A B F G U))
  ≡ @tapp0_fapp0 A B F G x (@strict_transfor A B F G V);
