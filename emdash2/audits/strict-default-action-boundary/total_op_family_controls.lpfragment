// NON-LIBRARY: total fibre opposite is a genuine whole family over R(K).
assert [K : Cat] (E : τ (Catd K)) ⊢
  @TotalOp_catd K E : τ (Catd (CoAbove2_cat K));
assertnot [K : Cat] (E : τ (Catd K)) ⊢
  @TotalOp_catd K E : τ (Catd K);
assert [K : Cat] (E : τ (Catd K)) ⊢
  @comp_cat_fapp0 (CoAbove2_cat K) (CoAbove2_cat Cat_cat) Cat_cat
    total_op (@CoAbove2_func K Cat_cat E) ≡ @TotalOp_catd K E;
assert (K : Cat) ⊢
  @comp_cat_fapp0 (CoAbove2_cat (Functor_cart_cat K Cat_cat))
    (Functor_cart_cat (CoAbove2_cat K) (CoAbove2_cat Cat_cat))
    (Functor_cart_cat (CoAbove2_cat K) Cat_cat)
    (@comp_cat_cov_cart_func (CoAbove2_cat K) (CoAbove2_cat Cat_cat) Cat_cat total_op)
    (CoAbove2_func_func K Cat_cat)
  ≡ TotalOp_catd_func K;
assert [K : Cat] (E : τ (Catd K)) ⊢
  fapp0 (TotalOp_catd_func K) E ≡ @TotalOp_catd K E;
assert [K : Cat] (E : τ (Catd K)) ⊢
  fapp0 (@comp_cat_cov_cart_func (CoAbove2_cat K) (CoAbove2_cat Cat_cat) Cat_cat total_op)
    (@CoAbove2_func K Cat_cat E) ≡ @TotalOp_catd K E;
assert [K : Cat] (E : τ (Catd K)) ⊢ @TotalOp_catd _ (@TotalOp_catd K E) ≡ E;
assert (K C : Cat) ⊢
  @TotalOp_catd K (@Const_catd K C) ≡ @Const_catd (CoAbove2_cat K) (TotalOp_cat C);

assert [K : Cat] (E : τ (Catd K)) [x y : τ (Obj K)] (p : τ (Hom K x y)) ⊢
  fapp0 (@fapp1_func (CoAbove2_cat K) Cat_cat (@TotalOp_catd K E) x y) p
  ≡ @TotalOp_func _ _ (@fapp1_fapp0 K Cat_cat E x y p);
assert [K : Cat] (E : τ (Catd K)) [x y : τ (Obj K)]
  [p q : τ (Hom K x y)] (alpha : τ (Hom (Hom_cat K x y) p q)) ⊢
  @fapp1_fapp0 (Hom_cat (CoAbove2_cat K) x y)
    (Functor_cart_cat (TotalOp_cat (Fibre_cat E x)) (TotalOp_cat (Fibre_cat E y)))
    (@fapp1_func (CoAbove2_cat K) Cat_cat (@TotalOp_catd K E) x y) q p alpha
  : τ (@StrictTransfor (TotalOp_cat (Fibre_cat E x)) (TotalOp_cat (Fibre_cat E y))
      (@TotalOp_func _ _ (@fapp1_fapp0 K Cat_cat E x y q))
      (@TotalOp_func _ _ (@fapp1_fapp0 K Cat_cat E x y p)));

assertnot [K : Cat] [E D : τ (Catd K)] (FF : τ (Functord E D)) ⊢
  @fapp1_fapp0 (CoAbove2_cat (Functor_cart_cat K Cat_cat))
    (Functor_cart_cat (CoAbove2_cat K) Cat_cat) (TotalOp_catd_func K) E D FF
  : τ (@StrictTransfor (CoAbove2_cat K) Cat_cat (@TotalOp_catd K E) (@TotalOp_catd K D));
