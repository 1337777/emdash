// NON-LIBRARY common whole middle of the represented unit/counit mate.
// U is explicitly strict. The public Homd FF parameter is unaffected.
// At q:x->y this is kappa(U[y]) iota(U[y] E[q]) kappa(U[x]).
symbol Prof_cov_lift_middle_func [K : Cat] [E D : τ (Catd K)]
  (U : τ (@StrictTransfor K Cat_cat E D)) (x y : τ (Obj K))
  : τ (Functor (Hom_cat K x y)
      (Hom_cat Prof_cov_universe (Fibre_cat D x) (Fibre_cat E y)))
≔ @comp_cat_fapp0 _ _ _
    (@Hom_func Prof_cov_universe
      (Fibre_cat E x) (Fibre_cat D x) (Fibre_cat D y) (Fibre_cat E y)
      (@Prof_cov_companion (Fibre_cat E x) (Fibre_cat D x)
        (@tapp0_fapp0 K Cat_cat E D x (@strict_transfor K Cat_cat E D U)))
      (@Prof_cov_companion (Fibre_cat E y) (Fibre_cat D y)
        (@tapp0_fapp0 K Cat_cat E D y (@strict_transfor K Cat_cat E D U))))
    (@comp_cat_fapp0 _ _ _
      (@fapp1_func Cat_cat Prof_cov_universe Prof_cov_include
        (Fibre_cat E x) (Fibre_cat D y))
      (@tapp1_func K Cat_cat E D x y (@strict_transfor K Cat_cat E D U)));
