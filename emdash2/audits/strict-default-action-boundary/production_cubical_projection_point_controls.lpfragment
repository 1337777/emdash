  (@fapp0 (Fibre_cat (@cstd_review_total_dual_sigma K A (@cstd_review_inner_pullback K A B F H)) x) (Fibre_cat (@cstd_review_total_dual_sigma K A (@cstd_review_inner_pullback K A B F H)) y)
