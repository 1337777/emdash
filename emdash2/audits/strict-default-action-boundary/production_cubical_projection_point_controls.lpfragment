// Source-frame congruence must not equate observations of unrelated arrows.
assertnot [K A : Cat] (G : τ (Functor K (Functor_cart_cat A Cat_cart)))
 [x y : τ (Obj K)] (p : τ (Hom (CoAbove2_cat K) x y))
