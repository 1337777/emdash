// NON-LIBRARY: the whole variable-base constructor is the native Hom(Cat).
assert (K : Cat) ⊢ fapp0 Catd_cat_func K ≡ Functor_cart_cat K Cat_cat;
assert [K : Cat] (E : τ (Catd K)) ⊢ E : τ (Obj (fapp0 Catd_cat_func K));
assert [A B : Cat] (F : τ (Functor A B)) ⊢
  @fapp1_fapp0 (Op_cat Cat_cat) Cat_cat Catd_cat_func B A F
  ≡ @comp_cat_con_cart_func A B Cat_cat F;

// Retain a nonidentity source 2-cell with its actual direction. The earlier
// finite counterexample concerned precisely this higher parameter action.
assert [A B : Cat] [F G : τ (Functor A B)]
  (alpha : τ (@StrictTransfor A B F G)) ⊢
  @fapp1_fapp0 (Hom_cat (Op_cat Cat_cat) B A)
    (Functor_cart_cat (Functor_cart_cat B Cat_cat) (Functor_cart_cat A Cat_cat))
    (@fapp1_func (Op_cat Cat_cat) Cat_cat Catd_cat_func B A) F G alpha
  : τ (@StrictTransfor (Functor_cart_cat B Cat_cat) (Functor_cart_cat A Cat_cat)
      (@comp_cat_con_cart_func A B Cat_cat F) (@comp_cat_con_cart_func A B Cat_cat G));
assertnot [A B : Cat] [F G : τ (Functor A B)]
  (alpha : τ (@StrictTransfor A B F G)) ⊢
  @fapp1_fapp0 (Hom_cat (Op_cat Cat_cat) B A)
    (Functor_cart_cat (Functor_cart_cat B Cat_cat) (Functor_cart_cat A Cat_cat))
    (@fapp1_func (Op_cat Cat_cat) Cat_cat Catd_cat_func B A) F G alpha
  : τ (@StrictTransfor (Functor_cart_cat B Cat_cat) (Functor_cart_cat A Cat_cat)
      (@comp_cat_con_cart_func A B Cat_cat G) (@comp_cat_con_cart_func A B Cat_cat F));

// The whole constructor consumes actual Cartesian diagram transformations.
assert [A B : Cat] (F : τ (Functor A B)) [E D : τ (Catd B)]
  (U : τ (@StrictTransfor B Cat_cat E D)) ⊢
  @fapp1_fapp0 (Functor_cart_cat B Cat_cat) (Functor_cart_cat A Cat_cat)
    (@fapp1_fapp0 (Op_cat Cat_cat) Cat_cat Catd_cat_func B A F) E D U
  : τ (@StrictTransfor A Cat_cat
      (fapp0 (@comp_cat_con_cart_func A B Cat_cat F) E)
      (fapp0 (@comp_cat_con_cart_func A B Cat_cat F) D));
assertnot [A B : Cat] (F : τ (Functor A B)) [E D : τ (Catd B)]
  (FF : τ (Functord E D)) ⊢
  @fapp1_fapp0 (Functor_cart_cat B Cat_cat) (Functor_cart_cat A Cat_cat)
    (@fapp1_fapp0 (Op_cat Cat_cat) Cat_cat Catd_cat_func B A F) E D FF
  : τ (@StrictTransfor A Cat_cat
      (fapp0 (@comp_cat_con_cart_func A B Cat_cat F) E)
      (fapp0 (@comp_cat_con_cart_func A B Cat_cat F) D));

// Raw family reindexing and fixed ambient precomposition still accept FF.
assert [A B : Cat] (F : τ (Functor A B)) [E D : τ (Catd B)]
  (FF : τ (Functord E D)) ⊢
  @fapp1_fapp0 (Catd_cat B) (Catd_cat A) (@Pullback_catd_func A B F) E D FF
  : τ (Functord (@Pullback_catd A B E F) (@Pullback_catd A B D F));
assert [A B : Cat] (F : τ (Functor A B)) ⊢
  @eq_refl (Functor (Catd_cat B) (Catd_cat A)) (@comp_cat_con_func A B Cat_cat F)
  : τ (@= (Functor (Catd_cat B) (Catd_cat A))
      (@comp_cat_con_func A B Cat_cat F) (@Pullback_catd_func A B F));
assertnot [A B : Cat] (F : τ (Functor A B)) ⊢
  @comp_cat_con_func A B Cat_cat F ≡ @Pullback_catd_func A B F;

// Pi's variable-base component retains the original fixed-base Pi operation.
assert (K : Cat) ⊢
  @tapp0_fapp0 (Op_cat Cat_cat) Cat_cat _ _ K Pi_int_funcd
  ≡ @comp_cat_fapp0 (Functor_cart_cat K Cat_cat) (Catd_cat K) Cat_cat
      (@Pi_func K) (cart_functor_include K Cat_cat);
assert [K : Cat] (E : τ (Catd K)) ⊢
  fapp0 (@tapp0_fapp0 (Op_cat Cat_cat) Cat_cat _ _ K Pi_int_funcd) E
  ≡ @Pi_cat K E;
assert [K : Cat] [E D : τ (Catd K)] (FF : τ (Functord E D)) ⊢
  @fapp1_fapp0 (Catd_cat K) Cat_cat (@Pi_func K) E D FF
  : τ (Functor (@Pi_cat K E) (@Pi_cat K D));
