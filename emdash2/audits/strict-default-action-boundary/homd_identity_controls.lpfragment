// NON-LIBRARY identity-core qualification at the actual whole package.
assert [K : Cat] (E : τ (Catd K)) ⊢
  @homd_int K E E (@id_funcd K E) ≡ @homd_id_int K E;

assert [K : Cat] (E : τ (Catd K)) (x : τ (Obj K))
  (u : τ (Obj (Fibre_cat E x))) ⊢
  fapp0 (@tapp0_fapp0 (CoAt2_cat K) Cat_cat _ _ x (@homd_id_int K E)) u
  : τ (@Transf K Prof_cov_universe (@Prof_cov_diagram K E)
      (@Prof_cov_diagram K (@hom_ K K (@id_func K) x)));

assert [K : Cat] (E : τ (Catd K)) (x : τ (Obj K))
  (u : τ (Obj (Fibre_cat E x))) (y : τ (Obj K))
  (v : τ (Obj (Fibre_cat E y))) (f : τ (Hom K x y)) ⊢
  fapp0
    (fapp0 (@tapp0_fapp0 K Prof_cov_universe _ _ y
      (fapp0 (@tapp0_fapp0 (CoAt2_cat K) Cat_cat _ _ x (@homd_id_int K E)) u)) v) f
  ≡ Hom_cat (Fibre_cat E y) (fapp0 (@fib_cov_tapp0_func K E x y u) f) v;

// The displayed map remains an ambient transfor; identity-only ownership
// does not admit an arbitrary input map as strictly natural.
assertnot [K : Cat] [D E : τ (Catd K)] (FF : τ (Functord D E)) ⊢
  FF : τ (@StrictTransfor K Cat_cat D E);

assertnot [K : Cat] (E : τ (Catd K)) ⊢
  @homd_id_int K E
  : τ (@StrictTransfor (CoAt2_cat K) Cat_cat
      (@Op_catd K E) (@Homd_target_catd K E));

// The identity Homd index retains its nonidentity higher-arrow direction.
assert [K : Cat] (E : τ (Catd K)) (x : τ (Obj K))
  (u : τ (Obj (Fibre_cat E x))) (y : τ (Obj K)) (v : τ (Obj (Fibre_cat E y)))
  [p q : τ (Hom K x y)] (alpha : τ (Hom (Hom_cat K x y) p q)) ⊢
  @fapp1_fapp0 (Op_cat (Hom_cat K x y)) Cat_cat
    (fapp0 (@homd_id_tgt_func K E x u y) v) q p alpha
  ≡ @hom_precomp_along_func (Hom_cat K x y) (Fibre_cat E y)
      (@fib_cov_tapp0_func K E x y u) v p q alpha;

assertnot [K : Cat] (E : τ (Catd K)) (x : τ (Obj K))
  (u : τ (Obj (Fibre_cat E x))) (y : τ (Obj K)) (v : τ (Obj (Fibre_cat E y)))
  [p q : τ (Hom K x y)] (alpha : τ (Hom (Hom_cat K x y) p q)) ⊢
  @fapp1_fapp0 (Op_cat (Hom_cat K x y)) Cat_cat
    (fapp0 (@homd_id_tgt_func K E x u y) v) p q alpha
  : τ (Functor
      (Hom_cat (Fibre_cat E y) (fapp0 (@fib_cov_tapp0_func K E x y u) p) v)
      (Hom_cat (Fibre_cat E y) (fapp0 (@fib_cov_tapp0_func K E x y u) q) v));

assertnot (K : Cat) ⊢ CoAt2_cat K ≡ K;

assert [K : Cat] [D E : τ (Catd K)] (FF : τ (Functord D E)) ⊢
  @homd_int K D E FF
  : τ (@Functord (CoAt2_cat K) (@Op_catd K E) (@Homd_target_catd K D));

// All displayed parameters still project from the whole root.
assert [K : Cat] [D E : τ (Catd K)] (FF : τ (Functord D E))
  (x : τ (Obj K)) (u : τ (Obj (Fibre_cat E x))) (y : τ (Obj K)) ⊢
  @tapp0_fapp0 K Prof_cov_universe _ _ y
    (fapp0 (@tapp0_fapp0 (CoAt2_cat K) Cat_cat _ _ x (@homd_int K D E FF)) u)
  ≡ @homd_tgt_func K D E FF x u y;
