// The actual local presentation maps on identity and composite inputs.
assert [A B : Cat] (P : τ (Prof B A)) ⊢
  @fapp1_fapp0 _ _ (local_cart_prof_uncurry_func A B) _ _
    (@fapp1_fapp0 _ _ (local_cart_prof_curry_func A B) P P
      (@id (local_cart_prof_cat B A) P))
  ≡ @id (local_cart_prof_cat B A) P;

assert [A B : Cat] [P Q R : τ (Prof B A)]
  (r : τ (Hom (local_cart_prof_cat B A) P Q))
  (s : τ (Hom (local_cart_prof_cat B A) Q R)) ⊢
  @fapp1_fapp0 _ _ (local_cart_prof_uncurry_func A B) _ _
    (@fapp1_fapp0 _ _ (local_cart_prof_curry_func A B) P R
      (@comp_fapp0 (local_cart_prof_cat B A) P Q R s r))
  ≡ @comp_fapp0 (local_cart_prof_cat B A) P Q R s r;

// The inverse preserves the actual transformation, not any arrow with
// the same endpoints. No profile conversion for a raw map is introduced.
assertnot [A B : Cat] [P Q : τ (Prof B A)]
  (r s : τ (Hom (local_cart_prof_cat B A) P Q)) ⊢
  @fapp1_fapp0 _ _ (local_cart_prof_uncurry_func A B) _ _
    (@fapp1_fapp0 _ _ (local_cart_prof_curry_func A B) P Q r) ≡ s;

assertnot [A B : Cat] [P Q : τ (Prof B A)] (r : τ (ProfMap P Q)) ⊢
  @fapp1_fapp0 _ _ (local_cart_prof_curry_func A B) P Q r
  : τ (Hom (local_cart_prof_qhom A B)
      (fapp0 (local_cart_prof_curry_func A B) P)
      (fapp0 (local_cart_prof_curry_func A B) Q));

// One arbitrary reindex map is not replaced by the inverse product swap.
assertnot [A B C : Cat] [F G : τ (Functor (Product_cat A B) C)]
  (H : τ (Functor (Product_cat A B) (Product_cat B A)))
  (alpha : τ (@StrictTransfor (Product_cat A B) C F G)) ⊢
  @fapp1_fapp0 _ _
    (@comp_cat_con_cart_func (Product_cat A B) (Product_cat B A) C H) _ _
    (@fapp1_fapp0 _ _
      (@comp_cat_con_cart_func (Product_cat B A) (Product_cat A B) C
        (@Product_swap_func B A)) F G alpha)
  ≡ alpha;
