// Test-only actual symmetry precomposition on a Cartesian transformation.
symbol local_inverse_swap_action [A B C : Cat]
  [F G : τ (Functor (Product_cat A B) C)]
  (alpha : τ (@StrictTransfor (Product_cat A B) C F G))
  : τ (@StrictTransfor (Product_cat B A) C
      (fapp0 (@comp_cat_con_cart_func (Product_cat B A) (Product_cat A B) C
        (@Product_swap_func B A)) F)
      (fapp0 (@comp_cat_con_cart_func (Product_cat B A) (Product_cat A B) C
        (@Product_swap_func B A)) G))
≔ @fapp1_fapp0 _ _
    (@comp_cat_con_cart_func (Product_cat B A) (Product_cat A B) C
      (@Product_swap_func B A)) F G alpha;

// The overlapping triple-swap computations retain the same single swap.
assert [A B C : Cat] [F G : τ (Functor (Product_cat A B) C)]
  (alpha : τ (@StrictTransfor (Product_cat A B) C F G)) ⊢
  @local_inverse_swap_action A B C _ _
    (@local_inverse_swap_action B A C _ _
      (@local_inverse_swap_action A B C F G alpha))
  ≡ @local_inverse_swap_action A B C F G alpha;

// Degenerate product factor can normalize before the identity swap cell.
assert [B C : Cat] [F G : τ (Functor (Product_cat Terminal_cat B) C)]
  (alpha : τ (@StrictTransfor (Product_cat Terminal_cat B) C F G)) ⊢
  @local_inverse_swap_action B Terminal_cat C _ _
    (@local_inverse_swap_action Terminal_cat B C F G alpha) ≡ alpha;

// Endpoint equal to a stable precomposition; use an actual identity map.
assert [A B C D : Cat] (H : τ (Functor (Product_cat A B) C))
  (F : τ (Functor C D)) ⊢
  @local_inverse_swap_action B A D _ _
    (@local_inverse_swap_action A B D _ _
      (@id (Functor_cart_cat (Product_cat A B) D)
        (fapp0 (@comp_cat_con_cart_func (Product_cat A B) C D H) F)))
  ≡ @id (Functor_cart_cat (Product_cat A B) D)
      (fapp0 (@comp_cat_con_cart_func (Product_cat A B) C D H) F);
