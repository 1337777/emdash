require open emdash.examples.one_cat_chain_pair_native_maps;
require open emdash.examples.freyd_native_inputs;
require open emdash.examples.freyd_native_maps;
require open emdash.examples.freyd_native_row_families;
require open emdash.examples.introduced_terminal_input_comparisons;
require open emdash.examples.one_cat_whiskering_paths;
require open emdash.emdash3_2_commutative_algebra_freyd_adjunction_models;
// The preserved whole equality is proof-time, not a runtime normalization.
assertnot  [Q : Cat] (x x0 y y0 : τ (Obj Q))
  (g : τ (Hom Q x0 x)) (f : τ (Hom Q y y0))
  (h k : τ (Hom Q x y)) ⊢ (@fapp1_func (Hom_cat Q x y) (Hom_cat Q x0 y0) (@Hom_func Q x x0 y y0 g f) h
    k) ≡ (@comp_cat_fapp0 (Hom_cat (Hom_cat Q x y) h k) (Hom_cat (Hom_cat Q x y0) (@hom_postcomp_fapp0 Q Q (@id_func Q)
    x y y0 f h) (@hom_postcomp_fapp0 Q Q (@id_func Q) x y y0 f k)) (Hom_cat (Hom_cat Q x0 y0) (@Hom_fapp0 Q x x0 y y0
    g f h) (@Hom_fapp0 Q x x0 y y0 g f k)) (@hom_precomp_along_fapp1_func Q Q (@id_func Q) y0 x0 x g
    (@hom_postcomp_fapp0 Q Q (@id_func Q) x y y0 f h) (@hom_postcomp_fapp0 Q Q (@id_func Q) x y y0 f k))
    (@hom_postcomp_fapp1_func Q Q (@id_func Q) x y y0 f h k));

require open emdash.emdash3_2_one_cat_family_naturality_paths;
