// Whole strict target and native x/u projection orders.
assert [K : Cat] (E : τ (Catd K)) (x : τ (Obj K)) ⊢
  Obj (@Fibre_cat K (@fibcov_cart_target K E) x)
  ≡ @StrictTransfor K Cat_cat (@hom_ K K (@id_func K) x) E;

assert [K : Cat] (E : τ (Catd K)) ⊢
  @fibcov_cart_int K E : τ (@Functord K E (@fibcov_cart_target K E));

assert [K : Cat] (E : τ (Catd K)) (x : τ (Obj K)) ⊢
  @tapp0_fapp0 K Cat_cat E (@fibcov_cart_target K E) x (@fibcov_cart_int K E)
  ≡ @fibcov_cart_src_func K E x;

assert [K : Cat] (E : τ (Catd K)) (x : τ (Obj K))
  (u : τ (Obj (@Fibre_cat K E x))) ⊢
  fapp0 (@tapp0_fapp0 K Cat_cat E (@fibcov_cart_target K E) x (@fibcov_cart_int K E)) u
  ≡ @fibcov_cart_transf K E x u;

assert [K : Cat] (E : τ (Catd K)) (x : τ (Obj K))
  [u0 u1 : τ (Obj (@Fibre_cat K E x))] ⊢
  @fapp1_func (@Fibre_cat K E x) (@Fibre_cat K (@fibcov_cart_target K E) x)
    (@fibcov_cart_src_func K E x) u0 u1
  : τ (Functor (Hom_cat (@Fibre_cat K E x) u0 u1)
      (Hom_cat (@Fibre_cat K (@fibcov_cart_target K E) x)
        (@fibcov_cart_transf K E x u0) (@fibcov_cart_transf K E x u1)));

assert [K : Cat] (E : τ (Catd K)) (x : τ (Obj K))
  (u : τ (Obj (@Fibre_cat K E x))) (y : τ (Obj K)) ⊢
  @tapp0_fapp0 K Cat_cat (@hom_ K K (@id_func K) x) E y
    (@strict_transfor K Cat_cat _ E (@fibcov_cart_transf K E x u))
  ≡ @fib_cov_tapp0_func K E x y u;

// No new x-strictness and no strictification of arbitrary ambient values.
assertnot [K : Cat] (E : τ (Catd K)) ⊢
  @fibcov_cart_int K E : τ (@StrictTransfor K Cat_cat E (@fibcov_cart_target K E));

assertnot [K : Cat] (E : τ (Catd K)) (x : τ (Obj K))
  (FF : τ (@Transf K Cat_cat (@hom_ K K (@id_func K) x) E)) ⊢
  FF : τ (Obj (@Fibre_cat K (@fibcov_cart_target K E) x));
