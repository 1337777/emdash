symbol homology_family_projection_naturality
  [B C : Cat] [S : τ (@PreadditiveCategory C)]
  (C1 : τ (IsNCat (cat_succ cat_zero) C))
  [t : τ (Obj C)] [T : τ (@TerminalObject C t)]
  [T0 : τ (@TerminalObject (TotalOp_cat C) t)]
  [W : τ (@HasComputationalKernels C S)] [V : τ (@HasComputationalCokernels C S)]
  (P : τ (@KernelPresentation C S t T W)) (Q : τ (@CokernelPresentation C S t T0 V))
  (A : τ (Functor B C)) (D : τ (Functor B (Functor_oplax_cat WalkingArrow_cat C)))
  (h : τ (@Transf B (Functor_oplax_cat WalkingArrow_cat C)
    (@comp_cat_fapp0 B C (Functor_oplax_cat WalkingArrow_cat C) (@terminal_arrow_diagram_func C t T) A) D))
  [x y : τ (Obj B)] (p : τ (Hom B x y))
  : τ (@= (Obj (Hom_cat C (@fapp0 B C (@kernel_family_func B C S t T W P D) x) (@fapp0 B C (@homology_family_func B C S t T T0 W V P Q A D h) y)))
    (@comp_fapp0 C (@fapp0 B C (@kernel_family_func B C S t T W P D) x) (@fapp0 B C (@homology_family_func B C S t T T0 W V P Q A D h) x) (@fapp0 B C (@homology_family_func B C S t T T0 W V P Q A D h) y)
      (@fapp1_fapp0 B C (@homology_family_func B C S t T T0 W V P Q A D h) x y p)
      (@tapp0_fapp0 B C (@kernel_family_func B C S t T W P D) (@homology_family_func B C S t T T0 W V P Q A D h) x (@homology_family_projection_transf B C S t T T0 W V P Q A D h)))
    (@comp_fapp0 C (@fapp0 B C (@kernel_family_func B C S t T W P D) x) (@fapp0 B C (@kernel_family_func B C S t T W P D) y) (@fapp0 B C (@homology_family_func B C S t T T0 W V P Q A D h) y)
      (@tapp0_fapp0 B C (@kernel_family_func B C S t T W P D) (@homology_family_func B C S t T T0 W V P Q A D h) y (@homology_family_projection_transf B C S t T T0 W V P Q A D h))
      (@fapp1_fapp0 B C (@kernel_family_func B C S t T W P D) x y p)))
≔ @one_cat_component_naturality_path B C C1 (@kernel_family_func B C S t T W P D) (@homology_family_func B C S t T T0 W V P Q A D h) (@homology_family_projection_transf B C S t T T0 W V P Q A D h) x y p;
