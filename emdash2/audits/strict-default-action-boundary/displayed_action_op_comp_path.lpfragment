require open emdash.corrected_op_eval_review;
require open emdash.structural_cart_profiles_review;

symbol cart_pair_target [K : Cat] (E D : τ (Catd K)) : τ (Catd K)
≔ @comp_cat_fapp0 K (Product_cat Cat_cart Cat_cart) Cat_cart
    (@uncurry_func Cat_cart Cat_cart Cat_cart Product_cat_coeff_func) (Struct_sigma E D);
symbol cart_op_view [K : Cat] [E D : τ (Catd K)]
  (U : τ (Hom (Functor_cart_cat K Cat_cart) E D))
  : τ (@Functord (CoAt2_cat K) (@Op_catd K E) (@Op_catd K D))
≔ @strict_transfor _ _ _ _ (@Op_funcd K E D U);

// Derived before specializing the middle family; no extra operational input.
symbol op_cart_comp_cell_agrees [K : Cat] [E M D : τ (Catd K)]
  (U : τ (Hom (Functor_cart_cat K Cat_cart) E M))
  (V : τ (Hom (Functor_cart_cat K Cat_cart) M D))
  [x y : τ (Obj K)] (p : τ (Hom K x y)) (u : τ (Obj (Fibre_cat E x)))
  : τ (@= (Hom (Fibre_cat (@Op_catd K D) y) (@fapp0 (Fibre_cat (@Op_catd K M) y) (Fibre_cat (@Op_catd K D) y) (@Fibre_func (CoAt2_cat K) (@Op_catd K M) (@Op_catd K D) (@cart_op_view K M D V) y) (@fapp0 (Fibre_cat (@Op_catd K E) y) (Fibre_cat (@Op_catd K M) y) (@Fibre_func (CoAt2_cat K) (@Op_catd K E) (@Op_catd K M) (@cart_op_view K E M U) y) (@eval_order_transport (CoAt2_cat K) (@Op_catd K E) x y p u))) (@fapp0 (Fibre_cat (@Op_catd K M) y) (Fibre_cat (@Op_catd K D) y) (@Fibre_func (CoAt2_cat K) (@Op_catd K M) (@Op_catd K D) (@cart_op_view K M D V) y) (@fapp0 (Fibre_cat (@Op_catd K E) y) (Fibre_cat (@Op_catd K M) y) (@Fibre_func (CoAt2_cat K) (@Op_catd K E) (@Op_catd K M) (@cart_op_view K E M U) y) (@eval_order_transport (CoAt2_cat K) (@Op_catd K E) x y p u)))) (@fdapp1_int_cell (CoAt2_cat K) (@Op_catd K E) (@Op_catd K D) (@cart_op_view K E D (@comp_fapp0 (Functor_cart_cat K Cat_cart) E M D V U)) x y p u) (@fdapp1_int_hom_fapp0 (CoAt2_cat K) (@Op_catd K M) (@Op_catd K D) (@cart_op_view K M D V) x y p
      (@fapp0 (Fibre_cat (@Op_catd K E) x) (Fibre_cat (@Op_catd K M) x) (@Fibre_func (CoAt2_cat K) (@Op_catd K E) (@Op_catd K M) (@cart_op_view K E M U) x) u)
      (@fapp0 (Fibre_cat (@Op_catd K E) y) (Fibre_cat (@Op_catd K M) y) (@Fibre_func (CoAt2_cat K) (@Op_catd K E) (@Op_catd K M) (@cart_op_view K E M U) y) (@eval_order_transport (CoAt2_cat K) (@Op_catd K E) x y p u))
      (@fdapp1_int_cell (CoAt2_cat K) (@Op_catd K E) (@Op_catd K M) (@cart_op_view K E M U) x y p u)))
≔ @eq_refl (Hom (Fibre_cat (@Op_catd K D) y) (@fapp0 (Fibre_cat (@Op_catd K M) y) (Fibre_cat (@Op_catd K D) y) (@Fibre_func (CoAt2_cat K) (@Op_catd K M) (@Op_catd K D) (@cart_op_view K M D V) y) (@fapp0 (Fibre_cat (@Op_catd K E) y) (Fibre_cat (@Op_catd K M) y) (@Fibre_func (CoAt2_cat K) (@Op_catd K E) (@Op_catd K M) (@cart_op_view K E M U) y) (@eval_order_transport (CoAt2_cat K) (@Op_catd K E) x y p u))) (@fapp0 (Fibre_cat (@Op_catd K M) y) (Fibre_cat (@Op_catd K D) y) (@Fibre_func (CoAt2_cat K) (@Op_catd K M) (@Op_catd K D) (@cart_op_view K M D V) y) (@fapp0 (Fibre_cat (@Op_catd K E) y) (Fibre_cat (@Op_catd K M) y) (@Fibre_func (CoAt2_cat K) (@Op_catd K E) (@Op_catd K M) (@cart_op_view K E M U) y) (@eval_order_transport (CoAt2_cat K) (@Op_catd K E) x y p u)))) (@fdapp1_int_cell (CoAt2_cat K) (@Op_catd K E) (@Op_catd K D) (@cart_op_view K E D (@comp_fapp0 (Functor_cart_cat K Cat_cart) E M D V U)) x y p u);
