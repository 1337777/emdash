require open emdash.emdash3_2_zero_arrow_family_action_paths;
symbol B : Cat; symbol C : Cat;
symbol t : τ (Obj C);
symbol T : τ (@TerminalObject C t);
symbol A : τ (Functor B C);
symbol D : τ (Functor B (Functor_oplax_cat WalkingArrow_cat C));
symbol h : τ (@Transf B (Functor_oplax_cat WalkingArrow_cat C)
  (@comp_cat_fapp0 B C (Functor_oplax_cat WalkingArrow_cat C) (@terminal_arrow_diagram_func C t T) A) D);
symbol J : τ (Functor C (Functor_oplax_cat WalkingArrow_cat C)) ≔ @terminal_arrow_diagram_func C t T;
symbol E0 : τ (Functor (Functor_oplax_cat WalkingArrow_cat C) C)
 ≔ @diagram_oplax_evaluation_at_func WalkingArrow_cat C walking_arrow_src;
symbol raw : τ (Functor B (Functor_oplax_cat WalkingArrow_cat C))
 ≔ @comp_cat_fapp0 B C (Functor_oplax_cat WalkingArrow_cat C) J A;
symbol represented : τ (Functor B (Functor_oplax_cat WalkingArrow_cat C))
 ≔ @fapp0 _ _ (@comp_cat_cov_func B C (Functor_oplax_cat WalkingArrow_cat C) J) A;
assert ⊢ @eq_refl (Functor B (Functor_oplax_cat WalkingArrow_cat C)) raw
 : τ (@= (Functor B (Functor_oplax_cat WalkingArrow_cat C)) raw represented);
assert ⊢ @eq_refl (Functor B C) (@comp_cat_fapp0 B (Functor_oplax_cat WalkingArrow_cat C) C E0 raw)
 : τ (@= (Functor B C) (@comp_cat_fapp0 B (Functor_oplax_cat WalkingArrow_cat C) C E0 raw) A);
assert ⊢ @eq_refl (Functor B C) (@comp_cat_fapp0 B (Functor_oplax_cat WalkingArrow_cat C) C E0 represented)
 : τ (@= (Functor B C) (@comp_cat_fapp0 B (Functor_oplax_cat WalkingArrow_cat C) C E0 represented) A);
assert ⊢ @diagram_oplax_family_map_at B WalkingArrow_cat C represented D h walking_arrow_src
 : τ (@Transf B C A (@diagram_oplax_family_at_func B WalkingArrow_cat C D walking_arrow_src));
