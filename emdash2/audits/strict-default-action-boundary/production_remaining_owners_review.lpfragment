// Endpoint-normalization controls for the original terminal comparison beta.
// The rule must still compute after its inferred Hom/identity endpoint unfolds.

assert [A : Cat] (F : τ (Functor A Terminal_cat))
  (G : τ (Functor Terminal_cat Terminal_cat))
  [W X : τ (Obj A)]
  (g : τ (Hom Terminal_cat (@fapp0 A Terminal_cat F X) (@fapp0 Terminal_cat Terminal_cat G Terminal_obj)))
  (normal : τ (@= (Hom Terminal_cat (@fapp0 Terminal_cat Terminal_cat G Terminal_obj) (@fapp0 Terminal_cat Terminal_cat G Terminal_obj))
    (@prof_terminal_terminal_action Terminal_cat G) (@id Terminal_cat (@fapp0 Terminal_cat Terminal_cat G Terminal_obj))))
  (p : τ (Hom A W X)) ⊢
  @tapp0_fapp0 (Hom_cat A W X) Terminal_cat (@prof_terminal_expected_source_func A Terminal_cat F G W X g) (@prof_terminal_retained_source_func A Terminal_cat F G W X g) p
    (@prof_terminal_expected_retained_source_transf A Terminal_cat F G W X g normal)
  ≡ @path_to_hom (Hom_cat Terminal_cat (@fapp0 A Terminal_cat F W) (@fapp0 Terminal_cat Terminal_cat G Terminal_obj)) (@fapp0 (Hom_cat A W X) (Hom_cat Terminal_cat (@fapp0 A Terminal_cat F W) (@fapp0 Terminal_cat Terminal_cat G Terminal_obj)) (@prof_terminal_expected_source_func A Terminal_cat F G W X g) p) (@fapp0 (Hom_cat A W X) (Hom_cat Terminal_cat (@fapp0 A Terminal_cat F W) (@fapp0 Terminal_cat Terminal_cat G Terminal_obj)) (@prof_terminal_retained_source_func A Terminal_cat F G W X g) p)
      (@eq_sym (Hom Terminal_cat (@fapp0 A Terminal_cat F W) (@fapp0 Terminal_cat Terminal_cat G Terminal_obj)) (@fapp0 (Hom_cat A W X) (Hom_cat Terminal_cat (@fapp0 A Terminal_cat F W) (@fapp0 Terminal_cat Terminal_cat G Terminal_obj)) (@prof_terminal_retained_source_func A Terminal_cat F G W X g) p) (@fapp0 (Hom_cat A W X) (Hom_cat Terminal_cat (@fapp0 A Terminal_cat F W) (@fapp0 Terminal_cat Terminal_cat G Terminal_obj)) (@prof_terminal_expected_source_func A Terminal_cat F G W X g) p)
        (@prof_terminal_retained_expected_source_fapp0_path A Terminal_cat F G W X g normal p));

assert [A : Cat] (F : τ (Functor A Terminal_cat))
  [W X : τ (Obj A)]
  (g : τ (Hom Terminal_cat (@fapp0 A Terminal_cat F X) (@fapp0 Terminal_cat Terminal_cat (@id_func Terminal_cat) Terminal_obj)))
  (normal : τ (@= (Hom Terminal_cat (@fapp0 Terminal_cat Terminal_cat (@id_func Terminal_cat) Terminal_obj) (@fapp0 Terminal_cat Terminal_cat (@id_func Terminal_cat) Terminal_obj))
    (@prof_terminal_terminal_action Terminal_cat (@id_func Terminal_cat)) (@id Terminal_cat (@fapp0 Terminal_cat Terminal_cat (@id_func Terminal_cat) Terminal_obj))))
  (p : τ (Hom A W X)) ⊢
  @tapp0_fapp0 (Hom_cat A W X) Terminal_cat (@prof_terminal_expected_source_func A Terminal_cat F (@id_func Terminal_cat) W X g) (@prof_terminal_retained_source_func A Terminal_cat F (@id_func Terminal_cat) W X g) p
    (@prof_terminal_expected_retained_source_transf A Terminal_cat F (@id_func Terminal_cat) W X g normal)
  ≡ @path_to_hom (Hom_cat Terminal_cat (@fapp0 A Terminal_cat F W) (@fapp0 Terminal_cat Terminal_cat (@id_func Terminal_cat) Terminal_obj)) (@fapp0 (Hom_cat A W X) (Hom_cat Terminal_cat (@fapp0 A Terminal_cat F W) (@fapp0 Terminal_cat Terminal_cat (@id_func Terminal_cat) Terminal_obj)) (@prof_terminal_expected_source_func A Terminal_cat F (@id_func Terminal_cat) W X g) p) (@fapp0 (Hom_cat A W X) (Hom_cat Terminal_cat (@fapp0 A Terminal_cat F W) (@fapp0 Terminal_cat Terminal_cat (@id_func Terminal_cat) Terminal_obj)) (@prof_terminal_retained_source_func A Terminal_cat F (@id_func Terminal_cat) W X g) p)
      (@eq_sym (Hom Terminal_cat (@fapp0 A Terminal_cat F W) (@fapp0 Terminal_cat Terminal_cat (@id_func Terminal_cat) Terminal_obj)) (@fapp0 (Hom_cat A W X) (Hom_cat Terminal_cat (@fapp0 A Terminal_cat F W) (@fapp0 Terminal_cat Terminal_cat (@id_func Terminal_cat) Terminal_obj)) (@prof_terminal_retained_source_func A Terminal_cat F (@id_func Terminal_cat) W X g) p) (@fapp0 (Hom_cat A W X) (Hom_cat Terminal_cat (@fapp0 A Terminal_cat F W) (@fapp0 Terminal_cat Terminal_cat (@id_func Terminal_cat) Terminal_obj)) (@prof_terminal_expected_source_func A Terminal_cat F (@id_func Terminal_cat) W X g) p)
        (@prof_terminal_retained_expected_source_fapp0_path A Terminal_cat F (@id_func Terminal_cat) W X g normal p));
