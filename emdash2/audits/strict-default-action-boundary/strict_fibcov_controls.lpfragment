// The admitted term is a whole strict displayed map; its ambient view is
// still observed using the existing Transf and tapp* operations.
assert [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  (u : τ (Obj (fapp0 E x))) ⊢
  @sf_fibcov K E x u
  : τ (Obj (@sf_family_map_cat K (@hom_ K K (@id_func K) x) E));

assert [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  (u : τ (Obj (fapp0 E x))) (y : τ (Obj K)) ⊢
  @tapp0_fapp0 K Cat_cat (@hom_ K K (@id_func K) x) E y
    (@sf_family_map_view K (@hom_ K K (@id_func K) x) E (@sf_fibcov K E x u))
  ≡ @fib_cov_tapp0_func K E x y u;

assert [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  (u : τ (Obj (fapp0 E x))) (y : τ (Obj K)) (f : τ (Hom K x y)) ⊢
  fapp0 (@tapp0_fapp0 K Cat_cat (@hom_ K K (@id_func K) x) E y
    (@sf_family_map_view K (@hom_ K K (@id_func K) x) E (@sf_fibcov K E x u))) f
  ≡ fapp0 (@fapp1_fapp0 K Cat_cat E x y f) u;

// A nonidentity base two-cell retains the component of E[alpha].
assert [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  (u : τ (Obj (fapp0 E x))) (y : τ (Obj K))
  [f g : τ (Hom K x y)] (alpha : τ (Hom (Hom_cat K x y) f g)) ⊢
  @fapp1_fapp0 (Hom_cat K x y) (fapp0 E y)
    (@fib_cov_tapp0_func K E x y u) f g alpha
  ≡ @tapp0_fapp0 (fapp0 E x) (fapp0 E y)
      (@fapp1_fapp0 K Cat_cat E x y f) (@fapp1_fapp0 K Cat_cat E x y g) u
      (@fapp1_fapp0 (Hom_cat K x y) (Functor_cat (fapp0 E x) (fapp0 E y))
        (@fapp1_func K Cat_cat E x y) f g alpha);

// Strict FF acts before the y projection: a whole-family computation.
assert [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  (u : τ (Obj (fapp0 E x))) (y z : τ (Obj K)) ⊢
  @tapp1_func K Cat_cat (@hom_ K K (@id_func K) x) E y z
    (@sf_family_map_view K (@hom_ K K (@id_func K) x) E (@sf_fibcov K E x u))
  ≡ @sf_fibcov_action K E x u y z;

assert [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  (u : τ (Obj (fapp0 E x))) (y z : τ (Obj K)) (q : τ (Hom K y z)) ⊢
  fapp0 (@tapp1_func K Cat_cat (@hom_ K K (@id_func K) x) E y z
    (@sf_family_map_view K (@hom_ K K (@id_func K) x) E (@sf_fibcov K E x u))) q
  ≡ @tapp1_fapp0 K Cat_cat (@hom_ K K (@id_func K) x) E y z
      (@sf_family_map_view K (@hom_ K K (@id_func K) x) E (@sf_fibcov K E x u)) q;

// Generic Hom action retains its named composition head; its raw composite
// reading is proof-time, as in the ordinary Hom owner.
symbol sf_fibcov_action_leaf [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  (u : τ (Obj (fapp0 E x))) (y z : τ (Obj K)) (q : τ (Hom K y z))
  (p : τ (Hom K x y))
  : τ (@= (Obj (fapp0 E z))
      (fapp0 (fapp0 (@sf_fibcov_action K E x u y z) q) p)
      (fapp0 (@fapp1_fapp0 K Cat_cat E x z (@comp_fapp0 K x y z q p)) u))
≔ @eq_refl (Obj (fapp0 E z))
    (fapp0 (@fapp1_fapp0 K Cat_cat E x z (@comp_fapp0 K x y z q p)) u);

assertnot [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  (u : τ (Obj (fapp0 E x))) (y z : τ (Obj K)) (q : τ (Hom K y z))
  (p : τ (Hom K x y)) ⊢
  fapp0 (fapp0 (@sf_fibcov_action K E x u y z) q) p
  ≡ fapp0 (@fapp1_fapp0 K Cat_cat E x z (@comp_fapp0 K x y z q p)) u;

// The full first-Hom of base action remains available at nonidentity alpha.
assert [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  (u : τ (Obj (fapp0 E x))) (y z : τ (Obj K))
  [q r : τ (Hom K y z)] (alpha : τ (Hom (Hom_cat K y z) q r)) ⊢
  @fapp1_fapp0 (Hom_cat K y z)
    (Functor_cat (Hom_cat K x y) (fapp0 E z))
    (@sf_fibcov_action K E x u y z) q r alpha
  : τ (@Transf (Hom_cat K x y) (fapp0 E z)
      (fapp0 (@sf_fibcov_action K E x u y z) q)
      (fapp0 (@sf_fibcov_action K E x u y z) r));

assert [K : Cat] [D E : τ (Functor K Cat_cat)]
  (FF : τ (Obj (@sf_family_map_cat K D E))) (x : τ (Obj K))
  (u : τ (Obj (fapp0 D x))) ⊢
  @comp_fapp0 (sf_family_cat K) (@hom_ K K (@id_func K) x) D E FF
    (@sf_fibcov K D x u)
  ≡ @sf_fibcov K E x
      (fapp0 (@tapp0_fapp0 K Cat_cat D E x (@sf_family_map_view K D E FF)) u);

// Identity input follows both the category unit and the constructor rule.
assert [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  (u : τ (Obj (fapp0 E x))) ⊢
  @comp_fapp0 (sf_family_cat K) (@hom_ K K (@id_func K) x) E E
    (@id (sf_family_cat K) E) (@sf_fibcov K E x u)
  ≡ @sf_fibcov K E x u;

assert [K : Cat] [C D E : τ (Functor K Cat_cat)]
  (FF : τ (Obj (@sf_family_map_cat K C D)))
  (GG : τ (Obj (@sf_family_map_cat K D E)))
  (x : τ (Obj K)) (u : τ (Obj (fapp0 C x))) ⊢
  @comp_fapp0 (sf_family_cat K) (@hom_ K K (@id_func K) x) C E
    (@comp_fapp0 (sf_family_cat K) C D E GG FF) (@sf_fibcov K C x u)
  ≡ @comp_fapp0 (sf_family_cat K) (@hom_ K K (@id_func K) x) D E GG
      (@comp_fapp0 (sf_family_cat K) (@hom_ K K (@id_func K) x) C D FF
        (@sf_fibcov K C x u));

// Strict external maps do not restrict E's base-two-cell values.
// Inclusion-before-composition must agree with composition-before-inclusion.
symbol sf_fibcov_include_composition [K : Cat] [D E : τ (Functor K Cat_cat)]
  (FF : τ (Obj (@sf_family_map_cat K D E))) (x : τ (Obj K))
  (u : τ (Obj (fapp0 D x)))
  : τ (@= (@Transf K Cat_cat (@hom_ K K (@id_func K) x) E)
      (@sf_family_map_view K (@hom_ K K (@id_func K) x) E
        (@comp_fapp0 (sf_family_cat K) (@hom_ K K (@id_func K) x) D E FF
          (@sf_fibcov K D x u)))
      (@comp_fapp0 (Functor_cat K Cat_cat) (@hom_ K K (@id_func K) x) D E
        (@sf_family_map_view K D E FF)
        (@sf_family_map_view K (@hom_ K K (@id_func K) x) D (@sf_fibcov K D x u))))
≔ @eq_refl (@Transf K Cat_cat (@hom_ K K (@id_func K) x) E)
    (@sf_family_map_view K (@hom_ K K (@id_func K) x) E
      (@comp_fapp0 (sf_family_cat K) (@hom_ K K (@id_func K) x) D E FF
        (@sf_fibcov K D x u)));

// Projecting the comparison at y still compares WHOLE index functors.
symbol sf_fibcov_component_composition [K : Cat] [D E : τ (Functor K Cat_cat)]
  (FF : τ (Obj (@sf_family_map_cat K D E))) (x : τ (Obj K))
  (u : τ (Obj (fapp0 D x))) (y : τ (Obj K))
  : τ (@= (Functor (Hom_cat K x y) (fapp0 E y))
      (@fib_cov_tapp0_func K E x y
        (fapp0 (@tapp0_fapp0 K Cat_cat D E x (@sf_family_map_view K D E FF)) u))
      (@comp_cat_fapp0 (Hom_cat K x y) (fapp0 D y) (fapp0 E y)
        (@tapp0_fapp0 K Cat_cat D E y (@sf_family_map_view K D E FF))
        (@fib_cov_tapp0_func K D x y u)))
≔ @eq_refl (Functor (Hom_cat K x y) (fapp0 E y))
    (@fib_cov_tapp0_func K E x y
      (fapp0 (@tapp0_fapp0 K Cat_cat D E x (@sf_family_map_view K D E FF)) u));

assert [K : Cat] [D E : τ (Functor K Cat_cat)]
  (FF : τ (Obj (@sf_family_map_cat K D E))) (x : τ (Obj K))
  (u : τ (Obj (fapp0 D x))) (y : τ (Obj K)) ⊢
  @eq_refl (Functor (Hom_cat K x y) (fapp0 E y))
    (@comp_cat_fapp0 (Hom_cat K x y) (fapp0 D y) (fapp0 E y)
      (@tapp0_fapp0 K Cat_cat D E y (@sf_family_map_view K D E FF))
      (@fib_cov_tapp0_func K D x y u))
  : τ (@= (Functor (Hom_cat K x y) (fapp0 E y))
      (@comp_cat_fapp0 (Hom_cat K x y) (fapp0 D y) (fapp0 E y)
        (@tapp0_fapp0 K Cat_cat D E y (@sf_family_map_view K D E FF))
        (@fib_cov_tapp0_func K D x y u))
      (@fib_cov_tapp0_func K E x y
        (fapp0 (@tapp0_fapp0 K Cat_cat D E x (@sf_family_map_view K D E FF)) u)));

// The component reading is guarded by the admitted strict view. Replacing
// it by an arbitrary ambient transformation must not recover that equality.
assertnot [K : Cat] [D E : τ (Functor K Cat_cat)]
  (FF : τ (@Transf K Cat_cat D E)) (x : τ (Obj K))
  (u : τ (Obj (fapp0 D x))) (y : τ (Obj K)) ⊢
  @eq_refl (Functor (Hom_cat K x y) (fapp0 E y))
    (@fib_cov_tapp0_func K E x y
      (fapp0 (@tapp0_fapp0 K Cat_cat D E x FF) u))
  : τ (@= (Functor (Hom_cat K x y) (fapp0 E y))
      (@fib_cov_tapp0_func K E x y
        (fapp0 (@tapp0_fapp0 K Cat_cat D E x FF) u))
      (@comp_cat_fapp0 (Hom_cat K x y) (fapp0 D y) (fapp0 E y)
        (@tapp0_fapp0 K Cat_cat D E y FF) (@fib_cov_tapp0_func K D x y u)));

assertnot [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  [u w : τ (Obj (fapp0 E x))] ⊢
  @eq_refl (Obj (@sf_family_map_cat K (@hom_ K K (@id_func K) x) E))
    (@sf_fibcov K E x u)
  : τ (@= (Obj (@sf_family_map_cat K (@hom_ K K (@id_func K) x) E))
      (@sf_fibcov K E x u) (@sf_fibcov K E x w));

assertnot [K : Cat] (E : τ (Functor K Cat_cat)) [x y : τ (Obj K)]
  [f g : τ (Hom K x y)] (alpha : τ (Hom (Hom_cat K x y) f g)) ⊢
  @fapp1_fapp0 (Hom_cat K x y) (Functor_cat (fapp0 E x) (fapp0 E y))
    (@fapp1_func K Cat_cat E x y) f g alpha
  : τ (@StrictTransfor (fapp0 E x) (fapp0 E y)
      (@fapp1_fapp0 K Cat_cat E x y f) (@fapp1_fapp0 K Cat_cat E x y g));

assertnot [K : Cat] [D E : τ (Functor K Cat_cat)]
  (FF : τ (@Transf K Cat_cat D E)) (x : τ (Obj K))
  (u : τ (Obj (fapp0 D x))) ⊢
  @comp_fapp0 (sf_family_cat K) (@hom_ K K (@id_func K) x) D E FF
    (@sf_fibcov K D x u)
  : τ (Obj (@sf_family_map_cat K (@hom_ K K (@id_func K) x) E));
