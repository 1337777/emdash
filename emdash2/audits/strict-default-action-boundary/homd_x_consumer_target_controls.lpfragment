// NON-LIBRARY Homd target action from existing ordinary Hom owners.
// p is arbitrary and need not be an identity; no new x-action symbol.
assert [K : Cat] (E : τ (Catd K)) (x x' : τ (Obj K)) ⊢
  @fapp1_func (CoAt2_cat K) Cat_cat (@Homd_target_catd K E) x x'
  ≡ @hom_postcomp_tele_cart_func (Functor_cat K Prof_cov_universe) (CoAt2_cat K)
      (ProfRep_cov_int K) (@Prof_cov_diagram K E) x x';

assert [K : Cat] (E : τ (Catd K)) [x x' : τ (Obj K)] (p : τ (Hom K x x')) ⊢
  (@fapp1_fapp0 (CoAt2_cat K) Cat_cat (@Homd_target_catd K E) x x' p)
  ≡ @hom_postcomp_func (Functor_cat K Prof_cov_universe) (CoAt2_cat K)
      (ProfRep_cov_int K) (@Prof_cov_diagram K E) x x' p;

assert [K : Cat] (E : τ (Catd K)) [x x' : τ (Obj K)] (p : τ (Hom K x x')) ⊢
  fapp0 (@fapp1_func (CoAt2_cat K) Cat_cat (@Homd_target_catd K E) x x') p
  ≡ (@fapp1_fapp0 (CoAt2_cat K) Cat_cat (@Homd_target_catd K E) x x' p);

// Correct CoAt2 direction on a nonidentity 2-cell.
assert [K : Cat] (E : τ (Catd K)) [x x' : τ (Obj K)]
  [p q : τ (Hom K x x')] (alpha : τ (Hom (Hom_cat K x x') p q)) ⊢
  @fapp1_fapp0 (Hom_cat (CoAt2_cat K) x x')
    (Functor_cart_cat (@Homd_section_cat K E x) (@Homd_section_cat K E x'))
    (@fapp1_func (CoAt2_cat K) Cat_cat (@Homd_target_catd K E) x x') q p alpha
  : τ (@StrictTransfor (@Homd_section_cat K E x) (@Homd_section_cat K E x')
      (@fapp1_fapp0 (CoAt2_cat K) Cat_cat (@Homd_target_catd K E) x x' q)
      (@fapp1_fapp0 (CoAt2_cat K) Cat_cat (@Homd_target_catd K E) x x' p));

assertnot [K : Cat] (E : τ (Catd K)) [x x' : τ (Obj K)]
  [p q : τ (Hom K x x')] (alpha : τ (Hom (Hom_cat K x x') p q)) ⊢
  @fapp1_fapp0 (Hom_cat (CoAt2_cat K) x x')
    (Functor_cart_cat (@Homd_section_cat K E x) (@Homd_section_cat K E x'))
    (@fapp1_func (CoAt2_cat K) Cat_cat (@Homd_target_catd K E) x x') p q alpha
  : τ (@StrictTransfor (@Homd_section_cat K E x) (@Homd_section_cat K E x')
      (@fapp1_fapp0 (CoAt2_cat K) Cat_cat (@Homd_target_catd K E) x x' p)
      (@fapp1_fapp0 (CoAt2_cat K) Cat_cat (@Homd_target_catd K E) x x' q));

// Actual canonical source section: runtime keeps postcomposition ownership.
assert [K : Cat] (E : τ (Catd K)) [x x' : τ (Obj K)] (p : τ (Hom K x x')) (u : τ (Obj (Fibre_cat E x))) ⊢
  (fapp0 (@fapp1_fapp0 (CoAt2_cat K) Cat_cat (@Homd_target_catd K E) x x' p) (@homd_id_src_sec K E x u))
  ≡ (@hom_postcomp_fapp0 (Functor_cat K Prof_cov_universe) (CoAt2_cat K) (ProfRep_cov_int K) (@Prof_cov_diagram K E) x x' p (@homd_id_src_sec K E x u));

// Raw vertical composition is only a typed proof-time observation.
assert [K : Cat] (E : τ (Catd K)) [x x' : τ (Obj K)] (p : τ (Hom K x x')) (u : τ (Obj (Fibre_cat E x))) ⊢
  (@eq_refl (Obj (@Homd_section_cat K E x')) (fapp0 (@fapp1_fapp0 (CoAt2_cat K) Cat_cat (@Homd_target_catd K E) x x' p) (@homd_id_src_sec K E x u)))
  : τ (@= (Obj (@Homd_section_cat K E x'))
    (fapp0 (@fapp1_fapp0 (CoAt2_cat K) Cat_cat (@Homd_target_catd K E) x x' p) (@homd_id_src_sec K E x u))
    (@comp_fapp0 (Functor_cat K Prof_cov_universe) (@Prof_cov_diagram K E) (@Prof_cov_diagram K (@hom_ K K (@id_func K) x)) (@Prof_cov_diagram K (@hom_ K K (@id_func K) x')) (@fapp1_fapp0 (CoAt2_cat K) (Functor_cat K Prof_cov_universe) (ProfRep_cov_int K) x x' p) (@homd_id_src_sec K E x u)));

// The identity primitive's generic whole and capped observations agree,
// without yet assigning the whole action a computational normal form.
assert [K : Cat] (E : τ (Catd K)) [x x' : τ (Obj K)] (p : τ (Hom K x x')) ⊢
  fapp0 (@tapp1_func (CoAt2_cat K) Cat_cat (@Op_catd K E) (@Homd_target_catd K E)
      x x' (@homd_id_int K E)) p
  ≡ @tapp1_fapp0 (CoAt2_cat K) Cat_cat (@Op_catd K E) (@Homd_target_catd K E)
      x x' (@homd_id_int K E) p;
