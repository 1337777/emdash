// The displayed weakening remains a default lax Functord. Its canonical
// fibre value is the existing Cartesian constant-functor constructor.
assert [K : Cat] (A : τ (Catd (Op_cat K))) (B : τ (Catd K)) (k : τ (Obj K)) ⊢
  @tapp0_fapp0 K Cat_cart B (@Functor_catd K A B) k
    (@Functor_catd_const_funcd K A B)
  ≡ @Const_func_func (Fibre_cat A k) (Fibre_cat B k);
assert [K : Cat] (A : τ (Catd (Op_cat K))) (B : τ (Catd K))
  (x y : τ (Obj K)) (p : τ (Hom K x y))
  (v : τ (Obj (Fibre_cat B x))) (a : τ (Obj (Fibre_cat A y))) ⊢
  fapp0 (fapp0 (@tapp1_fapp0 K Cat_cart B (@Functor_catd K A B)
    x y (@Functor_catd_const_funcd K A B) p) v) a
  ≡ fapp0 (@catd_transport_func K B x y p) v;

// The original exchange keeps its direct object and arrow projection ladder.
assert [A B C : Cat] (H : τ (Functor A (Functor_cart_cat B C)))
  (a : τ (Obj A)) (b : τ (Obj B)) ⊢
  fapp0 (fapp0 (fapp0 (@sym_func_func A B C) H) b) a
  ≡ fapp0 (fapp0 H a) b;
assert [A B C : Cat] (H : τ (Functor A (Functor_cart_cat B C)))
  (a a' : τ (Obj A)) (p : τ (Hom A a a')) (b : τ (Obj B)) ⊢
  @fapp1_fapp0 A C (@sym_fapp0_func A B C H b) a a' p
  ≡ @tapp0_fapp0 B C (fapp0 H a) (fapp0 H a') b
      (@strict_transfor B C _ _ (@fapp1_fapp0 A (Functor_cart_cat B C) H a a' p));

// Whole and projected double-exchange retain the original functor action.
assert [A B C : Cat] (H : τ (Functor A (Functor_cart_cat B C))) ⊢
  @sym_func B A C (@sym_func A B C H) ≡ H;
assert [A B C : Cat] (H : τ (Functor A (Functor_cart_cat B C)))
  (a a' : τ (Obj A)) ⊢
  @sym_fapp1_func B A C (@sym_func A B C H) a a'
  ≡ @fapp1_func A (Functor_cart_cat B C) H a a';
assert [A B C : Cat] [H G : τ (Functor A (Functor_cart_cat B C))]
  (eta : τ (Hom (Functor_cart_cat A (Functor_cart_cat B C)) H G)) ⊢
  @sym_func_func_transf B A C (@sym_func A B C H) (@sym_func A B C G)
    (@sym_func_func_transf A B C H G eta) ≡ eta;

// Evaluate the actual Hom action of the whole exchange, in both arguments.
assert [A B C : Cat] [H G : τ (Functor A (Functor_cart_cat B C))]
  (eta : τ (Hom (Functor_cart_cat A (Functor_cart_cat B C)) H G))
  (a : τ (Obj A)) (b : τ (Obj B)) ⊢
  tapp0_fapp0 a (strict_transfor
    (tapp0_fapp0 b (strict_transfor
      (@fapp1_fapp0 (Functor_cart_cat A (Functor_cart_cat B C))
        (Functor_cart_cat B (Functor_cart_cat A C)) (@sym_func_func A B C) H G eta))))
  ≡ tapp0_fapp0 b (strict_transfor
      (tapp0_fapp0 a (@strict_transfor A (Functor_cart_cat B C) H G eta)));

// An arbitrary higher input is retained after the whole double exchange.
assert [A B C : Cat] (H : τ (Functor A (Functor_cart_cat B C)))
  (a a' : τ (Obj A)) (p q : τ (Hom A a a'))
  (alpha : τ (Hom (Hom_cat A a a') p q)) ⊢
  @fapp1_fapp0 (Hom_cat A a a')
    (Hom_cat (Functor_cart_cat B C) (fapp0 H a) (fapp0 H a'))
    (@sym_fapp1_func B A C (@sym_func A B C H) a a') p q alpha
  ≡ @fapp1_fapp0 (Hom_cat A a a')
      (Hom_cat (Functor_cart_cat B C) (fapp0 H a) (fapp0 H a'))
      (@fapp1_func A (Functor_cart_cat B C) H a a') p q alpha;

// The Cartesian diagonal retains its original H[p][p] computation.
assert [A C : Cat] (H : τ (Functor A (Functor_cart_cat A C)))
  (a : τ (Obj A)) ⊢
  fapp0 (fapp0 (@diag_func_func A C) H) a ≡ fapp0 (fapp0 H a) a;
assert [A C : Cat] (H : τ (Functor A (Functor_cart_cat A C)))
  (a a' : τ (Obj A)) (p : τ (Hom A a a')) ⊢
  @fapp1_fapp0 A C (@diag_func A C H) a a' p
  ≡ @tapp1_fapp0 A C (fapp0 H a) (fapp0 H a') a a'
      (@strict_transfor A C _ _ (@fapp1_fapp0 A (Functor_cart_cat A C) H a a' p)) p;
assert [A C : Cat] [H G : τ (Functor A (Functor_cart_cat A C))]
  (eta : τ (Hom (Functor_cart_cat A (Functor_cart_cat A C)) H G))
  (a : τ (Obj A)) ⊢
  tapp0_fapp0 a (strict_transfor
    (@fapp1_fapp0 (Functor_cart_cat A (Functor_cart_cat A C))
      (Functor_cart_cat A C) (@diag_func_func A C) H G eta))
  ≡ tapp0_fapp0 a (strict_transfor
      (tapp0_fapp0 a (@strict_transfor A (Functor_cart_cat A C) H G eta)));

// Neither a raw lax inner family nor a raw lax transformation parameter is
// admitted to these Cartesian interchange operations.
assertnot [A B C : Cat] (H : τ (Functor A (Functor_cat B C))) ⊢
  @sym_func A B C H : τ (Functor B (Functor_cart_cat A C));
assertnot [A B C : Cat] [H G : τ (Functor A (Functor_cart_cat B C))]
  (eta : τ (Transf H G)) ⊢
  @sym_func_func_transf A B C H G eta
  : τ (Hom (Functor_cart_cat B (Functor_cart_cat A C))
      (@sym_func A B C H) (@sym_func A B C G));
assertnot [A C : Cat] (H : τ (Functor A (Functor_cat A C))) ⊢
  @diag_func A C H : τ (Functor A C);
