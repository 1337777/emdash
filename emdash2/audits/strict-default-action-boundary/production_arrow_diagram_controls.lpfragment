// The corrected exchange is whole in arbitrary parameter categories.
assert (A B C : Cat) (D : τ (Functor A (Functor_cat B C)))
  ⊢ @diagram_oplax_family_shape_func B A C (@diagram_family_shape_func A B C D) ≡ D;
assert (A B C : Cat) (D : τ (Functor A (Functor_cat B C))) (a : τ (Obj A))
  ⊢ @diagram_oplax_family_at_func B A C (@diagram_family_shape_func A B C D) a
    ≡ @fapp0 A (Functor_cat B C) D a;
assert (A B C : Cat) (D : τ (Functor A (Functor_cat B C))) (a b : τ (Obj A))
  ⊢ @fapp1_func A (Functor_cat B C)
      (@diagram_oplax_family_shape_func B A C (@diagram_family_shape_func A B C D)) a b
    ≡ @fapp1_func A (Functor_cat B C) D a b;
assert (A B C : Cat) (D : τ (Functor A (Functor_cat B C)))
  (a b : τ (Obj A)) (p : τ (Hom A a b))
  ⊢ @diagram_oplax_family_transf B A C (@diagram_family_shape_func A B C D) a b p
    ≡ @fapp1_fapp0 A (Functor_cat B C) D a b p;
assertnot (A B C : Cat) (D E : τ (Functor A (Functor_cat B C)))
  ⊢ @diagram_oplax_family_shape_func B A C (@diagram_family_shape_func A B C D) ≡ E;
assertnot (K C : Cat) (F G : τ (Functor K C)) (eta : τ (@Transf K C F G))
  ⊢ @transf_arrow_diagram_func K C F G eta : τ (Functor K (Functor_cat WalkingArrow_cat C));

// Evaluate the actual whole image of the walking generator. Do not demand
// a separate terminal-source eta normalization of that whole functor.
assert (K C : Cat) (F G : τ (Functor K C)) (eta : τ (@Transf K C F G)) (x : τ (Obj K))
  ⊢ @fapp0 Terminal_cat (Hom_cat C (@fapp0 K C F x) (@fapp0 K C G x))
      (@comp_cat_fapp0 Terminal_cat (Hom_cat WalkingArrow_cat walking_arrow_src walking_arrow_tgt)
      (Hom_cat C (@fapp0 K C F x) (@fapp0 K C G x))
      (@fapp1_func WalkingArrow_cat C (@transf_arrow_diagram_at_func K C F G eta x)
        walking_arrow_src walking_arrow_tgt)
      walking_arrow_generator_func) Terminal_obj
    ≡ @tapp0_fapp0 K C F G x eta;

// The fixed-prewhiskering composition clause cannot erase a nonidentity leg.
assertnot (A B C : Cat) (F : τ (Functor A B)) (G H J : τ (Functor B C))
  (beta : τ (@Transf A B F F))
  (eta : τ (@Transf B C H J)) (epsilon : τ (@Transf B C G H))
  ⊢ @comp_fapp0 (Functor_cat A C) _ _ _
      (@comp_prod_fapp1_fapp0 Cat_cat A B C
        (Struct_sigma F H) (Struct_sigma F J) (Struct_sigma beta eta))
      (@comp_prod_fapp1_fapp0 Cat_cat A B C
        (Struct_sigma F G) (Struct_sigma F H) (Struct_sigma (@id (Functor_cat A B) F) epsilon))
    ≡ @comp_prod_fapp1_fapp0 Cat_cat A B C
      (Struct_sigma F G) (Struct_sigma F J)
      (Struct_sigma (@id (Functor_cat A B) F) (@comp_fapp0 (Functor_cat B C) G H J eta epsilon));
