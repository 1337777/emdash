// Identity and vertical-composite transformations keep their components.
assert [A B : Cat] (F : τ (Functor A B)) ⊢
  @TotalOp_transf A B F F (@id (Functor_cat A B) F)
  ≡ @id (Functor_cat (TotalOp_cat A) (TotalOp_cat B)) (@TotalOp_func A B F);

assert [A B : Cat] (F : τ (Functor A B)) (x : τ (Obj A)) ⊢
  @ctop_component_observation A B F F (@id (Functor_cat A B) F) x
  ≡ @id B (@fapp0 A B F x);

assert [A B : Cat] [F G H : τ (Functor A B)]
  (epsilon : τ (Transf F G)) (eta : τ (Transf G H)) ⊢
  @TotalOp_transf A B F H (@comp_fapp0 (Functor_cat A B) F G H eta epsilon)
  ≡ @comp_fapp0 (Functor_cat (TotalOp_cat A) (TotalOp_cat B))
      (@TotalOp_func A B H) (@TotalOp_func A B G) (@TotalOp_func A B F)
      (@TotalOp_transf A B F G epsilon) (@TotalOp_transf A B G H eta);

assert [A B : Cat] [F G H : τ (Functor A B)]
  (epsilon : τ (Transf F G)) (eta : τ (Transf G H)) (x : τ (Obj A)) ⊢
  @ctop_component_observation A B F H
    (@comp_fapp0 (Functor_cat A B) F G H eta epsilon) x
  ≡ @comp_fapp0 B (@fapp0 A B F x) (@fapp0 A B G x) (@fapp0 A B H x)
      (@tapp0_fapp0 A B G H x eta) (@tapp0_fapp0 A B F G x epsilon);

// Projecting the whole map's action on the opposite composite uses that law.
assert [A B : Cat] [F G H : τ (Functor A B)]
  (epsilon : τ (Transf F G)) (eta : τ (Transf G H)) ⊢
  @fapp1_fapp0 (TotalOp_cat (Functor_cat A B))
    (Functor_cat (TotalOp_cat A) (TotalOp_cat B)) (TotalOp_func_func A B)
    H F (@comp_fapp0 (Functor_cat A B) F G H eta epsilon)
  ≡ @comp_fapp0 (Functor_cat (TotalOp_cat A) (TotalOp_cat B))
      (@TotalOp_func A B H) (@TotalOp_func A B G) (@TotalOp_func A B F)
      (@TotalOp_transf A B F G epsilon) (@TotalOp_transf A B G H eta);

// Reversal retains an arbitrary modification component, even for a loop.
assertnot [A B : Cat] [F G : τ (Functor A B)] (epsilon : τ (Transf F G))
  (Theta : τ (Hom (@Transf_cat A B F G) epsilon epsilon)) (x : τ (Obj A)) ⊢
  @eq_refl (Obj (Hom_cat (Hom_cat B (@fapp0 A B F x) (@fapp0 A B G x))
    (@tapp0_fapp0 A B F G x epsilon) (@tapp0_fapp0 A B F G x epsilon)))
    (@ctop_modification_observation A B F G epsilon epsilon Theta x)
  : τ (@= (Obj (Hom_cat (Hom_cat B (@fapp0 A B F x) (@fapp0 A B G x))
      (@tapp0_fapp0 A B F G x epsilon) (@tapp0_fapp0 A B F G x epsilon)))
      (@ctop_modification_observation A B F G epsilon epsilon Theta x)
      (@id (Hom_cat B (@fapp0 A B F x) (@fapp0 A B G x))
        (@tapp0_fapp0 A B F G x epsilon)));

// Dual distribution and original strict-action contraction have distinct
// runtime normal forms. The intended comparison is a typed proof-time join.
assertnot [K : Cat] (E : τ (Catd K)) [x y z : τ (Obj K)]
  (p : τ (Hom K x y)) (q : τ (Hom K y z)) ⊢
  @fapp1_fapp0 (CoAbove2_cat K) Cat_cat (@TotalOp_catd K E) x z
    (@comp_fapp0 K x y z q p)
  ≡ @comp_cat_fapp0
      (TotalOp_cat (@fapp0 K Cat_cat E x))
      (TotalOp_cat (@fapp0 K Cat_cat E y))
      (TotalOp_cat (@fapp0 K Cat_cat E z))
      (@TotalOp_func (@fapp0 K Cat_cat E y) (@fapp0 K Cat_cat E z)
        (@fapp1_fapp0 K Cat_cat E y z q))
      (@TotalOp_func (@fapp0 K Cat_cat E x) (@fapp0 K Cat_cat E y)
        (@fapp1_fapp0 K Cat_cat E x y p));

symbol ctop_family_comp_agrees [K : Cat] (E : τ (Catd K)) [x y z : τ (Obj K)]
  (p : τ (Hom K x y)) (q : τ (Hom K y z))
  : τ (@= (Functor (TotalOp_cat (@fapp0 K Cat_cat E x))
      (TotalOp_cat (@fapp0 K Cat_cat E z)))
    (@fapp1_fapp0 (CoAbove2_cat K) Cat_cat (@TotalOp_catd K E) x z
      (@comp_fapp0 K x y z q p))
    (@comp_cat_fapp0
      (TotalOp_cat (@fapp0 K Cat_cat E x))
      (TotalOp_cat (@fapp0 K Cat_cat E y))
      (TotalOp_cat (@fapp0 K Cat_cat E z))
      (@TotalOp_func (@fapp0 K Cat_cat E y) (@fapp0 K Cat_cat E z)
        (@fapp1_fapp0 K Cat_cat E y z q))
      (@TotalOp_func (@fapp0 K Cat_cat E x) (@fapp0 K Cat_cat E y)
        (@fapp1_fapp0 K Cat_cat E x y p))))
≔ @eq_refl (Functor (TotalOp_cat (@fapp0 K Cat_cat E x))
      (TotalOp_cat (@fapp0 K Cat_cat E z)))
    (@fapp1_fapp0 (CoAbove2_cat K) Cat_cat (@TotalOp_catd K E) x z
      (@comp_fapp0 K x y z q p));

// The image-composition reading cannot equate an unrelated original map H.
assertnot [A B C : Cat] (F : τ (Functor A B)) (G : τ (Functor B C))
  (H : τ (Functor A C)) ⊢
  @eq_refl (Functor (TotalOp_cat A) (TotalOp_cat C)) (@TotalOp_func A C H)
  : τ (@= (Functor (TotalOp_cat A) (TotalOp_cat C))
      (@comp_cat_fapp0 (TotalOp_cat A) (TotalOp_cat B) (TotalOp_cat C)
        (@TotalOp_func B C G) (@TotalOp_func A B F))
      (@TotalOp_func A C H));
