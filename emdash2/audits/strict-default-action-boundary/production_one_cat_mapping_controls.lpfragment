// Whole forward/inverse maps, not only their object projections.
assert [A C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C)) ⊢
  @comp_cat_fapp0 (Functor_cat A C) (Functor_cart_cat A C) (Functor_cat A C)
    (@one_cat_mapping_from_cart_func A C C1) (@one_cat_mapping_to_cart_func A C C1)
  ≡ @id_func (Functor_cat A C);
assert [A C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C)) ⊢
  @comp_cat_fapp0 (Functor_cart_cat A C) (Functor_cat A C) (Functor_cart_cat A C)
    (@one_cat_mapping_to_cart_func A C C1) (@one_cat_mapping_from_cart_func A C C1)
  ≡ @id_func (Functor_cart_cat A C);

// The whole first-Hom round trips retain the same actual inverse maps.
assert [A C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
  (F G : τ (Functor A C)) ⊢
  @eq_refl (Functor (@Transf_cat A C F G) (@Transf_cat A C F G))
    (@comp_cat_fapp0 (@Transf_cat A C F G) (Hom_cat (Functor_cart_cat A C) F G)
      (@Transf_cat A C F G)
      (@fapp1_func _ _ (@one_cat_mapping_from_cart_func A C C1) F G)
      (@fapp1_func _ _ (@one_cat_mapping_to_cart_func A C C1) F G))
  : τ (@= (Functor (@Transf_cat A C F G) (@Transf_cat A C F G))
    (@comp_cat_fapp0 (@Transf_cat A C F G) (Hom_cat (Functor_cart_cat A C) F G)
      (@Transf_cat A C F G)
      (@fapp1_func _ _ (@one_cat_mapping_from_cart_func A C C1) F G)
      (@fapp1_func _ _ (@one_cat_mapping_to_cart_func A C C1) F G))
    (@id_func (@Transf_cat A C F G)));

assert [A C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
  (F G : τ (Functor A C)) ⊢
  @eq_refl (Functor (Hom_cat (Functor_cart_cat A C) F G) (Hom_cat (Functor_cart_cat A C) F G))
    (@comp_cat_fapp0 (Hom_cat (Functor_cart_cat A C) F G) (@Transf_cat A C F G)
      (Hom_cat (Functor_cart_cat A C) F G)
      (@fapp1_func _ _ (@one_cat_mapping_to_cart_func A C C1) F G)
      (@fapp1_func _ _ (@one_cat_mapping_from_cart_func A C C1) F G))
  : τ (@= (Functor (Hom_cat (Functor_cart_cat A C) F G) (Hom_cat (Functor_cart_cat A C) F G))
    (@comp_cat_fapp0 (Hom_cat (Functor_cart_cat A C) F G) (@Transf_cat A C F G)
      (Hom_cat (Functor_cart_cat A C) F G)
      (@fapp1_func _ _ (@one_cat_mapping_to_cart_func A C C1) F G)
      (@fapp1_func _ _ (@one_cat_mapping_from_cart_func A C C1) F G))
    (@id_func (Hom_cat (Functor_cart_cat A C) F G)));

assert [A C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
  [F G : τ (Functor A C)] (epsilon : τ (@Transf A C F G)) ⊢
  @strict_transfor_underlying A C F G
    (@fapp1_fapp0 _ _ (@one_cat_mapping_to_cart_func A C C1) F G epsilon)
  ≡ epsilon;

assert [A C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
  [F G : τ (Functor A C)] (epsilon : τ (@Transf A C F G)) ⊢
  @eq_refl (@StrictTransfor A C F G)
    (@fapp1_fapp0 _ _ (@one_cat_mapping_to_cart_func A C C1) F G epsilon)
  : τ (@= (@StrictTransfor A C F G)
    (@fapp1_fapp0 _ _ (@one_cat_mapping_to_cart_func A C C1) F G epsilon)
    (@one_cat_strict_transfor A C C1 F G epsilon));

assert [A C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
  [F G : τ (Functor A C)] (U : τ (@StrictTransfor A C F G)) ⊢
  @eq_refl (@Transf A C F G)
    (@fapp1_fapp0 _ _ (@one_cat_mapping_from_cart_func A C C1) F G U)
  : τ (@= (@Transf A C F G)
    (@fapp1_fapp0 _ _ (@one_cat_mapping_from_cart_func A C C1) F G U)
    (@strict_transfor A C F G U));

// Identity observations join the action-first and ordinary-view-first orders.
assert [A C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
  (F : τ (Functor A C)) ⊢
  @eq_refl (@Transf A C F F)
    (@strict_transfor_underlying A C F F
      (@fapp1_fapp0 _ _ (@one_cat_mapping_to_cart_func A C C1) F F
        (@id (Functor_cat A C) F)))
  : τ (@= (@Transf A C F F)
    (@strict_transfor_underlying A C F F
      (@fapp1_fapp0 _ _ (@one_cat_mapping_to_cart_func A C C1) F F
        (@id (Functor_cat A C) F)))
    (@id (Functor_cat A C) F));

assert [A C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
  (F : τ (Functor A C)) ⊢
  @fapp1_fapp0 _ _ (@one_cat_mapping_from_cart_func A C C1) F F
    (@id (Functor_cart_cat A C) F)
  ≡ @strict_transfor A C F F (@id (Functor_cart_cat A C) F);

assertnot [A C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
  [F G : τ (Functor A C)] (epsilon other : τ (@Transf A C F G)) ⊢
  @strict_transfor_underlying A C F G
    (@fapp1_fapp0 _ _ (@one_cat_mapping_to_cart_func A C C1) F G epsilon)
  ≡ other;

assertnot [A C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
  [F G : τ (Functor A C)] (epsilon other : τ (@Transf A C F G)) ⊢
  @eq_refl (@Transf A C F G)
    (@strict_transfor A C F G
      (@fapp1_fapp0 _ _ (@one_cat_mapping_to_cart_func A C C1) F G epsilon))
  : τ (@= (@Transf A C F G)
    (@strict_transfor A C F G
      (@fapp1_fapp0 _ _ (@one_cat_mapping_to_cart_func A C C1) F G epsilon)) other);

assertnot [A C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C)) ⊢
  Functor_cat A C ≡ Functor_cart_cat A C;
