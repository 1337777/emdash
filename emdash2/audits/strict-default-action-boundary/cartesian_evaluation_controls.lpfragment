// NON-LIBRARY: the existing evaluation/curry ladder with Cartesian Hom.
assert [A B : Cat] (F : τ (Functor A B)) (x : τ (Obj A)) ⊢
  @fapp0 _ _ (@Eval_func A B) (Struct_sigma F x) ≡ @fapp0 A B F x;

assert [A B : Cat] [F G : τ (Functor A B)]
  (epsilon : τ (@StrictTransfor A B F G))
  [x y : τ (Obj A)] (p : τ (Hom A x y)) ⊢
  @fapp1_fapp0 _ _ (@Eval_func A B)
    (Struct_sigma F x) (Struct_sigma G y) (Struct_sigma epsilon p)
  ≡ @tapp1_fapp0 A B F G x y (@strict_transfor A B F G epsilon) p;

assertnot [A B : Cat] [F G : τ (Functor A B)]
  (epsilon : τ (Transf F G)) [x y : τ (Obj A)] (p : τ (Hom A x y)) ⊢
  @fapp1_fapp0 _ _ (@Eval_func A B)
    (Struct_sigma F x) (Struct_sigma G y) (Struct_sigma epsilon p)
  : τ (Hom B (@fapp0 A B F x) (@fapp0 A B G y));

// Fixed-object evaluation still admits the original ambient transfor.
assert [A B : Cat] [F G : τ (Functor A B)]
  (epsilon : τ (Transf F G)) (x : τ (Obj A)) ⊢
  @fapp1_fapp0 _ _ (@fapp0_func A B x) F G epsilon
  ≡ @tapp0_fapp0 A B F G x epsilon;

assert [A B : Cat] (x : τ (Obj A)) ⊢
  @comp_cat_fapp0 _ _ _ (@Eval_func A B) (@Eval_at_func A B x)
  ≡ @comp_cat_fapp0 (Functor_cart_cat A B) (Functor_cat A B) B
      (@fapp0_func A B x) (cart_functor_include A B);

// The original composition bodies derive Cartesian curry and uncurry.
assert [A B C : Cat] (F : τ (Functor (Product_cat A B) C)) ⊢
  @curry_func A B C F : τ (Functor A (Functor_cart_cat B C));

assert [A B C : Cat] (F : τ (Functor (Product_cat A B) C))
  (x : τ (Obj A)) (y : τ (Obj B)) ⊢
  fapp0 (@curry_fapp0_func A B C F x) y
  ≡ @fapp0 B C
      (@fapp0 A (Functor_cart_cat B C)
        (@hom_precomp_along_fapp0 Cat_cat Cat_cat (@id Cat_cat Cat_cat)
          (Functor_cart_cat B C) A
          (Product_cat (Functor_cart_cat B A) (Functor_cart_cat B B))
          (@Product_pair_tele_func A B)
          (@hom_postcomp_func Cat_cat Cat_cat (@id Cat_cat Cat_cat)
            B (Product_cat A B) C F)) x) y;

assert [A B C : Cat] (G : τ (Functor A (Functor_cart_cat B C)))
  (x : τ (Obj A)) (y : τ (Obj B)) ⊢
  @fapp0 (Product_cat A B) C (@uncurry_func A B C G) (Struct_sigma x y)
  ≡ @fapp0 B C (@fapp0 A (Functor_cart_cat B C) G x) y;

assert [A B C : Cat] (G : τ (Functor A (Functor_cart_cat B C)))
  [x x' : τ (Obj A)] [y y' : τ (Obj B)]
  (p : τ (Hom A x x')) (q : τ (Hom B y y')) ⊢
  @fapp1_fapp0 (Product_cat A B) C (@uncurry_func A B C G)
    (Struct_sigma x y) (Struct_sigma x' y') (Struct_sigma p q)
  ≡ @tapp1_fapp0 B C _ _ y y'
      (@strict_transfor B C _ _
        (@fapp1_fapp0 A (Functor_cart_cat B C) G x x' p)) q;

assertnot [A B C : Cat] (G : τ (Functor A (Functor_cat B C))) ⊢
  @uncurry_func A B C G : τ (Functor (Product_cat A B) C);
