// NON-LIBRARY: ordinary lax views of the canonical strict roots. These
// are whole inclusions, not strictness requirements on the input FF.
symbol sf_cq_homd_id_view [K : Cat] (E : τ (Functor K sf_cart_cat))
  : τ (@Transf K sf_cart_cat E (@sf_cq_homd_target K E))
≔ @strict_transfor K sf_cart_cat E (@sf_cq_homd_target K E) (@sf_cq_homd_id_int K E);

symbol sf_cq_homd_rel_view [K : Cat] [D E : τ (Functor K sf_cart_cat)]
  (FF : τ (@Transf K sf_cart_cat D E))
  : τ (@Transf K sf_cart_cat E (@sf_cq_homd_target K D))
≔ @strict_transfor K sf_cart_cat E (@sf_cq_homd_target K D) (@sf_cq_homd_rel_int K D E FF);

// B(FF,GG)=relative(GG) o FF is a default lax transformation across K.
symbol sf_cq_action_boundary [K : Cat] [E D : τ (Functor K sf_cart_cat)]
  (FF GG : τ (@Transf K sf_cart_cat E D))
  : τ (@Transf K sf_cart_cat E (@sf_cq_homd_target K E))
≔ @comp_fapp0 (Functor_cat K sf_cart_cat) E D (@sf_cq_homd_target K E)
    (@sf_cq_homd_rel_view K E D GG) FF;

// Native whole internal action, transported to the corrected root type.
// The direction B=>h is forced by its T(S_E) target. This is a structural
// action owner; higher coherence is not derived from its type alone.
symbol sf_cq_tdapp1_int_func [K : Cat] [E D : τ (Functor K sf_cart_cat)]
  [FF GG : τ (@Transf K sf_cart_cat E D)]
  : τ (Functor (Hom_cat (@Transf_cat K sf_cart_cat E D) FF GG)
      (Hom_cat (@Transf_cat K sf_cart_cat E (@sf_cq_homd_target K E))
        (@sf_cq_action_boundary K E D FF GG) (@sf_cq_homd_id_view K E)));

// Identity specialization is FF's intrinsic action, not an additional cell
// argument. The remaining projections are definitions of actual components.
symbol sf_cq_fdapp1_int [K : Cat] [E D : τ (Functor K sf_cart_cat)]
  (FF : τ (@Transf K sf_cart_cat E D))
  : τ (Obj (Hom_cat (@Transf_cat K sf_cart_cat E (@sf_cq_homd_target K E))
      (@sf_cq_action_boundary K E D FF FF) (@sf_cq_homd_id_view K E)))
≔ fapp0 (@sf_cq_tdapp1_int_func K E D FF FF) (@id (@Transf_cat K sf_cart_cat E D) FF);

// The identity displayed map has identity intrinsic action. This clause
// does not apply to the identity modification of an arbitrary lax FF.
rule fapp0 (@sf_cq_tdapp1_int_func $K $E $E
        (@id (Functor_cat $K sf_cart_cat) $E) (@id (Functor_cat $K sf_cart_cat) $E))
      (@id _ (@id (Functor_cat $K sf_cart_cat) $E))
  ↪ @id (@Transf_cat $K sf_cart_cat $E (@sf_cq_homd_target $K $E)) (@sf_cq_homd_id_view $K $E);

symbol sf_cq_tdapp1_section [K : Cat] [E D : τ (Functor K sf_cart_cat)]
  [FF GG : τ (@Transf K sf_cart_cat E D)]
  (eta : τ (Obj (Hom_cat (@Transf_cat K sf_cart_cat E (@sf_cq_homd_target K E))
      (@sf_cq_action_boundary K E D FF GG) (@sf_cq_homd_id_view K E))))
  (x : τ (Obj K)) (u : τ (Obj (@fapp0 K sf_cart_cat E x)))
  : τ (Hom (@sf_cq_homd_section_cat K E x) (@sf_cq_homd_src_sec K E x u)
      (@sf_cq_homd_rel_section K E D GG x
        (fapp0 (@tapp0_fapp0 K sf_cart_cat E D x FF) u)))
≔ fapp0 (@sf_cart_component_func (@fapp0 K sf_cart_cat E x) (Op_cat (@sf_cq_homd_section_cat K E x))
    (@tapp0_fapp0 K sf_cart_cat E (@sf_cq_homd_target K E) x (@sf_cq_action_boundary K E D FF GG))
    (@tapp0_fapp0 K sf_cart_cat E (@sf_cq_homd_target K E) x (@sf_cq_homd_id_view K E)) u)
    (@tapp0_hom_fapp0 K sf_cart_cat E (@sf_cq_homd_target K E)
      (@sf_cq_action_boundary K E D FF GG) (@sf_cq_homd_id_view K E) x eta);

symbol sf_cq_tdapp1_y [K : Cat] [E D : τ (Functor K sf_cart_cat)]
  [FF GG : τ (@Transf K sf_cart_cat E D)]
  (eta : τ (Obj (Hom_cat (@Transf_cat K sf_cart_cat E (@sf_cq_homd_target K E))
      (@sf_cq_action_boundary K E D FF GG) (@sf_cq_homd_id_view K E))))
  (x : τ (Obj K)) (u : τ (Obj (@fapp0 K sf_cart_cat E x))) (y : τ (Obj K))
  : τ (Hom (Hom_cat sf_cq_cat (@fapp0 K sf_cart_cat E y) (Hom_cat K x y))
      (@sf_cq_homd_tgt K E x u y)
      (@tapp0_fapp0 K sf_cq_cat (@sf_cq_diagram K E) (@sf_cq_diagram K (@sf_cart_hom K x)) y
        (@sf_cq_homd_rel_section K E D GG x (fapp0 (@tapp0_fapp0 K sf_cart_cat E D x FF) u))))
≔ @tapp0_hom_fapp0 K sf_cq_cat (@sf_cq_diagram K E) (@sf_cq_diagram K (@sf_cart_hom K x))
    (@sf_cq_homd_src_sec K E x u)
    (@sf_cq_homd_rel_section K E D GG x (fapp0 (@tapp0_fapp0 K sf_cart_cat E D x FF) u)) y
    (@sf_cq_tdapp1_section K E D FF GG eta x u);

symbol sf_cq_tdapp1_v [K : Cat] [E D : τ (Functor K sf_cart_cat)]
  [FF GG : τ (@Transf K sf_cart_cat E D)]
  (eta : τ (Obj (Hom_cat (@Transf_cat K sf_cart_cat E (@sf_cq_homd_target K E))
      (@sf_cq_action_boundary K E D FF GG) (@sf_cq_homd_id_view K E))))
  (x : τ (Obj K)) (u : τ (Obj (@fapp0 K sf_cart_cat E x)))
  (y : τ (Obj K)) (v : τ (Obj (@fapp0 K sf_cart_cat E y)))
  : τ (Hom (sf_cart_functor_cat (Op_cat (Hom_cat K x y)) sf_cart_cat)
      (@sf_cq_homd_ K E x u y v)
      (@sf_cq_homd_ K D x (fapp0 (@tapp0_fapp0 K sf_cart_cat E D x FF) u)
        y (fapp0 (@tapp0_fapp0 K sf_cart_cat E D y GG) v)))
≔ fapp0 (@sf_cart_component_func (@fapp0 K sf_cart_cat E y)
      (sf_cart_functor_cat (Op_cat (Hom_cat K x y)) sf_cart_cat)
      (@sf_cq_homd_tgt K E x u y)
      (@tapp0_fapp0 K sf_cq_cat (@sf_cq_diagram K E) (@sf_cq_diagram K (@sf_cart_hom K x)) y
        (@sf_cq_homd_rel_section K E D GG x (fapp0 (@tapp0_fapp0 K sf_cart_cat E D x FF) u))) v)
    (@sf_cq_tdapp1_y K E D FF GG eta x u y);

symbol sf_cq_tdapp1_hom [K : Cat] [E D : τ (Functor K sf_cart_cat)]
  [FF GG : τ (@Transf K sf_cart_cat E D)]
  (eta : τ (Obj (Hom_cat (@Transf_cat K sf_cart_cat E (@sf_cq_homd_target K E))
      (@sf_cq_action_boundary K E D FF GG) (@sf_cq_homd_id_view K E))))
  (x : τ (Obj K)) (u : τ (Obj (@fapp0 K sf_cart_cat E x)))
  (y : τ (Obj K)) (v : τ (Obj (@fapp0 K sf_cart_cat E y))) (p : τ (Hom K x y))
  : τ (Functor
      (Hom_cat (@fapp0 K sf_cart_cat E y) (fapp0 (@fapp1_fapp0 K sf_cart_cat E x y p) u) v)
      (Hom_cat (@fapp0 K sf_cart_cat D y)
        (fapp0 (@fapp1_fapp0 K sf_cart_cat D x y p) (fapp0 (@tapp0_fapp0 K sf_cart_cat E D x FF) u))
        (fapp0 (@tapp0_fapp0 K sf_cart_cat E D y GG) v)))
≔ fapp0 (@sf_cart_component_func (Op_cat (Hom_cat K x y)) sf_cart_cat
      (@sf_cq_homd_ K E x u y v)
      (@sf_cq_homd_ K D x (fapp0 (@tapp0_fapp0 K sf_cart_cat E D x FF) u)
        y (fapp0 (@tapp0_fapp0 K sf_cart_cat E D y GG) v)) p)
    (@sf_cq_tdapp1_v K E D FF GG eta x u y v);

symbol sf_cq_fdapp1_filler [K : Cat] [E D : τ (Functor K sf_cart_cat)]
  (FF : τ (@Transf K sf_cart_cat E D)) [x y : τ (Obj K)]
  (p : τ (Hom K x y)) (u : τ (Obj (@fapp0 K sf_cart_cat E x)))
  (v : τ (Obj (@fapp0 K sf_cart_cat E y)))
  (a : τ (Hom (@fapp0 K sf_cart_cat E y) (fapp0 (@fapp1_fapp0 K sf_cart_cat E x y p) u) v))
  : τ (Hom (@fapp0 K sf_cart_cat D y)
      (fapp0 (@fapp1_fapp0 K sf_cart_cat D x y p) (fapp0 (@tapp0_fapp0 K sf_cart_cat E D x FF) u))
      (fapp0 (@tapp0_fapp0 K sf_cart_cat E D y FF) v))
≔ fapp0 (@sf_cq_tdapp1_hom K E D FF FF (@sf_cq_fdapp1_int K E D FF) x u y v p) a;

// Forward laxity is obtained by evaluating the whole action on a transported
// identity filler. It is not a newly supplied or independent witness.
symbol sf_cq_fdapp1_laxity [K : Cat] [E D : τ (Functor K sf_cart_cat)]
  (FF : τ (@Transf K sf_cart_cat E D)) [x y : τ (Obj K)]
  (p : τ (Hom K x y)) (u : τ (Obj (@fapp0 K sf_cart_cat E x)))
  : τ (Hom (@fapp0 K sf_cart_cat D y)
      (fapp0 (@fapp1_fapp0 K sf_cart_cat D x y p) (fapp0 (@tapp0_fapp0 K sf_cart_cat E D x FF) u))
      (fapp0 (@tapp0_fapp0 K sf_cart_cat E D y FF) (fapp0 (@fapp1_fapp0 K sf_cart_cat E x y p) u)))
≔ @sf_cq_fdapp1_filler K E D FF x y p u (fapp0 (@fapp1_fapp0 K sf_cart_cat E x y p) u)
    (@id (@fapp0 K sf_cart_cat E y) (fapp0 (@fapp1_fapp0 K sf_cart_cat E x y p) u));
