// NON-LIBRARY: the two actual input maps for represented-middle balancing.
// The source contains beta:e'->E[q](e0) and r:U[y](e1)->d. Moving h:e0->e1
// to either side gives the two presentations of the same composite.
symbol sf_cq_balance_left [K : Cat] [E D : τ (Functor K sf_cart_cat)]
  (U : τ (Hom (sf_cart_functor_cat K sf_cart_cat) E D))
  [y z : τ (Obj K)] (q : τ (Hom K y z))
  (d : τ (Obj (fapp0 D y))) [e0 e1 : τ (Obj (fapp0 E y))]
  (h : τ (Hom (fapp0 E y) e0 e1)) (e' : τ (Obj (fapp0 E z)))
  : τ (Functor
      (Product_cat
        (Hom_cat (fapp0 E z) e' (fapp0 (@fapp1_fapp0 K sf_cart_cat E y z q) e0))
        (Hom_cat (fapp0 D y) (fapp0 (fapp0 (@sf_cart_component_func K sf_cart_cat E D y) U) e1) d))
      (Hom_cat (fapp0 D z)
        (fapp0 (fapp0 (@sf_cart_component_func K sf_cart_cat E D z) U) e')
        (fapp0 (@fapp1_fapp0 K sf_cart_cat D y z q) d)))
≔ @comp_cat_fapp0 _ _ _ (@sf_cq_mate_generator_map K E D U y z q d e1 e')
    (Struct_sigma
      (@comp_cat_fapp0 _ _ _
        (@hom_postcomp_func (fapp0 E z) (fapp0 E z) (@id_func (fapp0 E z)) e'
          (fapp0 (@fapp1_fapp0 K sf_cart_cat E y z q) e0)
          (fapp0 (@fapp1_fapp0 K sf_cart_cat E y z q) e1)
          (@fapp1_fapp0 (fapp0 E y) (fapp0 E z) (@fapp1_fapp0 K sf_cart_cat E y z q) e0 e1 h))
        (@Product_projL_func
          (Hom_cat (fapp0 E z) e' (fapp0 (@fapp1_fapp0 K sf_cart_cat E y z q) e0))
          (Hom_cat (fapp0 D y) (fapp0 (fapp0 (@sf_cart_component_func K sf_cart_cat E D y) U) e1) d)))
      (@Product_projR_func
        (Hom_cat (fapp0 E z) e' (fapp0 (@fapp1_fapp0 K sf_cart_cat E y z q) e0))
        (Hom_cat (fapp0 D y) (fapp0 (fapp0 (@sf_cart_component_func K sf_cart_cat E D y) U) e1) d)));

symbol sf_cq_balance_right [K : Cat] [E D : τ (Functor K sf_cart_cat)]
  (U : τ (Hom (sf_cart_functor_cat K sf_cart_cat) E D))
  [y z : τ (Obj K)] (q : τ (Hom K y z))
  (d : τ (Obj (fapp0 D y))) [e0 e1 : τ (Obj (fapp0 E y))]
  (h : τ (Hom (fapp0 E y) e0 e1)) (e' : τ (Obj (fapp0 E z)))
  : τ (Functor
      (Product_cat
        (Hom_cat (fapp0 E z) e' (fapp0 (@fapp1_fapp0 K sf_cart_cat E y z q) e0))
        (Hom_cat (fapp0 D y) (fapp0 (fapp0 (@sf_cart_component_func K sf_cart_cat E D y) U) e1) d))
      (Hom_cat (fapp0 D z)
        (fapp0 (fapp0 (@sf_cart_component_func K sf_cart_cat E D z) U) e')
        (fapp0 (@fapp1_fapp0 K sf_cart_cat D y z q) d)))
≔ @comp_cat_fapp0 _ _ _ (@sf_cq_mate_generator_map K E D U y z q d e0 e')
    (Struct_sigma
      (@Product_projL_func
        (Hom_cat (fapp0 E z) e' (fapp0 (@fapp1_fapp0 K sf_cart_cat E y z q) e0))
        (Hom_cat (fapp0 D y) (fapp0 (fapp0 (@sf_cart_component_func K sf_cart_cat E D y) U) e1) d))
      (@comp_cat_fapp0 _ _ _
        (@hom_precomp_along_func (fapp0 D y) (fapp0 D y) (@id_func (fapp0 D y)) d
          (fapp0 (fapp0 (@sf_cart_component_func K sf_cart_cat E D y) U) e0)
          (fapp0 (fapp0 (@sf_cart_component_func K sf_cart_cat E D y) U) e1)
          (@fapp1_fapp0 (fapp0 E y) (fapp0 D y)
            (fapp0 (@sf_cart_component_func K sf_cart_cat E D y) U) e0 e1 h))
        (@Product_projR_func
          (Hom_cat (fapp0 E z) e' (fapp0 (@fapp1_fapp0 K sf_cart_cat E y z q) e0))
          (Hom_cat (fapp0 D y) (fapp0 (fapp0 (@sf_cart_component_func K sf_cart_cat E D y) U) e1) d))));
