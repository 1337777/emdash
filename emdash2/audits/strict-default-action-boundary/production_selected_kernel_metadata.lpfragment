// Proof-time metadata agreement at the selected source. Match the two
// composites linearly, then retain every category, endpoint and arrow.
unif_rule
  @comp_fapp0 $C0
    (@fapp0 _ _ (@kernel_presentation_func $C $S $t $T $W $P) $d)
    $Y $Z $g $f
  ≡ @comp_fapp0 $D $X1 $Y1 $Z1 $g1 $f1
  ↪ [ $C0 ≡ $C; $D ≡ $C;
      $X1 ≡ (@fapp0 (Functor_oplax_cat WalkingArrow_cat $C) $C
        (@kernel_presentation_func $C $S $t $T $W $P) $d);
      $Y1 ≡ $Y; $Z1 ≡ $Z; $g1 ≡ $g; $f1 ≡ $f ];
