// Fixed-endpoint leaf of the identity construction. This definition is
// available before Sigma; the later whole identity ladder projects to it.
symbol homd_id_ [K : Cat] (E : τ (Catd K))
  (x : τ (Obj K)) (u : τ (Obj (Fibre_cat E x)))
  (y : τ (Obj K)) (v : τ (Obj (Fibre_cat E y)))
  : τ (Functor (Op_cat (Hom_cat K x y)) Cat_cat)
≔ @hom_con (Fibre_cat E y) v (Hom_cat K x y)
    (@fib_cov_tapp0_func K E x y u);

// Relative fixed-endpoint observation substitutes only the strict component
// FF[y]. No law identifies the base-naturality cell of general FF with identity.
symbol homd_ [K : Cat] [D E : τ (Catd K)]
  (FF : τ (Functord D E)) (x : τ (Obj K))
  (u : τ (Obj (Fibre_cat E x))) (y : τ (Obj K))
  (v : τ (Obj (Fibre_cat D y)))
  : τ (Functor (Op_cat (Hom_cat K x y)) Cat_cat)
≔ @homd_id_ K E x u y (fapp0 (@tapp0_fapp0 K Cat_cat D E y FF) v);
