// Actual Cartesian inclusion followed by generic v evaluation.
assert [K : Cat] (E : τ (Catd K)) (x : τ (Obj K)) [u0 u1 u2 : τ (Obj (@Fibre_cat K E x))]
  (h : τ (Hom (@Fibre_cat K E x) u0 u1)) (k : τ (Hom (@Fibre_cat K E x) u1 u2)) (y : τ (Obj K)) (v : τ (Obj (@Fibre_cat K E y))) ⊢
  (@tapp0_fapp0 (@Fibre_cat K E y) (Functor_cart_cat (Op_cat (Hom_cat K x y)) Cat_cat) (@homd_id_tgt_func K E x u2 y) (@homd_id_tgt_func K E x u0 y) v
    (@strict_transfor (@Fibre_cat K E y) (Functor_cart_cat (Op_cat (Hom_cat K x y)) Cat_cat) (@homd_id_tgt_func K E x u2 y) (@homd_id_tgt_func K E x u0 y)
      (@comp_fapp0 (Functor_cart_cat (@Fibre_cat K E y) (Functor_cart_cat (Op_cat (Hom_cat K x y)) Cat_cat)) (@homd_id_tgt_func K E x u2 y) (@homd_id_tgt_func K E x u1 y) (@homd_id_tgt_func K E x u0 y)
    (@homd_id_u_y K E x u0 u1 h y) (@homd_id_u_y K E x u1 u2 k y))))
  ≡ (@comp_fapp0 (Functor_cart_cat (Op_cat (Hom_cat K x y)) Cat_cat) (@homd_id_ K E x u2 y v) (@homd_id_ K E x u1 y v) (@homd_id_ K E x u0 y v)
    (@homd_id_u_v K E x u0 u1 h y v) (@homd_id_u_v K E x u1 u2 k y v));

// The second intermediate rung must preserve this same reversed composition.
assert [K : Cat] (E : τ (Catd K)) (x : τ (Obj K)) [u0 u1 u2 : τ (Obj (@Fibre_cat K E x))]
  (h : τ (Hom (@Fibre_cat K E x) u0 u1)) (k : τ (Hom (@Fibre_cat K E x) u1 u2)) (y : τ (Obj K)) (v : τ (Obj (@Fibre_cat K E y))) ⊢
  (@tapp0_fapp0 (@Fibre_cat K E y) (Functor_cart_cat (Op_cat (Hom_cat K x y)) Cat_cat) (@homd_id_tgt_func K E x u2 y) (@homd_id_tgt_func K E x u0 y) v
    (@strict_transfor (@Fibre_cat K E y) (Functor_cart_cat (Op_cat (Hom_cat K x y)) Cat_cat) (@homd_id_tgt_func K E x u2 y) (@homd_id_tgt_func K E x u0 y)
      (@comp_fapp0 (Functor_cart_cat (@Fibre_cat K E y) (Functor_cart_cat (Op_cat (Hom_cat K x y)) Cat_cat)) (@homd_id_tgt_func K E x u2 y) (@homd_id_tgt_func K E x u1 y) (@homd_id_tgt_func K E x u0 y)
    (@homd_id_u_y K E x u0 u1 h y) (@homd_id_u_y K E x u1 u2 k y))))
  ≡ (@homd_id_u_v K E x u0 u2 (@comp_fapp0 (@Fibre_cat K E x) u0 u1 u2 k h) y v);
