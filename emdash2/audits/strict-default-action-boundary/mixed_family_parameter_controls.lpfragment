// NON-LIBRARY: varying B retains its ambient, possibly non-strict, maps.
assert [K : Cat] (A : τ (Catd (Op_cat K))) [B D : τ (Catd K)]
  (G : τ (Functord B D)) ⊢
  @fapp1_fapp0 (Catd_cat K) (Catd_cat K) (@Functor_catd_fapp0_func K A) B D G
  : τ (Functord (@Functor_catd K A B) (@Functor_catd K A D));
assert [K : Cat] (A : τ (Catd (Op_cat K))) [B D : τ (Catd K)]
  (G : τ (Functord B D)) (x : τ (Obj K))
  (H : τ (Functor (Fibre_cat A x) (Fibre_cat B x))) ⊢
  fapp0 (@tapp0_fapp0 K Cat_cat _ _ x
    (@fapp1_fapp0 (Catd_cat K) (Catd_cat K) (@Functor_catd_fapp0_func K A) B D G)) H
  ≡ @hom_postcomp_fapp0 Cat_cat Cat_cat (@id Cat_cat Cat_cat)
      (Fibre_cat A x) (Fibre_cat B x) (Fibre_cat D x)
      (@tapp0_fapp0 K Cat_cat B D x G) H;

// The negative parameter uses classified strict transformations; it does
// not assert a same-profile opposite for every raw displayed L.
assert [K : Cat] [A A' : τ (Catd (Op_cat K))]
  (U : τ (@StrictTransfor (Op_cat K) Cat_cat A' A)) ⊢
  @fapp1_fapp0 (Op_cat (Functor_cart_cat (Op_cat K) Cat_cat))
    (Functor_cat (Catd_cat K) (Catd_cat K)) (@Functor_catd_func K) A A' U
  : τ (Transf (@Functor_catd_fapp0_func K A) (@Functor_catd_fapp0_func K A'));
assertnot [K : Cat] [A A' : τ (Catd (Op_cat K))]
  (L : τ (Functord A' A)) ⊢
  @fapp1_fapp0 (Op_cat (Functor_cart_cat (Op_cat K) Cat_cat))
    (Functor_cat (Catd_cat K) (Catd_cat K)) (@Functor_catd_func K) A A' L
  : τ (Transf (@Functor_catd_fapp0_func K A) (@Functor_catd_fapp0_func K A'));

assert [K : Cat] [A A' : τ (Catd (Op_cat K))]
  (U : τ (@StrictTransfor (Op_cat K) Cat_cat A' A)) (B : τ (Catd K))
  (x : τ (Obj K)) (H : τ (Functor (Fibre_cat A x) (Fibre_cat B x))) ⊢
  fapp0 (@tapp0_fapp0 K Cat_cat _ _ x
    (@tapp0_fapp0 (Catd_cat K) (Catd_cat K) _ _ B
      (@fapp1_fapp0 (Op_cat (Functor_cart_cat (Op_cat K) Cat_cat))
        (Functor_cat (Catd_cat K) (Catd_cat K)) (@Functor_catd_func K) A A' U))) H
  ≡ @comp_cat_fapp0 (Fibre_cat A' x) (Fibre_cat A x) (Fibre_cat B x) H
      (@tapp0_fapp0 (Op_cat K) Cat_cat A' A x
        (@strict_transfor (Op_cat K) Cat_cat A' A U));

assert [K : Cat] [A : τ (Catd (Op_cat K))] [B C : τ (Catd K)]
  (x : τ (Obj K)) ⊢
  @tapp0_fapp0 K Cat_cat _ _ x (@Functor_catd_product_funcd K A B C)
  ≡ @id_func (Product_cat
      (Functor_cart_cat (Fibre_cat A x) (Fibre_cat B x))
      (Functor_cart_cat (Fibre_cat A x) (Fibre_cat C x)));
assert [K X : Cat] [A : τ (Catd (Op_cat K))] [B : τ (Catd K)]
  (x : τ (Obj K)) ⊢
  @tapp0_fapp0 K Cat_cat _ _ x (@Functor_comp_pair_funcd K X A B)
  ≡ @Functor_comp_pair_func (Fibre_cat A x) X (Fibre_cat B x);

// Dependency-complete recovery candidate for ambient fixed precomposition.
// Use Hom action of the existing family pullback at constant families. This
// avoids the invalid higher source action of the whole mapping constructor.
// Moving this body to comp_cat_con_func still needs owner reorganization and
// the actual projection/normal-form checks; these controls establish typing.
symbol sf_precomp_via_pullback [A B C : Cat] (F : τ (Functor A B))
  : τ (Functor (Functor_cat B C) (Functor_cat A C))
≔ @fapp1_func (Catd_cat B) (Catd_cat A) (@Pullback_catd_func A B F)
    (@Const_catd B Terminal_cat) (@Const_catd B C);
assert [A B C : Cat] (F : τ (Functor A B)) ⊢
  @sf_precomp_via_pullback A B C F : τ (Functor (Functor_cat B C) (Functor_cat A C));
assert [A B C : Cat] (F : τ (Functor A B)) (G : τ (Functor B C)) ⊢
  fapp0 (@sf_precomp_via_pullback A B C F) G : τ (Functor A C);
assert [A B C : Cat] (F : τ (Functor A B)) [G H : τ (Functor B C)]
  (epsilon : τ (Transf G H)) ⊢
  @fapp1_fapp0 (Functor_cat B C) (Functor_cat A C)
    (@sf_precomp_via_pullback A B C F) G H epsilon
  : τ (Transf (fapp0 (@sf_precomp_via_pullback A B C F) G)
      (fapp0 (@sf_precomp_via_pullback A B C F) H));
