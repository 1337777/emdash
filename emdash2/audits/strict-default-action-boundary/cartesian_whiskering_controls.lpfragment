// NON-LIBRARY owner-position controls: fixed whiskering retains ambient
// transfors, while the Cat-derived whole parameter action has Cartesian Homs.
assert [X Y Z : Cat] (G : τ (Functor Y Z)) [F H : τ (Functor X Y)]
  (alpha : τ (Transf F H)) ⊢
  @fapp1_fapp0 _ _ (@comp_cat_cov_func X Y Z G) F H alpha
  : τ (Transf (@comp_cat_fapp0 X Y Z G F) (@comp_cat_fapp0 X Y Z G H));

assert [X Y Z : Cat] (F : τ (Functor X Y)) [G H : τ (Functor Y Z)]
  (alpha : τ (Transf G H)) ⊢
  @fapp1_fapp0 _ _ (@comp_cat_con_func X Y Z F) G H alpha
  : τ (Transf (@comp_cat_fapp0 X Y Z G F) (@comp_cat_fapp0 X Y Z H F));

assert [X Y Z : Cat] (G : τ (Functor Y Z)) (F : τ (Functor X Y)) ⊢
  @fapp0 _ _ (@comp_cat_cov_func X Y Z G) F
  ≡ @comp_cat_fapp0 X Y Z G F;

assert [X Y Z : Cat] (G : τ (Functor Y Z)) (F : τ (Functor X Y)) ⊢
  @fapp0 _ _ (@comp_cat_con_func X Y Z F) G
  ≡ @comp_cat_fapp0 X Y Z G F;

assert [X Y Z : Cat] (G : τ (Functor Y Z)) ⊢
  @fapp0 _ _ (@comp_cat_cov_func_func X Y Z) G
  ≡ @comp_cat_cov_cart_func X Y Z G;

assert [X Y Z : Cat] (F : τ (Functor X Y)) ⊢
  @fapp0 _ _ (@comp_cat_con_func_func X Y Z) F
  ≡ @comp_cat_con_cart_func X Y Z F;

assert [X Y Z : Cat] [G H : τ (Functor Y Z)]
  (alpha : τ (@StrictTransfor Y Z G H)) ⊢
  @comp_cat_cov_func_func_transf X Y Z G H alpha
  : τ (Transf (@comp_cat_cov_cart_func X Y Z G) (@comp_cat_cov_cart_func X Y Z H));

assertnot [X Y Z : Cat] [G H : τ (Functor Y Z)]
  (alpha : τ (Transf G H)) ⊢
  @comp_cat_cov_func_func_transf X Y Z G H alpha
  : τ (Transf (@comp_cat_cov_cart_func X Y Z G) (@comp_cat_cov_cart_func X Y Z H));

// Actual offending Cat-composition input: raw epsilon is not a Cartesian
// 2-cell. This rejects the coefficient audit before any endpoint equation.
assertnot [A B : Cat] [F G : τ (Functor A B)]
  (epsilon : τ (Transf F G)) (x : τ (Obj A)) ⊢
  Struct_sigma (@id (Functor_cart_cat Terminal_cat A) (@Const_func Terminal_cat A x)) epsilon
  : τ (Hom
      (Product_cat (Functor_cart_cat Terminal_cat A) (Functor_cart_cat A B))
      (Struct_sigma (@Const_func Terminal_cat A x) F)
      (Struct_sigma (@Const_func Terminal_cat A x) G));
