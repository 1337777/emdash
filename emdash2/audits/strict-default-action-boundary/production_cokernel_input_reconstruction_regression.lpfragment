require open emdash.examples.one_cat_cokernel_family_inputs;
require open emdash.examples.one_cat_diagram_family_reconstruction;
require open emdash.emdash3_2_zero_arrow_family_action_paths;
require open emdash.examples.action_profile_profile_action_path_controls;
require open emdash.emdash3_2_adjunction_untranspose_naturality;
// The native map is the actual projection of the retained evidence.
assert [B C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
 (D : τ (Functor B (Functor_oplax_cat WalkingArrow_cat C))) ⊢
 @iso_evidence_to _ _ _ (@one_cat_oplax_diagram_family_reconstruction_evidence B C C1 D)
 ≡ @one_cat_oplax_diagram_family_reconstruction_to B C C1 D;
// The native map is the actual projection of the retained evidence.
assert [B C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
 (D : τ (Functor B (Functor_oplax_cat WalkingArrow_cat C))) ⊢
 @iso_evidence_from _ _ _ (@one_cat_oplax_diagram_family_reconstruction_evidence B C C1 D)
 ≡ @one_cat_oplax_diagram_family_reconstruction_from B C C1 D;
