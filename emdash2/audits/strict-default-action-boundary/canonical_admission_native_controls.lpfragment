// Control for the unchanged native shaped co-Yoneda beta imported here.
// The input profunctor and shaped element retain the public raw profile.
assert [I A B : Cat] (P : τ (Prof A B))
  (F : τ (Functor I A)) (M : τ (Functor I B))
  (p : τ (@Prof_hom I A B F P M)) ⊢
  @Prof_cell_apply I A B A B (@Prof_tensor A B B P (@Unit_prof B)) P
    (@id_func A) (@id_func B) F M (@Prof_coyoneda_cov_map A B P)
    (@Prof_tensor_hom_hom I A B B P (@Unit_prof B) F M M p (@Prof_func_hom I B M))
  ≡ p;
