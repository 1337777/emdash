// NON-LIBRARY immediate identity-middle overlap of the guarded cut with
// neutral reindexing and existing eval(lambda(k)) beta. Keep k arbitrary;
// the earlier counit(id) baseline alone only covered the co-Yoneda instance.
assert [I A B X : Cat]
  (P : τ (Prof A B)) (Q : τ (Prof B X)) (O : τ (Prof A X))
  (k : τ (ProfMap (@Prof_tensor A B X P Q) O))
  (a : τ (Functor I A)) (b : τ (Functor I X)) (m : τ (Functor I B))
  (r : τ (@Prof_hom I A B a P m))
  (s : τ (@Prof_hom I B X m Q b)) ⊢
  @Prof_cell_apply I A X A X
    (@Prof_tensor A B X
      (@Prof_reindex A A B B P (@id_func A) (@id_func B))
      (@Prof_reindex B B X X Q (@id_func B) (@id_func X))) O
    (@id_func A) (@id_func X) a b
    (@Prof_eval_cov_map A B X
      (@Prof_reindex A A B B P (@id_func A) (@id_func B))
      (@Prof_reindex B B X X Q (@id_func B) (@id_func X)) O
      (@Prof_reindex_transf A A B B P (@Prof_imply_cov A B X O Q)
        (@Prof_lambda_cov_map A B X P Q O k) (@id_func A) (@id_func B)))
    (@Prof_tensor_hom_hom I A B X
      (@Prof_reindex A A B B P (@id_func A) (@id_func B))
      (@Prof_reindex B B X X Q (@id_func B) (@id_func X)) a b m r s)
  ≡ @Prof_cell_apply I A X A X (@Prof_tensor A B X P Q) O
      (@id_func A) (@id_func X) a b k
      (@Prof_tensor_hom_hom I A B X P Q a b m r s);
