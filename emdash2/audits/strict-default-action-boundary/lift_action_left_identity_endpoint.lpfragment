// NON-LIBRARY independent positive endpoint boundary.
// Check this before interpreting mate_U(id_x)=id as a unit/counit triangle
// obstruction. No precomposition unit projection join is installed here.
assert [K : Cat] [E D : τ (Catd K)]
  (U : τ (@StrictTransfor K Cat_cat E D)) (x : τ (Obj K)) ⊢
  @fapp0 (Hom_cat K x x)
    (Hom_cat Prof_cov_universe (Fibre_cat D x) (Fibre_cat E x))
    (@Prof_cov_lift_left_func K E D U x x) (@id K x)
  ≡ @Prof_cov_companion (Fibre_cat E x) (Fibre_cat D x)
    (@tapp0_fapp0 K Cat_cat E D x (@strict_transfor K Cat_cat E D U));
