require open emdash.examples.displayed_evaluation;

// Compare the new composed action with the generic Cartesian observation,
// not with the body of the new projection rule.
assert [K : Cat] (E D C : τ (Catd K))
  (U : τ (Hom (Functor_cart_cat K Cat_cart) E D))
  (V : τ (Hom (Functor_cart_cat K Cat_cart) D C))
  [x y : τ (Obj K)] (p : τ (Hom K x y))
  (u : τ (Obj (Fibre_cat E x))) (v : τ (Obj (Fibre_cat E y))) ⊢
  @fdapp1_int_hom_func K E C (@strict_transfor K Cat_cart E C (@comp_fapp0 (Functor_cart_cat K Cat_cart) E D C V U)) x y p u v
  ≡ @fapp1_func (Fibre_cat E y) (Fibre_cat C y) (@Fibre_func K E C (@strict_transfor K Cat_cart E C (@comp_fapp0 (Functor_cart_cat K Cat_cart) E D C V U)) y) (@eval_order_transport K E x y p u) v;

assert [K : Cat] (E D C : τ (Catd K))
  (U : τ (Hom (Functor_cart_cat K Cat_cart) E D))
  (V : τ (Hom (Functor_cart_cat K Cat_cart) D C))
  [x y : τ (Obj K)] (p : τ (Hom K x y))
  (u : τ (Obj (Fibre_cat E x))) (v : τ (Obj (Fibre_cat E y)))
  (alpha : τ (Hom (Fibre_cat E y) (@eval_order_transport K E x y p u) v)) ⊢
  @fdapp1_int_hom_fapp0 K E C (@strict_transfor K Cat_cart E C (@comp_fapp0 (Functor_cart_cat K Cat_cart) E D C V U)) x y p u v alpha
  ≡ @fapp1_fapp0 (Fibre_cat E y) (Fibre_cat C y) (@Fibre_func K E C (@strict_transfor K Cat_cart E C (@comp_fapp0 (Functor_cart_cat K Cat_cart) E D C V U)) y) (@eval_order_transport K E x y p u) v alpha;

assert [K : Cat] (E D C : τ (Catd K))
  (U : τ (Hom (Functor_cart_cat K Cat_cart) E D))
  (V : τ (Hom (Functor_cart_cat K Cat_cart) D C))
  [x y : τ (Obj K)] (p : τ (Hom K x y))
  (u : τ (Obj (Fibre_cat E x))) (v : τ (Obj (Fibre_cat E y))) ⊢
  @fdapp1_int_cell K E C (@strict_transfor K Cat_cart E C (@comp_fapp0 (Functor_cart_cat K Cat_cart) E D C V U)) x y p u
  ≡ @id (Fibre_cat C y)
      (@fapp0 (Fibre_cat E y) (Fibre_cat C y) (@Fibre_func K E C (@strict_transfor K Cat_cart E C (@comp_fapp0 (Functor_cart_cat K Cat_cart) E D C V U)) y) (@eval_order_transport K E x y p u));

// The whole action retains its next Hom on distinct higher fillers.
type λ K : Cat, λ E : τ (Catd K), λ D : τ (Catd K), λ C : τ (Catd K),
  λ U : τ (Hom (Functor_cart_cat K Cat_cart) E D),
  λ V : τ (Hom (Functor_cart_cat K Cat_cart) D C),
  λ x : τ (Obj K), λ y : τ (Obj K), λ p : τ (Hom K x y),
  λ u : τ (Obj (Fibre_cat E x)), λ v : τ (Obj (Fibre_cat E y)),
  λ alpha : τ (Hom (Fibre_cat E y) (@eval_order_transport K E x y p u) v),
  λ beta : τ (Hom (Fibre_cat E y) (@eval_order_transport K E x y p u) v),
  @fapp1_func _ _ (@fdapp1_int_hom_func K E C (@strict_transfor K Cat_cart E C (@comp_fapp0 (Functor_cart_cat K Cat_cart) E D C V U)) x y p u v) alpha beta;

assertnot [K : Cat] (E D C : τ (Catd K))
  (U : τ (Hom (Functor_cart_cat K Cat_cart) E D))
  (V : τ (Hom (Functor_cart_cat K Cat_cart) D C))
  [x y : τ (Obj K)] (p : τ (Hom K x y))
  (u : τ (Obj (Fibre_cat E x))) (v : τ (Obj (Fibre_cat E y)))
  (alpha beta : τ (Hom (Fibre_cat E y) (@eval_order_transport K E x y p u) v)) ⊢
  @fdapp1_int_hom_fapp0 K E C (@strict_transfor K Cat_cart E C (@comp_fapp0 (Functor_cart_cat K Cat_cart) E D C V U)) x y p u v alpha
  ≡ @fdapp1_int_hom_fapp0 K E C (@strict_transfor K Cat_cart E C (@comp_fapp0 (Functor_cart_cat K Cat_cart) E D C V U)) x y p u v beta;
