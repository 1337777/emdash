// NON-LIBRARY native u-arrow projections of the existing identity Homd owner.
// These rungs specify its structural action, not an independent supplied map.
// The source is T(E[x]): h:u0->u1 therefore gives s(u1)->s(u0).
symbol homd_id_u_func [K : Cat] (E : τ (Catd K)) (x : τ (Obj K))
  [u0 u1 : τ (Obj (Fibre_cat E x))]
  : τ (Functor (Hom_cat (Fibre_cat E x) u0 u1)
      (Hom_cat (@Homd_section_cat K E x)
        (@homd_id_src_sec K E x u1) (@homd_id_src_sec K E x u0)));

symbol homd_id_u_map [K : Cat] (E : τ (Catd K)) (x : τ (Obj K))
  [u0 u1 : τ (Obj (Fibre_cat E x))] (h : τ (Hom (Fibre_cat E x) u0 u1))
  : τ (Hom (@Homd_section_cat K E x)
      (@homd_id_src_sec K E x u1) (@homd_id_src_sec K E x u0));

// At y this modification is a Cartesian Q-Hom map. This does not classify
// its ambient Homd root or its section as a strictly natural transformation.
symbol homd_id_u_y [K : Cat] (E : τ (Catd K)) (x : τ (Obj K))
  [u0 u1 : τ (Obj (Fibre_cat E x))] (h : τ (Hom (Fibre_cat E x) u0 u1))
  (y : τ (Obj K))
  : τ (@StrictTransfor (Fibre_cat E y)
      (Functor_cart_cat (Op_cat (Hom_cat K x y)) Cat_cat)
      (@homd_id_tgt_func K E x u1 y) (@homd_id_tgt_func K E x u0 y));

// At v the second Cartesian mapping category supplies the second strict view.
symbol homd_id_u_v [K : Cat] (E : τ (Catd K)) (x : τ (Obj K))
  [u0 u1 : τ (Obj (Fibre_cat E x))] (h : τ (Hom (Fibre_cat E x) u0 u1))
  (y : τ (Obj K)) (v : τ (Obj (Fibre_cat E y)))
  : τ (@StrictTransfor (Op_cat (Hom_cat K x y)) Cat_cat
      (@homd_id_ K E x u1 y v) (@homd_id_ K E x u0 y v));

// Full and capped source action share the native full Hom-action owner.
rule @fapp1_func _ _ (@homd_id_src_func $K $E $x) $u1 $u0
  ↪ @homd_id_u_func $K $E $x $u0 $u1;
rule fapp0 (@homd_id_u_func $K $E $x $u0 $u1) $h
  ↪ @homd_id_u_map $K $E $x $u0 $u1 $h;
rule @fapp1_fapp0 _ _ (@homd_id_src_func $K $E $x) $u1 $u0 $h
  ↪ @homd_id_u_map $K $E $x $u0 $u1 $h;

// Component evaluation is the existing generic modification projection.
rule @tapp0_hom_fapp0 _ _ _ _ _ _ $y
      (@homd_id_u_map $K $E $x $u0 $u1 $h)
  ↪ @homd_id_u_y $K $E $x $u0 $u1 $h $y;

rule @tapp0_fapp0 _ _ _ _ $v
      (@strict_transfor _ _ _ _ (@homd_id_u_y $K $E $x $u0 $u1 $h $y))
  ↪ @homd_id_u_v $K $E $x $u0 $u1 $h $y $v;

// Actual ordinary precomposition body: beta maps to beta o E[f](h).
// The existing whole precomposition functor retains all higher beta action.
rule @tapp0_fapp0 _ _ _ _ $f
      (@strict_transfor _ _ _ _ (@homd_id_u_v $K $E $x $u0 $u1 $h $y $v))
  ↪ @hom_precomp_along_func (Fibre_cat $E $x) (Fibre_cat $E $y)
      (@fapp1_fapp0 $K Cat_cat $E $x $y $f) $v $u0 $u1 $h;

// Projection-order joins for laws already imposed by homd_id_src_func:Functor.
// They preserve the stable native map while exposing identity/composite input.
rule @homd_id_u_map $K $E $x $u $u (@id _ $u)
  ↪ @id (@Homd_section_cat $K $E $x) (@homd_id_src_sec $K $E $x $u);

rule @comp_fapp0 _ _ _ _
      (@homd_id_u_map $K $E $x $u0 $u1 $h)
      (@homd_id_u_map $K $E $x $u1 $u2 $k)
  ↪ @homd_id_u_map $K $E $x $u0 $u2
      (@comp_fapp0 (Fibre_cat $E $x) $u0 $u1 $u2 $k $h);
