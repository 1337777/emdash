// The original point path now follows the constructor's runtime computation.
assert [C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
  [x y : τ (Obj C)] (f : τ (Hom C x y)) ⊢
  @eq_refl (Functor WalkingArrow_cat C)
    (@fapp0 _ _ (@one_cat_arrow_diagram_func C C1) (@lax_edge C x y f))
  : τ (@= (Functor WalkingArrow_cat C)
      (@fapp0 _ _ (@one_cat_arrow_diagram_func C C1) (@lax_edge C x y f))
      (@walking_arrow_func C x y f));

// A different supplied generating arrow is not substituted by that comparison.
assertnot [C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
  [x y : τ (Obj C)] (f g : τ (Hom C x y)) ⊢
  @eq_refl (Functor WalkingArrow_cat C)
    (@fapp0 _ _ (@one_cat_arrow_diagram_func C C1) (@lax_edge C x y f))
  : τ (@= (Functor WalkingArrow_cat C)
      (@fapp0 _ _ (@one_cat_arrow_diagram_func C C1) (@lax_edge C x y f))
      (@walking_arrow_func C x y g));

// The canonical constructor now computes through Cartesian evaluation.
// This intentionally replaces the former proof-time-only runtime negative.
assert [C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
  [x y : τ (Obj C)] (f : τ (Hom C x y)) ⊢
  @fapp0 _ _ (@one_cat_arrow_diagram_func C C1) (@lax_edge C x y f)
  ≡ @walking_arrow_func C x y f;
