// Whole covariant image of an admitted displayed map. The only operation
// is the existing fixed postcomposition action on its ambient strict view.
symbol sf_q_diagram_map [K : Cat] [D E : τ (Functor K Cat_cat)]
  (FF : τ (Obj (@sf_family_map_cat K D E)))
  : τ (@Transf K sf_q_cat (@sf_q_diagram K D) (@sf_q_diagram K E))
≔ @fapp1_fapp0 (Functor_cat K Cat_cat) (Functor_cat K sf_q_cat)
    (@comp_cat_cov_func K Cat_cat sf_q_cat sf_q_include) D E
    (@sf_family_map_view K D E FF);

// Relative Homd is actual composition with the identity section. These
// definitions inherit their projections; no FF-specific Homd rewrite is
// introduced and no second primitive dependent-Hom theory is postulated.
symbol sf_homd_rel_src_sec [K : Cat] [D E : τ (Functor K Cat_cat)]
  (FF : τ (Obj (@sf_family_map_cat K D E)))
  (x : τ (Obj K)) (u : τ (Obj (@fapp0 K Cat_cat E x)))
  : τ (Obj (@sf_homd_section_cat K D x))
≔ @comp_fapp0 (Functor_cat K sf_q_cat)
    (@sf_q_diagram K D) (@sf_q_diagram K E)
    (@sf_q_diagram K (@hom_ K K (@id_func K) x))
    (@sf_homd_id_src_sec K E x u) (@sf_q_diagram_map K D E FF);

symbol sf_homd_rel_tgt_func [K : Cat] [D E : τ (Functor K Cat_cat)]
  (FF : τ (Obj (@sf_family_map_cat K D E)))
  (x : τ (Obj K)) (u : τ (Obj (@fapp0 K Cat_cat E x))) (y : τ (Obj K))
  : τ (Functor (@fapp0 K Cat_cat D y)
      (Functor_cat (Op_cat (Hom_cat K x y)) Cat_cat))
≔ @tapp0_fapp0 K sf_q_cat (@sf_q_diagram K D)
    (@sf_q_diagram K (@hom_ K K (@id_func K) x)) y
    (@sf_homd_rel_src_sec K D E FF x u);

symbol sf_homd_rel_ [K : Cat] [D E : τ (Functor K Cat_cat)]
  (FF : τ (Obj (@sf_family_map_cat K D E)))
  (x : τ (Obj K)) (u : τ (Obj (@fapp0 K Cat_cat E x)))
  (y : τ (Obj K)) (v : τ (Obj (@fapp0 K Cat_cat D y)))
  : τ (Functor (Op_cat (Hom_cat K x y)) Cat_cat)
≔ fapp0 (@sf_homd_rel_tgt_func K D E FF x u y) v;
