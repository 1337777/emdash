// NON-LIBRARY first actual mate component consumer. This uses only the
// existing generic pointwise vertical-composition rule and checked step
// bodies. It adds no lift action, coherence, inverse, or runtime law.
symbol Prof_cov_lift_mate_component_view [K : Cat] [E D : τ (Catd K)]
  (U : τ (@StrictTransfor K Cat_cat E D)) [x y : τ (Obj K)]
  (q : τ (Hom K x y))
  : τ (Hom (Hom_cat Prof_cov_universe (Fibre_cat D x) (Fibre_cat E y))
      (@fapp0 (Hom_cat K x y)
        (Hom_cat Prof_cov_universe (Fibre_cat D x) (Fibre_cat E y))
        (@Prof_cov_lift_left_func K E D U x y) q)
      (@fapp0 (Hom_cat K x y)
        (Hom_cat Prof_cov_universe (Fibre_cat D x) (Fibre_cat E y))
        (@Prof_cov_lift_right_func K E D U x y) q))
≔ @comp_fapp0
    (Hom_cat Prof_cov_universe (Fibre_cat D x) (Fibre_cat E y))
    (@fapp0 (Hom_cat K x y)
      (Hom_cat Prof_cov_universe (Fibre_cat D x) (Fibre_cat E y))
      (@Prof_cov_lift_left_func K E D U x y) q)
    (@fapp0 (Hom_cat K x y)
      (Hom_cat Prof_cov_universe (Fibre_cat D x) (Fibre_cat E y))
      (@Prof_cov_lift_middle_func K E D U x y) q)
    (@fapp0 (Hom_cat K x y)
      (Hom_cat Prof_cov_universe (Fibre_cat D x) (Fibre_cat E y))
      (@Prof_cov_lift_right_func K E D U x y) q)
    (@tapp0_fapp0 (Hom_cat K x y)
      (Hom_cat Prof_cov_universe (Fibre_cat D x) (Fibre_cat E y))
      (@Prof_cov_lift_middle_func K E D U x y)
      (@Prof_cov_lift_right_func K E D U x y) q
      (@Prof_cov_lift_counit_step K E D U x y))
    (@tapp0_fapp0 (Hom_cat K x y)
      (Hom_cat Prof_cov_universe (Fibre_cat D x) (Fibre_cat E y))
      (@Prof_cov_lift_left_func K E D U x y)
      (@Prof_cov_lift_middle_func K E D U x y) q
      (@Prof_cov_lift_unit_step K E D U x y));

assert [K : Cat] [E D : τ (Catd K)]
  (U : τ (@StrictTransfor K Cat_cat E D)) [x y : τ (Obj K)]
  (q : τ (Hom K x y)) ⊢
  @tapp0_fapp0 (Hom_cat K x y)
    (Hom_cat Prof_cov_universe (Fibre_cat D x) (Fibre_cat E y))
    (@Prof_cov_lift_left_func K E D U x y)
    (@Prof_cov_lift_right_func K E D U x y) q
    (@Prof_cov_lift_comparison K E D U x y)
  ≡ @Prof_cov_lift_mate_component_view K E D U x y q;

// No implicit ordinary-isomorphism package is supplied by a forward mate.
// This is a capability/noncollapse boundary, not a theorem that every
// specialization is mathematically noninvertible.
assertnot [K : Cat] [E D : τ (Catd K)]
  (U : τ (@StrictTransfor K Cat_cat E D)) (x y : τ (Obj K)) ⊢
  @Prof_cov_lift_comparison K E D U x y
  : τ (IsoEvidence
      (Functor_cat (Hom_cat K x y)
        (Hom_cat Prof_cov_universe (Fibre_cat D x) (Fibre_cat E y)))
      (@Prof_cov_lift_left_func K E D U x y)
      (@Prof_cov_lift_right_func K E D U x y));
