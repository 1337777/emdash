// Projected identity of the represented x-package, after its whole Hom
// action has already become the fixed-x Homd source functor.
assert [K : Cat] (x : τ (Obj K)) ⊢
  fapp0 (@sf_homd_id_src_func K (@hom_ K K (@id_func K) x) x) (@id K x)
  ≡ @id (Functor_cat K sf_q_cat) (@sf_q_diagram K (@hom_ K K (@id_func K) x));

assert [K : Cat] [x y z : τ (Obj K)]
  (p : τ (Obj (Hom_cat K x y))) (q : τ (Obj (Hom_cat K y z))) ⊢
  @eq_refl (Hom (Functor_cat K sf_q_cat)
      (@sf_q_diagram K (@hom_ K K (@id_func K) x))
      (@sf_q_diagram K (@hom_ K K (@id_func K) z)))
    (@comp_fapp0 (Functor_cat K sf_q_cat)
      (@sf_q_diagram K (@hom_ K K (@id_func K) x))
      (@sf_q_diagram K (@hom_ K K (@id_func K) y))
      (@sf_q_diagram K (@hom_ K K (@id_func K) z))
      (@fapp1_fapp0 (CoAt2_cat K) (Functor_cat K sf_q_cat) (sf_homd_rep_int K) y z q)
      (@fapp1_fapp0 (CoAt2_cat K) (Functor_cat K sf_q_cat) (sf_homd_rep_int K) x y p))
  : τ (@= (Hom (Functor_cat K sf_q_cat)
        (@sf_q_diagram K (@hom_ K K (@id_func K) x))
        (@sf_q_diagram K (@hom_ K K (@id_func K) z)))
      (@comp_fapp0 (Functor_cat K sf_q_cat)
        (@sf_q_diagram K (@hom_ K K (@id_func K) x))
        (@sf_q_diagram K (@hom_ K K (@id_func K) y))
        (@sf_q_diagram K (@hom_ K K (@id_func K) z))
        (@fapp1_fapp0 (CoAt2_cat K) (Functor_cat K sf_q_cat) (sf_homd_rep_int K) y z q)
        (@fapp1_fapp0 (CoAt2_cat K) (Functor_cat K sf_q_cat) (sf_homd_rep_int K) x y p))
      (@fapp1_fapp0 (CoAt2_cat K) (Functor_cat K sf_q_cat) (sf_homd_rep_int K) x z
        (@comp_fapp0 K x y z q p)));

// The index-composition reading cannot identify an unrelated base arrow.
assertnot [K : Cat] [x y z : τ (Obj K)]
  (p : τ (Obj (Hom_cat K x y))) (q : τ (Obj (Hom_cat K y z)))
  (r : τ (Obj (Hom_cat K x z))) ⊢
  @eq_refl (Obj (@sf_homd_section_cat K (@hom_ K K (@id_func K) x) z))
    (@sf_homd_id_src_sec K (@hom_ K K (@id_func K) x) z r)
  : τ (@= (Obj (@sf_homd_section_cat K (@hom_ K K (@id_func K) x) z))
      (@sf_homd_id_src_sec K (@hom_ K K (@id_func K) x) z r)
      (@sf_homd_id_src_sec K (@hom_ K K (@id_func K) x) z (@comp_fapp0 K x y z q p)));

// The actual target-family action on the canonical section agrees at u
// with the root's pre/right action. No equality of whole lax boundaries
// or identity of its extracted comparison is asserted here.
assert [K : Cat] (E : τ (Functor K Cat_cat)) [x x' : τ (Obj K)]
  (p : τ (Obj (Hom_cat K x x'))) (u : τ (Obj (fapp0 E x))) ⊢
  fapp0 (@fapp1_fapp0 K Cat_cat (@sf_homd_target_catd K E) x x' p)
    (@sf_homd_id_src_sec K E x u)
  ≡ @sf_homd_id_src_sec K E x' (fapp0 (@fapp1_fapp0 K Cat_cat E x x' p) u);

// Nonidentity base two-cell of the root: after evaluating at u the result
// is the existing source-u map for E[alpha][u], in the reversed section Hom.
// Give the observation its common canonical Hom classifier before comparing
// the terms; bare Hom aliases otherwise invert T prematurely in the check.
symbol sf_homd_root_alpha_at [K : Cat] (E : τ (Functor K Cat_cat)) [x x' : τ (Obj K)]
  [p q : τ (Obj (Hom_cat K x x'))]
  (alpha : τ (Obj (Hom_cat (Hom_cat K x x') p q)))
  (u : τ (Obj (fapp0 E x)))
  : τ (Obj (Hom_cat (@sf_homd_section_cat K E x')
      (@sf_homd_id_src_sec K E x' (fapp0 (@fapp1_fapp0 K Cat_cat E x x' q) u))
      (@sf_homd_id_src_sec K E x' (fapp0 (@fapp1_fapp0 K Cat_cat E x x' p) u))))
≔
  @tapp0_fapp0 (fapp0 E x) (Op_cat (@sf_homd_section_cat K E x'))
    (fapp0 (@sf_homd_id_root_action K E x x') p)
    (fapp0 (@sf_homd_id_root_action K E x x') q) u
    (@fapp1_fapp0 (Hom_cat K x x')
      (Functor_cat (fapp0 E x) (Op_cat (@sf_homd_section_cat K E x')))
      (@sf_homd_id_root_action K E x x') p q alpha);

assert [K : Cat] (E : τ (Functor K Cat_cat)) [x x' : τ (Obj K)]
  [p q : τ (Obj (Hom_cat K x x'))]
  (alpha : τ (Obj (Hom_cat (Hom_cat K x x') p q)))
  (u : τ (Obj (fapp0 E x))) ⊢
  @sf_homd_root_alpha_at K E x x' p q alpha u
  ≡ @sf_homd_id_u_map K E x'
      (fapp0 (@fapp1_fapp0 K Cat_cat E x x' p) u)
      (fapp0 (@fapp1_fapp0 K Cat_cat E x x' q) u)
      (@tapp0_fapp0 (fapp0 E x) (fapp0 E x')
        (@fapp1_fapp0 K Cat_cat E x x' p) (@fapp1_fapp0 K Cat_cat E x x' q) u
        (@fapp1_fapp0 (Hom_cat K x x') (Functor_cat (fapp0 E x) (fapp0 E x'))
          (@fapp1_func K Cat_cat E x x') p q alpha));

assertnot [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K)) ⊢
  @tapp0_fapp0 K Cat_cat E (@sf_homd_target_catd K E) x (@sf_homd_id_int K E)
  : τ (Functor (fapp0 E x) (@sf_homd_section_cat K E x));

// A variable endomorphism alpha must not become an identity through root
// formation, even though the default ordinary functors are strict.
assertnot [K : Cat] (E : τ (Functor K Cat_cat)) [x x' : τ (Obj K)]
  (p : τ (Obj (Hom_cat K x x')))
  (alpha : τ (Obj (Hom_cat (Hom_cat K x x') p p)))
  (u : τ (Obj (fapp0 E x))) ⊢
  @eq_refl (Obj (Hom_cat (@sf_homd_section_cat K E x')
      (@sf_homd_id_src_sec K E x' (fapp0 (@fapp1_fapp0 K Cat_cat E x x' p) u))
      (@sf_homd_id_src_sec K E x' (fapp0 (@fapp1_fapp0 K Cat_cat E x x' p) u))))
    (@sf_homd_root_alpha_at K E x x' p p alpha u)
  : τ (@= (Obj (Hom_cat (@sf_homd_section_cat K E x')
        (@sf_homd_id_src_sec K E x' (fapp0 (@fapp1_fapp0 K Cat_cat E x x' p) u))
        (@sf_homd_id_src_sec K E x' (fapp0 (@fapp1_fapp0 K Cat_cat E x x' p) u))))
      (@sf_homd_root_alpha_at K E x x' p p alpha u)
      (@id (@sf_homd_section_cat K E x')
        (@sf_homd_id_src_sec K E x' (fapp0 (@fapp1_fapp0 K Cat_cat E x x' p) u))));
