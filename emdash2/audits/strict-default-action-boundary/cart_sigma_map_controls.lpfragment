// The root's first Hom is consumed on a general lax FF.
assert [K : Cat] [E D : τ (Functor K sf_cart_cat)]
  (FF : τ (@Transf K sf_cart_cat E D)) ⊢
  fapp0 (@fapp1_func _ _ (sf_cart_sigma_func K) E D) FF
  ≡ @sf_cart_sigma_map K E D FF;

assert [K : Cat] [E D : τ (Functor K sf_cart_cat)]
  (FF : τ (@Transf K sf_cart_cat E D))
  (x : τ (Obj K)) (u : τ (Obj (fapp0 E x))) ⊢
  fapp0 (@sf_cart_sigma_map K E D FF) (Struct_sigma x u)
  ≡ @Struct_sigma (Obj K) (λ k : τ (Obj K), Obj (fapp0 D k))
      x (fapp0 (@tapp0_fapp0 K sf_cart_cat E D x FF) u);

// Arbitrary endpoint projections use the same stable production architecture.
assert [K : Cat] [E D : τ (Functor K sf_cart_cat)]
  (FF : τ (@Transf K sf_cart_cat E D)) (s : τ (Obj (@sf_cart_sigma K E))) ⊢
  @sf_cart_sigma_obj_base K D (fapp0 (@sf_cart_sigma_map K E D FF) s)
  ≡ @sf_cart_sigma_obj_base K E s;

// The whole Hom computes to a derived negative total, then to its real filler.
assert [K : Cat] [E D : τ (Functor K sf_cart_cat)]
  (FF : τ (@Transf K sf_cart_cat E D)) [x y : τ (Obj K)]
  (u : τ (Obj (fapp0 E x))) (v : τ (Obj (fapp0 E y))) (p : τ (Hom K x y))
  (a : τ (Hom (fapp0 E y) (fapp0 (@fapp1_fapp0 K sf_cart_cat E x y p) u) v)) ⊢
  fapp0 (@fapp1_func _ _ (@sf_cart_sigma_map K E D FF) (Struct_sigma x u) (Struct_sigma y v))
    (Struct_sigma p a)
  ≡ @sf_cart_sigma_arrow K D x y
      (fapp0 (@tapp0_fapp0 K sf_cart_cat E D x FF) u)
      (fapp0 (@tapp0_fapp0 K sf_cart_cat E D y FF) v) p
      (@sf_cq_fdapp1_filler K E D FF x y p u v a);

assert [K : Cat] [E D : τ (Functor K sf_cart_cat)]
  (FF : τ (@Transf K sf_cart_cat E D)) [x y : τ (Obj K)]
  (u : τ (Obj (fapp0 E x))) (v : τ (Obj (fapp0 E y))) (p : τ (Hom K x y))
  (a : τ (Hom (fapp0 E y) (fapp0 (@fapp1_fapp0 K sf_cart_cat E x y p) u) v)) ⊢
  @fapp1_fapp0 _ _ (@sf_cart_sigma_map K E D FF) (Struct_sigma x u) (Struct_sigma y v)
    (Struct_sigma p a)
  ≡ @sf_cart_sigma_arrow K D x y
      (fapp0 (@tapp0_fapp0 K sf_cart_cat E D x FF) u)
      (fapp0 (@tapp0_fapp0 K sf_cart_cat E D y FF) v) p
      (@sf_cq_fdapp1_filler K E D FF x y p u v a);

// A mapped transport has the actual extracted laxity, not an identity filler.
assert [K : Cat] [E D : τ (Functor K sf_cart_cat)]
  (FF : τ (@Transf K sf_cart_cat E D)) [x y : τ (Obj K)]
  (p : τ (Hom K x y)) (u : τ (Obj (fapp0 E x))) ⊢
  @fapp1_fapp0 _ _ (@sf_cart_sigma_map K E D FF) (Struct_sigma x u)
    (Struct_sigma y (fapp0 (@fapp1_fapp0 K sf_cart_cat E x y p) u))
    (@sf_cart_sigma_transport K E x y p u)
  ≡ @sf_cart_sigma_arrow K D x y
      (fapp0 (@tapp0_fapp0 K sf_cart_cat E D x FF) u)
      (fapp0 (@tapp0_fapp0 K sf_cart_cat E D y FF)
        (fapp0 (@fapp1_fapp0 K sf_cart_cat E x y p) u)) p
      (@sf_cq_fdapp1_laxity K E D FF x y p u);

// The modification component is an actual forward fibre arrow.
assert [K : Cat] [E D : τ (Functor K sf_cart_cat)]
  [FF GG : τ (@Transf K sf_cart_cat E D)]
  (theta : τ (Hom (@Transf_cat K sf_cart_cat E D) FF GG))
  (x : τ (Obj K)) (u : τ (Obj (fapp0 E x))) ⊢
  @fapp1_fapp0 _ _ (@sf_cart_sigma_proj K D)
    (Struct_sigma x (fapp0 (@tapp0_fapp0 K sf_cart_cat E D x FF) u))
    (Struct_sigma x (fapp0 (@tapp0_fapp0 K sf_cart_cat E D x GG) u))
    (@tapp0_fapp0 _ _ _ _ (Struct_sigma x u)
      (@sf_cart_sigma_map_transf K E D FF GG theta))
  ≡ @id K x;

// The whole root and its projection-first identity agree.
assert [K : Cat] (E : τ (Functor K sf_cart_cat)) ⊢
  @sf_cart_sigma_map K E E (@id (Functor_cat K sf_cart_cat) E)
  ≡ @id_func (@sf_cart_sigma K E);
assert [K : Cat] (E : τ (Functor K sf_cart_cat))
  (x : τ (Obj K)) (u : τ (Obj (fapp0 E x)))
  (y : τ (Obj K)) (v : τ (Obj (fapp0 E y))) ⊢
  @sf_cart_sigma_map_hom K E E (@id (Functor_cat K sf_cart_cat) E) x u y v
  ≡ @id_func (Hom_cat (@sf_cart_sigma K E) (Struct_sigma x u) (Struct_sigma y v));

assert [K : Cat] [E M D : τ (Functor K sf_cart_cat)]
  (FF : τ (@Transf K sf_cart_cat E M)) (GG : τ (@Transf K sf_cart_cat M D)) ⊢
  @sf_cart_sigma_map K E D (@comp_fapp0 (Functor_cat K sf_cart_cat) E M D GG FF)
  ≡ @comp_cat_fapp0 (@sf_cart_sigma K E) (@sf_cart_sigma K M) (@sf_cart_sigma K D)
      (@sf_cart_sigma_map K M D GG) (@sf_cart_sigma_map K E M FF);

// Whole intrinsic Hom-action agreement for composite displayed maps.
// The reflexive consumer exercises unification rather than runtime expansion.
assert [K : Cat] [E M D : τ (Functor K sf_cart_cat)]
  (FF : τ (@Transf K sf_cart_cat E M)) (GG : τ (@Transf K sf_cart_cat M D))
  [x y : τ (Obj K)] (u : τ (Obj (fapp0 E x))) (v : τ (Obj (fapp0 E y)))
  (p : τ (Hom K x y)) ⊢
  @eq_refl (Functor _ _)
    (@sf_cq_tdapp1_hom K E D
      (@comp_fapp0 (Functor_cat K sf_cart_cat) E M D GG FF)
      (@comp_fapp0 (Functor_cat K sf_cart_cat) E M D GG FF)
      (@sf_cq_fdapp1_int K E D (@comp_fapp0 (Functor_cat K sf_cart_cat) E M D GG FF)) x u y v p)
  : τ (@= (Functor _ _)
      (@sf_cq_tdapp1_hom K E D
        (@comp_fapp0 (Functor_cat K sf_cart_cat) E M D GG FF)
        (@comp_fapp0 (Functor_cat K sf_cart_cat) E M D GG FF)
        (@sf_cq_fdapp1_int K E D (@comp_fapp0 (Functor_cat K sf_cart_cat) E M D GG FF)) x u y v p)
      (@comp_cat_fapp0 _ _ _
        (@sf_cq_tdapp1_hom K M D GG GG (@sf_cq_fdapp1_int K M D GG)
          x (fapp0 (@tapp0_fapp0 K sf_cart_cat E M x FF) u)
          y (fapp0 (@tapp0_fapp0 K sf_cart_cat E M y FF) v) p)
        (@sf_cq_tdapp1_hom K E M FF FF (@sf_cq_fdapp1_int K E M FF) x u y v p)));

// Lax base naturality is retained: the mapped transport ends at FF[y](E[p]u).
assertnot [K : Cat] [E D : τ (Functor K sf_cart_cat)]
  (FF : τ (@Transf K sf_cart_cat E D)) [x y : τ (Obj K)]
  (p : τ (Hom K x y)) (u : τ (Obj (fapp0 E x))) ⊢
  @fapp1_fapp0 _ _ (@sf_cart_sigma_map K E D FF) (Struct_sigma x u)
    (Struct_sigma y (fapp0 (@fapp1_fapp0 K sf_cart_cat E x y p) u))
    (@sf_cart_sigma_transport K E x y p u)
  : τ (Hom (@sf_cart_sigma K D)
      (Struct_sigma x (fapp0 (@tapp0_fapp0 K sf_cart_cat E D x FF) u))
      (Struct_sigma y (fapp0 (@fapp1_fapp0 K sf_cart_cat D x y p)
        (fapp0 (@tapp0_fapp0 K sf_cart_cat E D x FF) u))));

// Recursive action on a general total two-cell retains the actual base cell.
// Consume the derived Hom body directly, so the projection/map composition
// rule at the outer total functors cannot bypass this computation.
assert [K : Cat] [E D : τ (Functor K sf_cart_cat)]
  (FF : τ (@Transf K sf_cart_cat E D)) [x y : τ (Obj K)]
  (u : τ (Obj (fapp0 E x))) (v : τ (Obj (fapp0 E y)))
  [p q : τ (Hom K x y)]
  (a : τ (Obj (fapp0 (@sf_cq_homd_ K E x u y v) p)))
  (b : τ (Obj (fapp0 (@sf_cq_homd_ K E x u y v) q)))
  (kappa : τ (Hom (Hom_cat K x y) p q))
  (eta : τ (Hom (fapp0 (@sf_cq_homd_ K E x u y v) p) a
      (fapp0 (@fapp1_fapp0 (Op_cat (Hom_cat K x y)) sf_cart_cat
        (@sf_cq_homd_ K E x u y v) q p kappa) b))) ⊢
  @fapp1_fapp0 _ _
    (@fapp1_func _ _ (@sf_cart_sigma_proj K D)
      (Struct_sigma x (fapp0 (@tapp0_fapp0 K sf_cart_cat E D x FF) u))
      (Struct_sigma y (fapp0 (@tapp0_fapp0 K sf_cart_cat E D y FF) v)))
    (fapp0 (@sf_cart_sigma_map_hom K E D FF x u y v) (Struct_sigma p a))
    (fapp0 (@sf_cart_sigma_map_hom K E D FF x u y v) (Struct_sigma q b))
    (@fapp1_fapp0 _ _ (@sf_cart_sigma_map_hom K E D FF x u y v)
      (Struct_sigma p a) (Struct_sigma q b)
      (@sf_cart_sigma_two_cell K E x y u v p q a b kappa eta))
  ≡ kappa;

// Identity and composition are retained in the next parameter Hom as well.
assert [K : Cat] [E D : τ (Functor K sf_cart_cat)]
  (FF : τ (@Transf K sf_cart_cat E D)) ⊢
  @sf_cart_sigma_map_transf K E D FF FF (@id (@Transf_cat K sf_cart_cat E D) FF)
  ≡ @id (Functor_cat (@sf_cart_sigma K E) (@sf_cart_sigma K D)) (@sf_cart_sigma_map K E D FF);

assert [K : Cat] [E D : τ (Functor K sf_cart_cat)]
  [FF GG HH : τ (@Transf K sf_cart_cat E D)]
  (theta : τ (Hom (@Transf_cat K sf_cart_cat E D) FF GG))
  (eta : τ (Hom (@Transf_cat K sf_cart_cat E D) GG HH)) ⊢
  @sf_cart_sigma_map_transf K E D FF HH
    (@comp_fapp0 (@Transf_cat K sf_cart_cat E D) FF GG HH eta theta)
  ≡ @comp_fapp0 (Functor_cat (@sf_cart_sigma K E) (@sf_cart_sigma K D)) _ _ _
      (@sf_cart_sigma_map_transf K E D GG HH eta)
      (@sf_cart_sigma_map_transf K E D FF GG theta);

// Preserve an identity total arrow after expanding the derived Hom first.
assert [K : Cat] [E D : τ (Functor K sf_cart_cat)]
  (FF : τ (@Transf K sf_cart_cat E D)) (x : τ (Obj K)) (u : τ (Obj (fapp0 E x))) ⊢
  fapp0 (@sf_cart_sigma_map_hom K E D FF x u x u)
    (@id (@sf_cart_sigma K E) (Struct_sigma x u))
  ≡ @id (@sf_cart_sigma K D)
      (Struct_sigma x (fapp0 (@tapp0_fapp0 K sf_cart_cat E D x FF) u));
