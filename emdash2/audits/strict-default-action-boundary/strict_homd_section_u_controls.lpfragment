assert [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  (u : τ (Obj (fapp0 E x))) ⊢
  fapp0 (@sf_homd_id_src_func K E x) u ≡ @sf_homd_id_src_sec K E x u;

assert [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  [u0 u1 : τ (Obj (fapp0 E x))] (h : τ (Obj (Hom_cat (@fapp0 K Cat_cat E x) u0 u1))) ⊢
  @fapp0 (Hom_cat (@fapp0 K Cat_cat E x) u0 u1)
    (Hom_cat (@sf_homd_section_cat K E x)
      (@sf_homd_id_src_sec K E x u1) (@sf_homd_id_src_sec K E x u0))
    (@fapp1_func (Op_cat (@fapp0 K Cat_cat E x)) (@sf_homd_section_cat K E x)
      (@sf_homd_id_src_func K E x) u1 u0) h
  ≡ @fapp1_fapp0 (Op_cat (fapp0 E x)) (@sf_homd_section_cat K E x)
      (@sf_homd_id_src_func K E x) u1 u0 h;

assert [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  [u0 u1 : τ (Obj (fapp0 E x))] (h : τ (Obj (Hom_cat (@fapp0 K Cat_cat E x) u0 u1)))
  (y : τ (Obj K)) ⊢
  @tapp0_hom_fapp0 K sf_q_cat (@sf_q_diagram K E)
    (@sf_q_diagram K (@hom_ K K (@id_func K) x))
    (@sf_homd_id_src_sec K E x u1) (@sf_homd_id_src_sec K E x u0) y
    (@sf_homd_id_u_map K E x u0 u1 h)
  ≡ @sf_homd_id_u_y K E x u0 u1 h y;

assert [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  [u0 u1 : τ (Obj (fapp0 E x))] (h : τ (Obj (Hom_cat (@fapp0 K Cat_cat E x) u0 u1)))
  (y : τ (Obj K)) (v : τ (Obj (fapp0 E y))) (f : τ (Hom K x y)) ⊢
  @tapp0_fapp0 (Op_cat (Hom_cat K x y)) Cat_cat
    (@sf_homd_id_ K E x u1 y v) (@sf_homd_id_ K E x u0 y v) f
    (@tapp0_fapp0 (fapp0 E y) (Functor_cat (Op_cat (Hom_cat K x y)) Cat_cat)
      (@sf_homd_id_tgt_func K E x u1 y) (@sf_homd_id_tgt_func K E x u0 y) v
      (@sf_homd_id_u_y K E x u0 u1 h y))
  ≡ @hom_precomp_along_func (fapp0 E x) (fapp0 E y)
      (@fapp1_fapp0 K Cat_cat E x y f) v u0 u1 h;

// The inner u/index comparison is a default lax transformation, not an
// implicitly Cartesian one. This is the profile needed by the finite test.
assertnot [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  [u0 u1 : τ (Obj (fapp0 E x))] (h : τ (Obj (Hom_cat (@fapp0 K Cat_cat E x) u0 u1)))
  (y : τ (Obj K)) (v : τ (Obj (fapp0 E y))) ⊢
  @sf_homd_id_u_v K E x u0 u1 h y v
  : τ (@StrictTransfor (Op_cat (Hom_cat K x y)) Cat_cat
      (@sf_homd_id_ K E x u1 y v) (@sf_homd_id_ K E x u0 y v));

assert [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  (u : τ (Obj (fapp0 E x))) ⊢
  @sf_homd_id_u_map K E x u u (@id (fapp0 E x) u)
  ≡ @id (@sf_homd_section_cat K E x) (@sf_homd_id_src_sec K E x u);

assert [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  [u0 u1 u2 : τ (Obj (fapp0 E x))]
  (h : τ (Obj (Hom_cat (@fapp0 K Cat_cat E x) u0 u1))) (k : τ (Obj (Hom_cat (@fapp0 K Cat_cat E x) u1 u2))) ⊢
  @comp_fapp0 (@sf_homd_section_cat K E x)
    (@sf_homd_id_src_sec K E x u2) (@sf_homd_id_src_sec K E x u1) (@sf_homd_id_src_sec K E x u0)
    (@sf_homd_id_u_map K E x u0 u1 h) (@sf_homd_id_u_map K E x u1 u2 k)
  ≡ @sf_homd_id_u_map K E x u0 u2 (@comp_fapp0 (fapp0 E x) u0 u1 u2 k h);

assertnot [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  [u0 u1 : τ (Obj (fapp0 E x))] (h : τ (Obj (Hom_cat (@fapp0 K Cat_cat E x) u0 u1))) ⊢
  @sf_homd_id_u_map K E x u0 u1 h
  : τ (Hom (@sf_homd_section_cat K E x)
      (@sf_homd_id_src_sec K E x u0) (@sf_homd_id_src_sec K E x u1));

// Observe the source identity after the y/v projections have already fired.
assert [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  [u0 u1 u2 : τ (Obj (fapp0 E x))]
  (h : τ (Obj (Hom_cat (@fapp0 K Cat_cat E x) u0 u1)))
  (k : τ (Obj (Hom_cat (@fapp0 K Cat_cat E x) u1 u2))) (y : τ (Obj K)) ⊢
  @comp_fapp0 (Functor_cat (fapp0 E y) (Functor_cat (Op_cat (Hom_cat K x y)) Cat_cat))
    (@sf_homd_id_tgt_func K E x u2 y) (@sf_homd_id_tgt_func K E x u1 y) (@sf_homd_id_tgt_func K E x u0 y)
    (@sf_homd_id_u_y K E x u0 u1 h y) (@sf_homd_id_u_y K E x u1 u2 k y)
  ≡ @sf_homd_id_u_y K E x u0 u2 (@comp_fapp0 (fapp0 E x) u0 u1 u2 k h) y;

assert [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  (u : τ (Obj (fapp0 E x))) (y : τ (Obj K)) ⊢
  @sf_homd_id_u_y K E x u u (@id (fapp0 E x) u) y
  ≡ @id (Functor_cat (fapp0 E y) (Functor_cat (Op_cat (Hom_cat K x y)) Cat_cat))
      (@sf_homd_id_tgt_func K E x u y);

assert [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  (u : τ (Obj (fapp0 E x))) (y : τ (Obj K)) (v : τ (Obj (fapp0 E y))) ⊢
  @sf_homd_id_u_v K E x u u (@id (fapp0 E x) u) y v
  ≡ @id (Functor_cat (Op_cat (Hom_cat K x y)) Cat_cat) (@sf_homd_id_ K E x u y v);

assert [K : Cat] (E : τ (Functor K Cat_cat)) (x : τ (Obj K))
  [u0 u1 u2 : τ (Obj (fapp0 E x))]
  (h : τ (Obj (Hom_cat (@fapp0 K Cat_cat E x) u0 u1)))
  (k : τ (Obj (Hom_cat (@fapp0 K Cat_cat E x) u1 u2)))
  (y : τ (Obj K)) (v : τ (Obj (fapp0 E y))) ⊢
  @comp_fapp0 (Functor_cat (Op_cat (Hom_cat K x y)) Cat_cat)
    (@sf_homd_id_ K E x u2 y v) (@sf_homd_id_ K E x u1 y v) (@sf_homd_id_ K E x u0 y v)
    (@sf_homd_id_u_v K E x u0 u1 h y v) (@sf_homd_id_u_v K E x u1 u2 k y v)
  ≡ @sf_homd_id_u_v K E x u0 u2 (@comp_fapp0 (fapp0 E x) u0 u1 u2 k h) y v;
