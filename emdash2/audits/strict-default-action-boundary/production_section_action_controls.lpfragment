// The existing Pi now binds the total-dual Hom index and total-dual fibres.
assert [K : Cat] (E : τ (Catd K)) (s : τ (Obj (Pi_cat E)))
  (x y : τ (Obj K)) (p : τ (Hom K x y)) ⊢
  @piapp1_fapp0 K E s x y p
  ≡ @fdapp1_int_cell K (@Const_catd K Terminal_cat) E s x y p Terminal_obj;
assertnot [K : Cat] (E : τ (Catd K)) (s : τ (Obj (Pi_cat E))) (x y : τ (Obj K)) ⊢
  @piapp1_func K E s x y
  : τ (Obj (Pi_cat (@homd_ K E E (@id_funcd K E)
      x (@piapp0 K E s x) y (@piapp0 K E s y))));

// Independent expanded first-Hom totalization, not its capped arrow rule.
assert [K : Cat] (E : τ (Catd K)) (s : τ (Obj (Pi_cat E)))
  (x y : τ (Obj K)) (p : τ (Hom K x y)) ⊢
  fapp0 (@TotalOp_func (TotalOp_cat (Hom_cat K x y))
    (@Sigma_cat (TotalOp_cat (Hom_cat K x y))
      (@TotalOp_catd (Op_cat (Hom_cat K x y))
        (@homd_ K E E (@id_funcd K E) x (@piapp0 K E s x) y (@piapp0 K E s y))))
    (@section_total_func (TotalOp_cat (Hom_cat K x y))
      (@TotalOp_catd (Op_cat (Hom_cat K x y))
        (@homd_ K E E (@id_funcd K E) x (@piapp0 K E s x) y (@piapp0 K E s y)))
      (@piapp1_func K E s x y))) p
  ≡ @sigma_arrow K E x y (@piapp0 K E s x) (@piapp0 K E s y) p
      (@piapp1_fapp0 K E s x y p);

// The constant-index constructor has canonical endpoints and the actual
// positive-family image is the whole opposite of the original functor.
assert [I H : Cat] (F : τ (Functor I H)) ⊢
  @fapp1_fapp0 (CoAbove2_cat (Homd_index_cat I)) (Catd_cat (TotalOp_cat I))
    (Homd_index_total_family_func I)
    (@Op_func (Op_cat I) Cat_cart (@Const_catd (Op_cat I) Terminal_cat))
    (@Op_func (Op_cat I) Cat_cart (@Const_catd (Op_cat I) H))
    (fapp0 (Homd_index_const_func I H) F)
  ≡ @TotalOp_func I H F;

// This is an actual whole functor, not an arrow assembled at each p.
symbol section_check_const_hom [K B : Cat] (F : τ (Functor K B))
  (x y : τ (Obj K))
  : τ (Functor (Hom_cat K x y) (Hom_cat B (fapp0 F x) (fapp0 F y)))
≔ @TotalOp_func (TotalOp_cat (Hom_cat K x y))
    (TotalOp_cat (Hom_cat B (fapp0 F x) (fapp0 F y)))
    (@piapp1_func K (@Const_catd K B) F x y);
assert [K B : Cat] (F : τ (Functor K B)) (x y : τ (Obj K)) ⊢
  @section_check_const_hom K B F x y ≡ @fapp1_func K B F x y;
assert [K B : Cat] (F : τ (Functor K B)) (x y : τ (Obj K))
  (p q : τ (Hom K x y)) (alpha : τ (Hom (Hom_cat K x y) p q)) ⊢
  @fapp1_fapp0 (Hom_cat K x y) (Hom_cat B (fapp0 F x) (fapp0 F y))
    (@section_check_const_hom K B F x y) p q alpha
  ≡ @fapp1_fapp0 (Hom_cat K x y) (Hom_cat B (fapp0 F x) (fapp0 F y))
      (@fapp1_func K B F x y) p q alpha;

// The actual Sigma total's second-cell image independently recovers F[alpha].
assert [K B : Cat] (F : τ (Functor K B)) (x y : τ (Obj K))
  (p q : τ (Hom K x y)) (alpha : τ (Hom (Hom_cat K x y) p q)) ⊢
  sigma_Snd (@fapp1_fapp0 (Hom_cat K x y)
    (Hom_cat (Sigma_cat (@Const_catd K B)) (Struct_sigma x (fapp0 F x)) (Struct_sigma y (fapp0 F y)))
    (@fapp1_func K (Sigma_cat (@Const_catd K B)) (@section_total_func K (@Const_catd K B) F) x y)
    p q alpha)
  ≡ @fapp1_fapp0 (Hom_cat K x y) (Hom_cat B (fapp0 F x) (fapp0 F y))
      (@fapp1_func K B F x y) p q alpha;
assertnot [K : Cat] (x y : τ (Obj K)) (p : τ (Hom K x y))
  (alpha : τ (Hom (Hom_cat K x y) p p)) ⊢
  @fapp1_fapp0 (Hom_cat K x y) (Hom_cat K x y)
    (@section_check_const_hom K K (@id_func K) x y) p p alpha
  ≡ @id (Hom_cat K x y) p;

// Arbitrary epsilon follows the same native x/u -> y -> v -> f ladder.
// The first component is explicitly in T(S_E(x)); no coercion S_E=T(S_E).
symbol modification_check_section [K : Cat] [E D : τ (Catd K)]
  [FF GG : τ (Functord E D)] (epsilon : τ (Transfd FF GG))
  (x : τ (Obj K)) (u : τ (Obj (Fibre_cat E x)))
  : τ (Obj (Hom_cat (@Homd_target_section_cat K E x)
      (@homd_id_src_sec K E x u) (@homd_tdapp1_src_sec K E D FF GG x u)))
≔ @tapp0_fapp0 (Fibre_cat E x) (Op_cat (@Homd_target_section_cat K E x)) _ _ u
    (@strict_transfor (Fibre_cat E x) (Op_cat (@Homd_target_section_cat K E x)) _ _
      (tdapp0_fapp0 x (fapp0 (@tdapp1_int_func_transfd K E D FF GG) epsilon)));
assert [K : Cat] [E D : τ (Catd K)] [FF GG : τ (Functord E D)]
  (epsilon : τ (Transfd FF GG)) (x : τ (Obj K)) (u : τ (Obj (Fibre_cat E x))) ⊢
  @modification_check_section K E D FF GG epsilon x u
  ≡ @tdapp1_int_section_arrow K E D FF GG epsilon x u;

symbol modification_check_index [K : Cat] [E D : τ (Catd K)]
  [FF GG : τ (Functord E D)] (epsilon : τ (Transfd FF GG))
  (x : τ (Obj K)) (u : τ (Obj (Fibre_cat E x))) (y : τ (Obj K))
  (v : τ (Obj (Fibre_cat E y)))
  : τ (Obj (Hom_cat (Homd_index_cat (Hom_cat K x y))
      (fapp0 (@homd_id_tgt_func K E x u y) v)
      (fapp0 (@homd_tdapp1_tgt_func K E D FF GG x u y) v)))
≔ tapp0_fapp0 v (strict_transfor
    (@tapp0_hom_fapp0 K Homd_coeff_cat (@Homd_coeff_diagram K E)
      (@Homd_coeff_diagram K (@hom_ K K (@id_func K) x))
      (@homd_id_src_sec K E x u) (@homd_tdapp1_src_sec K E D FF GG x u) y
      (@modification_check_section K E D FF GG epsilon x u)));
assert [K : Cat] [E D : τ (Catd K)] [FF GG : τ (Functord E D)]
  (epsilon : τ (Transfd FF GG)) (x y : τ (Obj K)) (u : τ (Obj (Fibre_cat E x)))
  (p : τ (Hom K x y)) ⊢
  fapp0 (@tapp0_fapp0 (Hom_cat K x y) (Op_cat Cat_cart)
    (fapp0 (@homd_tdapp1_tgt_func K E D FF GG x u y)
      (fapp0 (@catd_transport_func K E x y p) u))
    (fapp0 (@homd_id_tgt_func K E x u y)
      (fapp0 (@catd_transport_func K E x y p) u)) p
    (@modification_check_index K E D FF GG epsilon x u y
      (fapp0 (@catd_transport_func K E x y p) u)))
    (@id (Fibre_cat E y) (fapp0 (@catd_transport_func K E x y p) u))
  ≡ @tdapp1_int_cell K E D FF GG epsilon x y p u;
assertnot [K : Cat] [E D : τ (Catd K)] (FF : τ (Functord E D))
  (epsilon : τ (Transfd FF FF)) (x y : τ (Obj K)) (p : τ (Hom K x y))
  (u : τ (Obj (Fibre_cat E x))) ⊢
  @tdapp1_int_cell K E D FF FF epsilon x y p u ≡ @fdapp1_int_cell K E D FF x y p u;

// The fixed-postwhiskering laws do not erase a nonidentity second leg.
assertnot [I A B : Cat] (F G : τ (Functor I A)) (H : τ (Functor A B))
  (epsilon : τ (Transf F G)) (eta : τ (Transf H H)) ⊢
  @comp_prod_fapp1_fapp0 Cat_cat I A B
    (Struct_sigma F H) (Struct_sigma G H) (Struct_sigma epsilon eta)
  ≡ @comp_prod_fapp1_fapp0 Cat_cat I A B
      (Struct_sigma F H) (Struct_sigma G H)
      (Struct_sigma epsilon (@id (Functor_cat A B) H));

// Constant-family normalization preserves the pre-existing whole Hom views.
assert [K : Cat] (A W : Cat) ⊢
  @hom_ Cat_cart K (@Const_func K Cat_cart A) W
  ≡ @Const_catd K (Hom_cat Cat_cart W A);
assert [K : Cat] (A W : Cat) ⊢
  @hom_con Cat_cart W K (@Const_func K Cat_cart A)
  ≡ @Const_catd (Op_cat K) (Hom_cat Cat_cart A W);
assert [K : Cat] (A : Cat) ⊢
  @CoAbove2_func K Cat_cart (@Const_catd K A)
  ≡ @Const_func (CoAbove2_cat K) (CoAbove2_cat Cat_cart) A;
assert ⊢ @TotalOp_catd Cat_cart (@id_func Cat_cart) ≡ total_op_cart;
assert ⊢ @TotalOp_catd Cat_cart
    (@TotalOp_catd (CoAbove2_cat Cat_cart) total_op_cart) ≡ total_op_cart;
