// NON-LIBRARY: actual existing Op_catd owner, with its corrected whole base.
symbol sf_op_family_formation (K : Cat)
  : τ (Functor (CoAt2_cat (Functor_cart_cat K Cat_cat)) (Catd_cat (CoAt2_cat K)))
≔ @comp_cat_fapp0
    (CoAt2_cat (Functor_cart_cat K Cat_cat))
    (Functor_cat (CoAt2_cat K) (CoAt2_cat Cat_cat))
    (Catd_cat (CoAt2_cat K))
    (@fapp1_fapp0 Cat_cat Cat_cat
      (Functor_cat_fapp0_func (CoAt2_cat K)) (CoAt2_cat Cat_cat) Cat_cat op)
    (@comp_cat_fapp0
      (CoAt2_cat (Functor_cart_cat K Cat_cat))
      (Functor_cart_cat (CoAt2_cat K) (CoAt2_cat Cat_cat))
      (Functor_cat (CoAt2_cat K) (CoAt2_cat Cat_cat))
      (cart_functor_include (CoAt2_cat K) (CoAt2_cat Cat_cat))
      (CoAt2_func_func K Cat_cat));
assert (K : Cat) ⊢ sf_op_family_formation K ≡ Op_catd_func K;
assert [K : Cat] (E : τ (Catd K)) ⊢
  @fapp0 (CoAt2_cat (Functor_cart_cat K Cat_cat)) (Catd_cat (CoAt2_cat K))
    (Op_catd_func K) E ≡ @Op_catd K E;

assert [K : Cat] (E : τ (Catd K)) ⊢
  @Op_catd K E : τ (Catd (CoAt2_cat K));
assertnot [K : Cat] (E : τ (Catd K)) ⊢
  @Op_catd K E : τ (Catd K);
assert [K : Cat] (E : τ (Catd K)) ⊢
  @comp_cat_fapp0 (CoAt2_cat K) (CoAt2_cat Cat_cat) Cat_cat
    op (@CoAt2_func K Cat_cat E)
  ≡ @Op_catd K E;
assert [K : Cat] (E : τ (Catd K)) (x : τ (Obj K)) ⊢
  @fapp0 (CoAt2_cat K) Cat_cat (@Op_catd K E) x
  ≡ Op_cat (@fapp0 K Cat_cat E x);
assert [K : Cat] (E : τ (Catd K)) [x y : τ (Obj K)]
  (p : τ (Hom K x y)) ⊢
  @fapp1_fapp0 (CoAt2_cat K) Cat_cat (@Op_catd K E) x y p
  ≡ @Op_func _ _ (@fapp1_fapp0 K Cat_cat E x y p);
assert [K : Cat] (E : τ (Catd K)) ⊢
  @Op_catd (CoAt2_cat K) (@Op_catd K E) ≡ E;
assert [K A : Cat] ⊢
  @Op_catd K (@Const_catd K A)
  ≡ @Const_catd (CoAt2_cat K) (Op_cat A);

// A nonidentity base 2-cell is consumed in the reversed C2 direction and
// mapped to the correctly directed strict transformation of fibre transports.
assert [K : Cat] (E : τ (Catd K)) [x y : τ (Obj K)]
  [p q : τ (Hom K x y)] (alpha : τ (Hom (Hom_cat K x y) p q)) ⊢
  @fapp1_fapp0
    (Hom_cat (CoAt2_cat K) x y)
    (Functor_cart_cat (Op_cat (@fapp0 K Cat_cat E x)) (Op_cat (@fapp0 K Cat_cat E y)))
    (@fapp1_func (CoAt2_cat K) Cat_cat (@Op_catd K E) x y)
    q p alpha
  : τ (@StrictTransfor
      (Op_cat (@fapp0 K Cat_cat E x)) (Op_cat (@fapp0 K Cat_cat E y))
      (@Op_func _ _ (@fapp1_fapp0 K Cat_cat E x y q))
      (@Op_func _ _ (@fapp1_fapp0 K Cat_cat E x y p)));

// The whole formation has its stated Cartesian parameter profile. This
// does not silently identify arbitrary displayed FF with a strict transfor.
assert [K : Cat] [E D : τ (Catd K)]
  (U : τ (@StrictTransfor K Cat_cat E D)) ⊢
  @fapp1_fapp0 (CoAt2_cat (Functor_cart_cat K Cat_cat)) (Catd_cat (CoAt2_cat K))
    (Op_catd_func K) E D U
  : τ (Hom (Catd_cat (CoAt2_cat K)) (@Op_catd K E) (@Op_catd K D));
assertnot [K : Cat] [E D : τ (Catd K)] (FF : τ (Functord E D)) ⊢
  @fapp1_fapp0 (CoAt2_cat (Functor_cart_cat K Cat_cat)) (Catd_cat (CoAt2_cat K))
    (Op_catd_func K) E D FF
  : τ (Hom (Catd_cat (CoAt2_cat K)) (@Op_catd K E) (@Op_catd K D));
