  "sourceControls": {
    "central_public_homd_terminal_obligations.lp": "// Unqualified required normalization obligations; not a passing target.\nrequire open emdash.emdash3_2;\nassert [K : Cat] (x : \u03c4 (Obj K)) \u22a2\n  @homd_src_func K\n    (@Const_catd K Terminal_cat)\n    (@Const_catd K Terminal_cat)\n    (@id_funcd K (@Const_catd K Terminal_cat))\n    x\n    \u2261 @Obj_func\n        (Op_cat (@Homd_target_section_cat K (@Const_catd K Terminal_cat) x))\n        (@homd_src_sec K\n          (@Const_catd K Terminal_cat)\n          (@Const_catd K Terminal_cat)\n          (@id_funcd K (@Const_catd K Terminal_cat))\n          x\n          Terminal_obj);\n\nassert [K : Cat] (x : \u03c4 (Obj K)) \u22a2\n  @Fibre_func\n    K\n    (@Const_catd K Terminal_cat)\n    (@Homd_target_catd K (@Const_catd K Terminal_cat))\n    (@homd_int\n      K\n      (@Const_catd K Terminal_cat)\n      (@Const_catd K Terminal_cat)\n      (@id_funcd K (@Const_catd K Terminal_cat)))\n    x\n    \u2261 @Obj_func\n        (Op_cat (@Homd_target_section_cat K (@Const_catd K Terminal_cat) x))\n        (@homd_src_sec K\n          (@Const_catd K Terminal_cat)\n          (@Const_catd K Terminal_cat)\n          (@id_funcd K (@Const_catd K Terminal_cat))\n          x\n          Terminal_obj);\n\nassert [K : Cat] (x y : \u03c4 (Obj K)) \u22a2\n  @homd_tgt_func K\n    (@Const_catd K Terminal_cat)\n    (@Const_catd K Terminal_cat)\n    (@id_funcd K (@Const_catd K Terminal_cat))\n    x\n    Terminal_obj\n    y\n    \u2261 @Obj_func (Homd_index_cat (Hom_cat K x y))\n        (fapp0 (Homd_index_include_func (Hom_cat K x y)) (@Terminal_catd (Op_cat (Hom_cat K x y))));\n\nassert [K : Cat] (E : \u03c4 (Catd K)) (s : \u03c4 (Obj (Pi_cat E)))\n  (x y : \u03c4 (Obj K))\n  (u : \u03c4 (Obj (Fibre_cat E x))) \u22a2\n  @homd_tgt_func K (@Const_catd K Terminal_cat) E s x u y\n    \u2261 @Obj_func (Homd_index_cat (Hom_cat K x y))\n        (fapp0 (Homd_index_include_func (Hom_cat K x y)) (@homd_\n          K\n          E\n          E\n          (@id_funcd K E)\n          x\n          u\n          y\n          (@piapp0 K E s y)));\n\nassert [K : Cat] (E : \u03c4 (Catd K)) (s : \u03c4 (Obj (Pi_cat E)))\n  (x y : \u03c4 (Obj K))\n  (u : \u03c4 (Obj (Fibre_cat E x))) \u22a2\n  @tapp0_fapp0 K Homd_coeff_cat (@Homd_coeff_diagram K (@Const_catd K Terminal_cat))\n      (@Homd_coeff_diagram K (@hom_ K K (@id_func K) x)) y\n      (@homd_src_sec K (@Const_catd K Terminal_cat) E s x u)\n    \u2261 @Obj_func (Homd_index_cat (Hom_cat K x y))\n        (fapp0 (Homd_index_include_func (Hom_cat K x y)) (@homd_\n          K\n          E\n          E\n          (@id_funcd K E)\n          x\n          u\n          y\n          (@piapp0 K E s y)));\n",
    "terminal_homd_higher_projection.lp": "require open emdash.emdash3_2;\n\nprotected symbol thp_index (K : Cat) (x y : \u03c4 (Obj K)) : Cat\n \u2254 Homd_index_cat (Hom_cat K x y);\nprotected symbol thp_value (K : Cat) (x y : \u03c4 (Obj K))\n : \u03c4 (Obj (thp_index K x y))\n \u2254 fapp0 (Homd_index_include_func (Hom_cat K x y))\n     (@Terminal_catd (Op_cat (Hom_cat K x y)));\nprotected symbol thp_native (K : Cat) (x y : \u03c4 (Obj K))\n (v w : \u03c4 (Obj Terminal_cat))\n : \u03c4 (Functor Terminal_cat (Hom_cat (thp_index K x y) (thp_value K x y) (thp_value K x y)))\n \u2254 @fapp1_func Terminal_cat (thp_index K x y)\n     (@homd_id_tgt_func K (@Const_catd K Terminal_cat) x Terminal_obj y) v w;\nprotected symbol thp_body (K : Cat) (x y : \u03c4 (Obj K))\n (v w : \u03c4 (Obj Terminal_cat))\n : \u03c4 (Functor Terminal_cat (Hom_cat (thp_index K x y) (thp_value K x y) (thp_value K x y)))\n \u2254 @fapp1_func Terminal_cat (thp_index K x y)\n     (@Homd_coeff_conjoint Terminal_cat (Hom_cat K x y)\n       (@fib_cov_tapp0_func K (@Const_catd K Terminal_cat) x y Terminal_obj)) v w;\ncompute \u03bb (K:Cat) (x y:\u03c4 (Obj K)) (v w:\u03c4 (Obj Terminal_cat)), thp_native K x y v w;\ncompute \u03bb (K:Cat) (x y:\u03c4 (Obj K)) (v w:\u03c4 (Obj Terminal_cat)), thp_body K x y v w;\nassert [K:Cat] (x y:\u03c4 (Obj K)) (v w:\u03c4 (Obj Terminal_cat)) \u22a2\n thp_native K x y v w \u2261 thp_body K x y v w;\n",
    "terminal_representable_identity.lp": "require open emdash.emdash3_2;\n\n// Closed terminal-base specialization of the existing represented identity law.\nassert \u22a2\n @fapp1_fapp0 (CoAt2_cat Terminal_cat) (Functor_cat Terminal_cat Homd_coeff_cat)\n   (Homd_representable_func Terminal_cat) Terminal_obj Terminal_obj\n   (@id Terminal_cat Terminal_obj)\n \u2261 @id (Functor_cat Terminal_cat Homd_coeff_cat)\n   (@Homd_coeff_diagram Terminal_cat\n     (@hom_ Terminal_cat Terminal_cat (@id_func Terminal_cat) Terminal_obj));\n"
