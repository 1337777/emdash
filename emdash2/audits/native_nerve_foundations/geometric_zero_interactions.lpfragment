require open emdash.native_reverse_closure_objects;

// Stage the raw-view composition law before substituting functor images.
symbol nerve_profile_raw_comp_path [A B : Cat] [F G H : τ (Functor A B)]
  (L : τ (@LaxTransfor A B F G)) (M : τ (@LaxTransfor A B G H))
  : τ (@= (@Transf A B F H)
      (@lax_transfor A B F H (@comp_fapp0 (GrayHom_lax A B) F G H M L))
      (@comp_fapp0 (Functor_cat A B) F G H (@lax_transfor A B G H M) (@lax_transfor A B F G L)))
≔ @eq_refl _ _;

// Typed join for the inherited raw-profile composition overlap. The proof
// maps the original strict-functor law through the existing raw view.
symbol nerve_profile_image_composition_path [X A B : Cat]
  (F : τ (Functor X (GrayHom_lax A B))) [x y z : τ (Obj X)]
  (f : τ (Hom X x y)) (g : τ (Hom X y z))
  : τ (@= (@Transf A B (fapp0 F x) (fapp0 F z))
      (@comp_fapp0 (Functor_cat A B) (fapp0 F x) (fapp0 F y) (fapp0 F z)
        (@lax_transfor A B (fapp0 F y) (fapp0 F z) (@fapp1_fapp0 X (GrayHom_lax A B) F y z g))
        (@lax_transfor A B (fapp0 F x) (fapp0 F y) (@fapp1_fapp0 X (GrayHom_lax A B) F x y f)))
      (@lax_transfor A B (fapp0 F x) (fapp0 F z)
        (@fapp1_fapp0 X (GrayHom_lax A B) F x z (@comp_fapp0 X x y z g f))))
≔ @eq_trans _ _ _ _
    (@eq_sym _ _ _ (@nerve_profile_raw_comp_path A B (fapp0 F x) (fapp0 F y) (fapp0 F z)
      (@fapp1_fapp0 X (GrayHom_lax A B) F x y f) (@fapp1_fapp0 X (GrayHom_lax A B) F y z g)))
    (@eq_ap (Hom (GrayHom_lax A B) (fapp0 F x) (fapp0 F z))
    (@Transf A B (fapp0 F x) (fapp0 F z))
    (λ h : τ (Hom (GrayHom_lax A B) (fapp0 F x) (fapp0 F z)),
      @lax_transfor A B (fapp0 F x) (fapp0 F z) h)
    _ _ (@eq_refl _ (@comp_fapp0 (GrayHom_lax A B) (fapp0 F x) (fapp0 F y) (fapp0 F z)
      (@fapp1_fapp0 X (GrayHom_lax A B) F y z g)
      (@fapp1_fapp0 X (GrayHom_lax A B) F x y f))));
