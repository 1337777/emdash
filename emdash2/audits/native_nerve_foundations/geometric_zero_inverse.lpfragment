require open emdash.native_constant_precomposition;

// Dualize the proved contraction instead of identifying OddDual(1) with 1.
symbol nerve_odd_terminal_contraction
  : τ (@= (Functor (OddDual_cat Terminal_cat) (OddDual_cat Terminal_cat))
      (@Const_func (OddDual_cat Terminal_cat) (OddDual_cat Terminal_cat) Terminal_obj)
      (@id_func (OddDual_cat Terminal_cat)))
≔ @eq_ap (Functor Terminal_cat Terminal_cat)
    (Functor (OddDual_cat Terminal_cat) (OddDual_cat Terminal_cat))
    (λ H : τ (Functor Terminal_cat Terminal_cat), @OddDual_func Terminal_cat Terminal_cat H)
    _ _ nerve_terminal_contraction;

// The same whole reconstruction theorem on the encoded terminal source.
symbol nerve_odd_terminal_mapping_eta (C : Cat)
  : τ (@= (Functor (Functor_cat (OddDual_cat Terminal_cat) C)
                     (Functor_cat (OddDual_cat Terminal_cat) C))
      (@comp_cat_fapp0 (Functor_cat (OddDual_cat Terminal_cat) C) C
        (Functor_cat (OddDual_cat Terminal_cat) C)
        (@comp_cat_fapp0 C (Functor_cart_cat (OddDual_cat Terminal_cat) C)
          (Functor_cat (OddDual_cat Terminal_cat) C)
          (Functor_cart_include (OddDual_cat Terminal_cat) C)
          (@Const_func_func (OddDual_cat Terminal_cat) C))
        (@fapp0_func (OddDual_cat Terminal_cat) C Terminal_obj))
      (@id_func (Functor_cat (OddDual_cat Terminal_cat) C)))
≔ @eq_trans _ _ _ _
    (@eq_sym _ _ _ (@nerve_constant_precomposition (OddDual_cat Terminal_cat)
      (OddDual_cat Terminal_cat) C Terminal_obj))
    (@eq_ap (Functor (OddDual_cat Terminal_cat) (OddDual_cat Terminal_cat))
      (Functor (Functor_cat (OddDual_cat Terminal_cat) C) (Functor_cat (OddDual_cat Terminal_cat) C))
      (λ H : τ (Functor (OddDual_cat Terminal_cat) (OddDual_cat Terminal_cat)),
        @comp_cat_con_func (OddDual_cat Terminal_cat) (OddDual_cat Terminal_cat) C H)
      _ _ nerve_odd_terminal_contraction);

// Derived reverse zero round trip, for the already selected encoder/decoder.
symbol nerve_geometric_zero_encode_decode (C : Cat)
  : τ (@= (Functor (nerve_geometric_zero_cat C) (nerve_geometric_zero_cat C))
    (@comp_cat_fapp0 (nerve_geometric_zero_cat C) C (nerve_geometric_zero_cat C)
      (nerve_geometric_zero_encode C) (nerve_geometric_zero_decode C))
    (@id_func (nerve_geometric_zero_cat C)))
≔ @eq_trans _ _ _ _
    (@eq_sym _ _ _ (@nerve_odd_comp_path _ _ _
      (@fapp0_func (OddDual_cat Terminal_cat) (OddDual_cat C) Terminal_obj)
      (@comp_cat_fapp0 (OddDual_cat C)
        (Functor_cart_cat (OddDual_cat Terminal_cat) (OddDual_cat C))
        (Functor_cat (OddDual_cat Terminal_cat) (OddDual_cat C))
        (Functor_cart_include (OddDual_cat Terminal_cat) (OddDual_cat C))
        (@Const_func_func (OddDual_cat Terminal_cat) (OddDual_cat C)))))
    (@eq_ap
      (Functor (Functor_cat (OddDual_cat Terminal_cat) (OddDual_cat C))
        (Functor_cat (OddDual_cat Terminal_cat) (OddDual_cat C)))
      (Functor (nerve_geometric_zero_cat C) (nerve_geometric_zero_cat C))
      (λ H : τ (Functor (Functor_cat (OddDual_cat Terminal_cat) (OddDual_cat C))
        (Functor_cat (OddDual_cat Terminal_cat) (OddDual_cat C))), @OddDual_func _ _ H)
      _ _ (nerve_odd_terminal_mapping_eta (OddDual_cat C)));

symbol nerve_geometric_zero_equivalence (C : Cat)
  : τ (@OmegaEquivAlong Cat_cat (nerve_geometric_zero_cat C) C (nerve_geometric_zero_decode C))
≔ @omega_equiv_along_intro Cat_cat (nerve_geometric_zero_cat C) C (nerve_geometric_zero_decode C)
    (nerve_geometric_zero_encode C) (nerve_geometric_zero_encode C)
    (nerve_geometric_zero_encode_decode C) (nerve_geometric_zero_decode_encode C);
