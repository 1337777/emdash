// Constructor beta for represented postcomposition by a vertical Sigma map.
// The actual inclusion head determines K/E/y; retain the incoming pair.
rule @hom_postcomp_fapp0 _ _ (@sigma_intro_tapp0_func $K $E $y)
      (Struct_sigma $x $u) $v $w $h (Struct_sigma $p $alpha)
  ↪ @sigma_arrow $K $E $x $y $u $w $p
      (@comp_fapp0 (@Fibre_cat $K $E $y) _ $v $w $h $alpha);

// Same constructor after a strict functor into the fibre. The composite's
// inferred categories are open; A is recoverable from the composite source.
rule @hom_postcomp_fapp0 _ _
      (@comp_fapp0 Cat_cat $A _ _ (@sigma_intro_tapp0_func $K $E $y) $F)
      (Struct_sigma $x $u) $v $w $h (Struct_sigma $p $alpha)
  ↪ @sigma_arrow $K $E $x $y $u (@fapp0 $A (@Fibre_cat $K $E $y) $F $w) $p
      (@comp_fapp0 (@Fibre_cat $K $E $y) _ _ _
        (@fapp1_fapp0 $A (@Fibre_cat $K $E $y) $F $v $w $h) $alpha);
