// Evaluating the whole postcomposition Hom action is precomposition.
// Runtime keeps the two presentations; comparison retains every original cell.
unif_rule @comp_fapp0 Cat_cat _ _ _
    (@comp_fapp0 Cat_cat _ _ _
      (@tapp0_func $H0 $H1 $P0 $P1 $u)
      (@fapp1_func _ _ (Functor_cart_include $H0 $H1) $P0 $P1))
    (@hom_postcomp_tele_fapp1_func $C $C (@id Cat_cat $C) $W $X $Y $f $g)
  ≡ @hom_precomp_along_fapp1_func $C0 $C0 (@id Cat_cat $C0) $Y0 $W0 $X0 $u0 $f0 $g0
  ↪ [ $C0 ≡ $C; $Y0 ≡ $Y; $W0 ≡ $W; $X0 ≡ $X;
      $u0 ≡ $u; $f0 ≡ $f; $g0 ≡ $g;
      $H0 ≡ Hom_cat $C $W $X; $H1 ≡ Hom_cat $C $W $Y;
      $P0 ≡ @hom_postcomp_func $C $C (@id Cat_cat $C) $W $X $Y $f;
      $P1 ≡ @hom_postcomp_func $C $C (@id Cat_cat $C) $W $X $Y $g ];

// Identity-input component-first projection of the same whole comparison.
// Generic Hom projection has split the composition; the original Gamma
// and both fillers remain explicit, and the incoming arrow is an identity.
unif_rule @tapp0_hom_fapp0 _ _ _ _ _ _ (@id $C $X)
    (@fapp1_fapp0 _ _
      (@fapp1_func _ _ (Functor_cart_include $H0 $H1) $P0 $P1) $U $V
      (@fapp1_fapp0 _ _
        (@hom_postcomp_tele_fapp1_func $C $C (@id Cat_cat $C) $W $X $Y $f $g)
        $alpha $beta $Gamma))
  ≡ @fapp1_fapp0 _ _
      (@hom_precomp_along_fapp1_func $C0 $C0 (@id Cat_cat $C0) $Y0 $W0 $X0 $u0 $f0 $g0)
      $alpha0 $beta0 $Gamma0
  ↪ [ $C0 ≡ $C; $Y0 ≡ $Y; $W0 ≡ $W; $X0 ≡ $X;
      $W ≡ $X; $u0 ≡ @id $C $X; $f0 ≡ $f; $g0 ≡ $g;
      $alpha0 ≡ $alpha; $beta0 ≡ $beta; $Gamma0 ≡ $Gamma;
      $H0 ≡ Hom_cat $C $W $X; $H1 ≡ Hom_cat $C $W $Y;
      $P0 ≡ @hom_postcomp_func $C $C (@id Cat_cat $C) $W $X $Y $f;
      $P1 ≡ @hom_postcomp_func $C $C (@id Cat_cat $C) $W $X $Y $g;
      $U ≡ @hom_postcomp_tele_fapp1_fapp0 $C $C (@id Cat_cat $C) $W $X $Y $f $g $alpha;
      $V ≡ @hom_postcomp_tele_fapp1_fapp0 $C $C (@id Cat_cat $C) $W $X $Y $f $g $beta ];
