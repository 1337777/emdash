// Normality at an identity base arrow, for the existing intrinsic displayed
// action. This does not strictify the comparison at a nonidentity p.
// Whole Hom, capped arrow and transported-identity views share one unit.
rule @fdapp1_int_cell $K $E $D $FF $x $x (@id $K $x) $u
  ↪ @id (@Fibre_cat $K $D $x)
      (@fapp0 (@Fibre_cat $K $E $x) (@Fibre_cat $K $D $x) (@Fibre_func $K $E $D $FF $x) $u);
rule @fdapp1_int_hom_func $K $E $D $FF $x $x (@id $K $x) $u $v
  ↪ @fapp1_func (@Fibre_cat $K $E $x) (@Fibre_cat $K $D $x)
      (@Fibre_func $K $E $D $FF $x) $u $v;
rule @fdapp1_int_hom_fapp0 $K $E $D $FF $x $x (@id $K $x) $u $v $a
  ↪ @fapp1_fapp0 (@Fibre_cat $K $E $x) (@Fibre_cat $K $D $x)
      (@Fibre_func $K $E $D $FF $x) $u $v $a;
