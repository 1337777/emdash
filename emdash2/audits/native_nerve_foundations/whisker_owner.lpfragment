// Whole mixed postcomposition: the outer arrow is the actual image G[p].
// These are proof-time readings; represented runtime cuts remain unchanged.
unif_rule @comp_fapp0 Cat_cat _ _ _
    (@hom_postcomp_func $B $A $G $W $Y $Z $p)
    (@hom_postcomp_func $B $B (@id Cat_cat $B) $W $X $GY $u)
  ≡ @hom_postcomp_func $B0 $B0 (@id Cat_cat $B0) $W0 $X0 $GZ $image
  ↪ [ $B0 ≡ $B; $W0 ≡ $W; $X0 ≡ $X;
      $GY ≡ @fapp0 $A $B $G $Y; $GZ ≡ @fapp0 $A $B $G $Z;
      $image ≡ @hom_postcomp_fapp0 $B $A $G $X $Y $Z $p $u ];

// Strict source-map compatibility of the whole precomposed Hom action.
// The composite keeps p, v and F as data; no naturality cell is erased.
unif_rule @comp_fapp0 Cat_cat _ _ _
    (@hom_postcomp_func $B $B (@id Cat_cat $B) $FX $FY $T
      (@hom_precomp_along_fapp0 $A $B $F $T $Y $Z $p $v))
    (@fapp1_func $A $B $F $X $Y)
  ≡ @comp_fapp0 Cat_cat _ _ _
      (@comp_fapp0 Cat_cat _ _ _
        (@hom_postcomp_func $B0 $B0 (@id Cat_cat $B0) $FX0 $FZ0 $T0 $v0)
        (@fapp1_func $A0 $B0 $F0 $X0 $Z0))
      (@hom_postcomp_func $A0 $A0 (@id Cat_cat $A0) $X0 $Y0 $Z0 $p0)
  ↪ [ $A0 ≡ $A; $B0 ≡ $B; $F0 ≡ $F;
      $X0 ≡ $X; $Y0 ≡ $Y; $Z0 ≡ $Z; $p0 ≡ $p; $v0 ≡ $v; $T0 ≡ $T;
      $FX ≡ @fapp0 $A $B $F $X; $FY ≡ @fapp0 $A $B $F $Y;
      $FX0 ≡ @fapp0 $A $B $F $X; $FZ0 ≡ @fapp0 $A $B $F $Z ];
