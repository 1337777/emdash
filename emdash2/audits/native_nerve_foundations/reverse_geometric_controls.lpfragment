require open emdash.native_reverse_geometric_maps;

// The explicit profile adapter preserves ordinary transformations and their
// next cells. It does not promote an arbitrary transformation to strictness.
assert [A B : Cat] (F G : τ (Functor A B)) (e : τ (@Transf A B F G)) ⊢
  @lax_transfor A B F G (@fapp1_fapp0 _ _ (nerve_lax_profile_admit_func A B) F G e) ≡ e;
assert [A B : Cat] (F G : τ (Functor A B))
  (e d : τ (@Transf A B F G)) (m : τ (Hom (@Transf_cat A B F G) e d)) ⊢
  @fapp1_fapp0 _ _ (@nerve_lax_profile_hom_func A B F G) e d m ≡ m;
assertnot [A B : Cat] (F G : τ (Functor A B)) (e : τ (@Transf A B F G)) ⊢
  @lax_transfor A B F G (@fapp1_fapp0 _ _ (nerve_lax_profile_admit_func A B) F G e)
  : τ (@StrictTransfor A B F G);

// Fixed D evaluation of the new whole postcomposition interface.
symbol nerve_postcomposition_whole_evaluation [K A B : Cat] (D : τ (Functor K A))
  : τ (@= (Functor (Functor_cat A B) (Functor_cat K B))
    (@comp_cat_fapp0 (Functor_cat A B)
      (Functor_cat (Functor_cat K A) (Functor_cat K B)) (Functor_cat K B)
      (@fapp0_func (Functor_cat K A) (Functor_cat K B) D)
      (nerve_lax_postcomposition_func K A B))
    (@comp_cat_con_func K A B D))
≔ @eq_refl _ _;

// Mixed exchange must recover the actual whole parameter family at i.
symbol nerve_mixed_exchange_component_path [K I C : Cat]
  (D : τ (Functor K (Functor_oplax_cat I C))) (i : τ (Obj I))
  : τ (@= (Functor K C)
    (fapp0 (@diagram_oplax_evaluation_at_func I (Functor_cat K C) i)
      (fapp0 (nerve_mixed_exchange_func K I C) D))
    (@diagram_oplax_family_at_func K I C D i))
≔ @eq_refl _ _;
