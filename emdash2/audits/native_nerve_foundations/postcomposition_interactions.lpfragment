require open emdash.native_postcomposition_controls;

// Both projection orders of the parameter Hom retain the same arrow.
assert [I A B : Cat] (F G : τ (Functor A B)) (a : τ (@Transf A B F G)) ⊢
  fapp0 (@fapp1_func _ _ (nerve_lax_postcomposition_func I A B) F G) a
  ≡ @fapp1_fapp0 _ _ (nerve_lax_postcomposition_func I A B) F G a;

// Unit and vertical composition agree before/after naming the image.
assert [I A B : Cat] (F : τ (Functor A B)) ⊢
  @nerve_lax_postcomposition_transf I A B F F (@id (Functor_cat A B) F)
  ≡ @id (Functor_cat (Functor_cat I A) (Functor_cat I B)) (@comp_cat_cov_func I A B F);
assert [I A B : Cat] (F G H : τ (Functor A B))
  (a : τ (@Transf A B F G)) (b : τ (@Transf A B G H)) ⊢
  @comp_fapp0 (Functor_cat (Functor_cat I A) (Functor_cat I B)) _ _ _
    (@nerve_lax_postcomposition_transf I A B G H b)
    (@nerve_lax_postcomposition_transf I A B F G a)
  ≡ @fapp1_fapp0 _ _ (nerve_lax_postcomposition_func I A B) F H
      (@comp_fapp0 (Functor_cat A B) F G H b a);

// Stage the known whole component equation before applying Hom action.
// The raw composite's direct conversion failed; no new cut rule is added.
symbol nerve_postcomp_component_path [I A B : Cat]
  (F G : τ (Functor A B)) (D : τ (Functor I A))
  : τ (@= (Functor (@Transf_cat A B F G)
      (@Transf_cat I B (@comp_cat_fapp0 I A B F D) (@comp_cat_fapp0 I A B G D)))
    (@comp_cat_fapp0 _ _ _
      (@tapp0_func (Functor_cat I A) (Functor_cat I B)
        (@comp_cat_cov_func I A B F) (@comp_cat_cov_func I A B G) D)
      (@nerve_lax_postcomposition_hom I A B F G))
    (@comp_cat_con_fapp1_func I A B D F G))
≔ @eq_refl _ _;

// The raw composite projection remains a separate normalization limit.
// Use the actual component ladder below, with the whole agreement above.
assertnot [I A B : Cat] (F G : τ (Functor A B)) (D : τ (Functor I A))
  (a b : τ (@Transf A B F G)) (m : τ (Hom (@Transf_cat A B F G) a b)) ⊢
  @fapp1_fapp0 _ _ (@comp_cat_fapp0 _ _ _
    (@tapp0_func (Functor_cat I A) (Functor_cat I B)
      (@comp_cat_cov_func I A B F) (@comp_cat_cov_func I A B G) D)
    (@nerve_lax_postcomposition_hom I A B F G)) a b m
  ≡ @fapp1_fapp0 _ _ (@comp_cat_con_fapp1_func I A B D F G) a b m;

// Whole/capped evaluation of represented vertical composition.
assert [I B K : Cat] (F : τ (Functor K (Functor_cat I B))) (W : τ (Functor I B))
  (X Y : τ (Obj K)) (p : τ (Hom K X Y)) (i : τ (Obj I))
  (a : τ (@Transf I B W (fapp0 F X))) ⊢
  fapp0 (@comp_cat_fapp0 _ _ _ (@tapp0_func I B W (fapp0 F Y) i)
    (@hom_postcomp_func (Functor_cat I B) K F W X Y p)) a
  ≡ @tapp0_fapp0 I B W (fapp0 F Y) i
      (@hom_postcomp_fapp0 (Functor_cat I B) K F W X Y p a);


// The modification parameter is not discarded by the projection.
assertnot [I A B : Cat] (F G : τ (Functor A B)) (D : τ (Functor I A))
  (a b : τ (@Transf A B F G)) (m n : τ (Hom (@Transf_cat A B F G) a b)) ⊢
  @fapp1_fapp0 _ _ (@comp_cat_con_fapp1_func I A B D F G) a b m
  ≡ @fapp1_fapp0 _ _ (@comp_cat_con_fapp1_func I A B D F G) a b n;

// The explicit component ladder retains the next Hom, without expanding
// the surrounding composite into a second raw representation.
assert [I A B : Cat] (F G : τ (Functor A B)) (D : τ (Functor I A))
  (a b : τ (@Transf A B F G)) (m : τ (Hom (@Transf_cat A B F G) a b)) ⊢
  @tapp0_hom_fapp0 (Functor_cat I A) (Functor_cat I B)
    (@comp_cat_cov_func I A B F) (@comp_cat_cov_func I A B G)
    (@nerve_lax_postcomposition_transf I A B F G a)
    (@nerve_lax_postcomposition_transf I A B F G b) D
    (@fapp1_fapp0 _ _ (@nerve_lax_postcomposition_hom I A B F G) a b m)
  ≡ @fapp1_fapp0 _ _ (@comp_cat_con_fapp1_func I A B D F G) a b m;
