require open emdash.native_higher_staged_unit;

// Original source map F remains arbitrary, and the filler endpoints need
// not be equal. The comparison is derived from the staged generic unit proof.
symbol nerve_generic_whisker_higher_value [A B : Cat]
  (F G : τ (Functor A B)) (Y Z : τ (Obj A)) (p : τ (Hom A Y Z))
  (u : τ (Hom B (@fapp0 A B F Y) (@fapp0 A B G Y))) (v : τ (Hom B (@fapp0 A B F Z) (@fapp0 A B G Z)))
  (alpha beta : τ (Obj (Hom_cat (Hom_cat B (@fapp0 A B F Y) (@fapp0 A B G Z)) (@hom_postcomp_fapp0 B A G (@fapp0 A B F Y) Y Z p u) (@hom_precomp_along_fapp0 A B F (@fapp0 A B G Z) Y Z p v)))) (Gamma : τ (Hom (Hom_cat (Hom_cat B (@fapp0 A B F Y) (@fapp0 A B G Z)) (@hom_postcomp_fapp0 B A G (@fapp0 A B F Y) Y Z p u) (@hom_precomp_along_fapp0 A B F (@fapp0 A B G Z) Y Z p v)) alpha beta))
  : τ (Hom (Hom_cat (Hom_cat B (@fapp0 A B F Y) (@fapp0 A B G Z)) (@hom_postcomp_fapp0 B A G (@fapp0 A B F Y) Y Z p u) (@hom_precomp_along_fapp0 A B F (@fapp0 A B G Z) Y Z p v)) alpha beta)
