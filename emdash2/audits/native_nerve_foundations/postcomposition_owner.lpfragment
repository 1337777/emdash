/* Candidate structural whole postcomposition with ordinary lax parameters.
   Fixed actions are existing operators. Qualification still requires the
   extracted post/left cell; formation/component checks alone do not finish it. */
require open emdash.emdash3_2_diagram_evaluation;

injective symbol nerve_lax_postcomposition_func (I A B : Cat)
  : τ (Functor (Functor_cat A B)
      (Functor_cat (Functor_cat I A) (Functor_cat I B)));
rule @fapp0 _ _ (nerve_lax_postcomposition_func $I $A $B) $F
  ↪ @comp_cat_cov_func $I $A $B $F;

injective symbol nerve_lax_postcomposition_hom [I A B : Cat]
  (F G : τ (Functor A B))
  : τ (Functor (@Transf_cat A B F G)
      (@Transf_cat (Functor_cat I A) (Functor_cat I B)
        (@comp_cat_cov_func I A B F) (@comp_cat_cov_func I A B G)));
rule @fapp1_func _ _ (nerve_lax_postcomposition_func $I $A $B) $F $G
  ↪ @nerve_lax_postcomposition_hom $I $A $B $F $G;

injective symbol nerve_lax_postcomposition_transf [I A B : Cat]
  [F G : τ (Functor A B)] (alpha : τ (@Transf A B F G))
  : τ (@Transf (Functor_cat I A) (Functor_cat I B)
      (@comp_cat_cov_func I A B F) (@comp_cat_cov_func I A B G));
rule @fapp0 _ _ (@nerve_lax_postcomposition_hom $I $A $B $F $G) $alpha
  ↪ @nerve_lax_postcomposition_transf $I $A $B $F $G $alpha;
rule @fapp1_fapp0 _ _ (nerve_lax_postcomposition_func $I $A $B) $F $G $alpha
  ↪ @nerve_lax_postcomposition_transf $I $A $B $F $G $alpha;

// Units and vertical composition at the image preserve the generic root law.
rule @nerve_lax_postcomposition_transf $I $A $B $F $F (@id _ $F)
  ↪ @id (Functor_cat (Functor_cat $I $A) (Functor_cat $I $B)) (@comp_cat_cov_func $I $A $B $F);
// lhs-audit: keep 1 -- measured SR guard for the actual image transformation category.
rule @comp_fapp0 (Functor_cat (Functor_cat $I $A) (Functor_cat $I $B)) _ _ _
    (@nerve_lax_postcomposition_transf $I $A $B $G $H $beta)
    (@nerve_lax_postcomposition_transf $I $A $B $F $G $alpha)
  ↪ @nerve_lax_postcomposition_transf $I $A $B $F $H
      (@comp_fapp0 (Functor_cat $A $B) $F $G $H $beta $alpha);

// The component is the original transformation prewhiskered by D.
rule @tapp0_fapp0 _ _ _ _ $D
    (@nerve_lax_postcomposition_transf $I $A $B $F $G $alpha)
  ↪ @hom_precomp_along_fapp1_fapp0 Cat_cat Cat_cat (@id_func Cat_cat)
      $B $I $A $D $F $G $alpha;

// Whole component action, including modifications of alpha.
rule @comp_fapp0 Cat_cat _ _ _ (@tapp0_func _ _ _ _ $D)
    (@nerve_lax_postcomposition_hom $I $A $B $F $G)
  ↪ @comp_cat_con_fapp1_func $I $A $B $D $F $G;

// Canonical component of the next Hom action. The generic action of a
// composite can project before the whole component equation above; this
// companion restores that measured order without changing the higher input.
rule @tapp0_hom_fapp0 _ _ _ _ _ _ $D
    (@fapp1_fapp0 _ _ (@nerve_lax_postcomposition_hom $I $A $B $F $G) $a $b $m)
  ↪ @fapp1_fapp0 _ _ (@comp_cat_con_fapp1_func $I $A $B $D $F $G) $a $b $m;

// One semantic pre/right body shared by whole and capped projections.
symbol nerve_lax_postcomposition_pre [I A B : Cat]
  [F G : τ (Functor A B)] (alpha : τ (@Transf A B F G))
  (D E : τ (Functor I A))
  : τ (Functor (@Transf_cat I A D E)
      (@Transf_cat I B (@comp_cat_fapp0 I A B F D) (@comp_cat_fapp0 I A B G E)))
≔ @comp_cat_fapp0 (@Transf_cat I A D E)
    (@Transf_cat I B (@comp_cat_fapp0 I A B F D) (@comp_cat_fapp0 I A B F E))
    (@Transf_cat I B (@comp_cat_fapp0 I A B F D) (@comp_cat_fapp0 I A B G E))
    (@hom_postcomp_func (Functor_cat I B) (Functor_cat I B) (@id_func (Functor_cat I B))
      (@comp_cat_fapp0 I A B F D) (@comp_cat_fapp0 I A B F E) (@comp_cat_fapp0 I A B G E)
      (@hom_precomp_along_fapp1_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) B I A E F G alpha))
    (@comp_cat_cov_fapp1_func I A B F D E);
rule @tapp1_func _ _ _ _ $D $E
    (@nerve_lax_postcomposition_transf $I $A $B $F $G $alpha)
  ↪ @nerve_lax_postcomposition_pre $I $A $B $F $G $alpha $D $E;
rule @tapp1_fapp0 _ _ _ _ $D $E
    (@nerve_lax_postcomposition_transf $I $A $B $F $G $alpha) $delta
  ↪ fapp0 (@nerve_lax_postcomposition_pre $I $A $B $F $G $alpha $D $E) $delta;

// Opposite-profile parameter action is a defined dual of the same owner.
symbol nerve_oplax_postcomposition_func (I A B : Cat)
  : τ (Functor (Functor_oplax_cat A B)
      (Functor_oplax_cat (Functor_oplax_cat I A) (Functor_oplax_cat I B)))
≔ @OddDual_func
    (Functor_cat (OddDual_cat A) (OddDual_cat B))
    (Functor_cat (Functor_cat (OddDual_cat I) (OddDual_cat A))
      (Functor_cat (OddDual_cat I) (OddDual_cat B)))
    (nerve_lax_postcomposition_func (OddDual_cat I) (OddDual_cat A) (OddDual_cat B));
