// The walking shape is generated by its original edge. This is a structural
// source-generation contract, not a consequence of pointwise beta alone.
// Keep recursion as its runtime owner; compare self-recursion at proof time.
unif_rule @join_elim_func Terminal_cat Terminal_cat $C
    (@Const_func _ _ $x) (@Const_func _ _ $y) (@Const_func _ _ $u)
  ≡ @id Cat_cat $J
  ↪ [ $C ≡ WalkingArrow_cat; $J ≡ WalkingArrow_cat;
      $x ≡ walking_arrow_src; $y ≡ walking_arrow_tgt;
      $u ≡ walking_arrow_generator ];
