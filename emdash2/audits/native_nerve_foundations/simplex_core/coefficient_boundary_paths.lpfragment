// Whole Cartesian naturality for the source/target arrow projections.
require open emdash.native_triangle_interchange;


// Retain whole fixed-whiskering owners in the theorem type, so a later
// identity specialization uses their existing functor action before capping.
symbol triangle_horizontal_whole_path
  [A : Cat] [W X Y : τ (Obj A)]
  (u v : τ (Hom A W X)) (f g : τ (Hom A X Y))
  (beta : τ (Hom (Hom_cat A W X) u v))
  (alpha : τ (Hom (Hom_cat A X Y) f g))
  : τ (@= (Hom (Hom_cat A W Y)
      (@comp_fapp0 A W X Y f u) (@comp_fapp0 A W X Y g v))
    (@comp_fapp0 (Hom_cat A W Y)
      (@comp_fapp0 A W X Y f u) (@comp_fapp0 A W X Y f v) (@comp_fapp0 A W X Y g v)
      (@fapp1_fapp0 _ _ (@hom_precomp_along_func A A (@id_func A) Y W X v) f g alpha)
      (@fapp1_fapp0 _ _ (@hom_postcomp_func A A (@id_func A) W X Y f) u v beta))
    (@comp_fapp0 (Hom_cat A W Y)
      (@comp_fapp0 A W X Y f u) (@comp_fapp0 A W X Y g u) (@comp_fapp0 A W X Y g v)
      (@fapp1_fapp0 _ _ (@hom_postcomp_func A A (@id_func A) W X Y g) u v beta)
      (@fapp1_fapp0 _ _ (@hom_precomp_along_func A A (@id_func A) Y W X u) f g alpha)))
≔ @triangle_horizontal_interchange_path A W X Y u v f g beta alpha;

symbol triangle_path_target_coeff (C : Cat)
  : τ (Hom (Functor_cart_cat (Op_cat C) Cat_cart)
      (@PathOut_cat_func C) (@Const_catd (Op_cat C) C))
≔ @sigma_proj1_family_funcd (Op_cat C) C (@hom_int C C (@id_func C));

symbol triangle_source_const_coeff (C : Cat)
  : τ (Hom (Functor_cart_cat (Op_cat C) Cat_cart)
      (@Const_catd (Op_cat C) (LaxArrow_cat C)) (@Const_catd (Op_cat C) C))
≔ @fapp1_fapp0 _ _ (@comp_cat_con_cart_func (Op_cat C) Cat_cart Cat_cart (@Const_catd (Op_cat C) C))
    nerve_native_arrow_coeff (@id_func Cat_cart) nerve_native_arrow_source_coeff;

symbol triangle_source_coeff_naturality (C : Cat)
  : τ (@= (Hom (Functor_cart_cat (Op_cat C) Cat_cart)
      (nerve_triangle_fibres C) (@Const_catd (Op_cat C) C))
    (@comp_fapp0 (Functor_cart_cat (Op_cat C) Cat_cart)
      (nerve_triangle_fibres C) (@Const_catd (Op_cat C) (LaxArrow_cat C)) (@Const_catd (Op_cat C) C)
      (triangle_source_const_coeff C) (nerve_triangle_third_edge_funcd C))
    (@comp_fapp0 (Functor_cart_cat (Op_cat C) Cat_cart)
      (nerve_triangle_fibres C) (@PathOut_cat_func C) (@Const_catd (Op_cat C) C)
      (triangle_path_target_coeff C) (nerve_triangle_first_edge_funcd C)))
≔ @triangle_horizontal_whole_path Cat_cart (Op_cat C) Cat_cart Cat_cart
    (@PathOut_cat_func C) (@Const_catd (Op_cat C) C)
    nerve_native_arrow_coeff (@id_func Cat_cart)
    (triangle_path_target_coeff C) nerve_native_arrow_source_coeff;

symbol triangle_target_const_coeff (C : Cat)
  : τ (Hom (Functor_cart_cat (Op_cat C) Cat_cart)
      (@Const_catd (Op_cat C) (LaxArrow_cat C)) (@Const_catd (Op_cat C) C))
≔ @fapp1_fapp0 _ _ (@comp_cat_con_cart_func (Op_cat C) Cat_cart Cat_cart (@Const_catd (Op_cat C) C))
    nerve_native_arrow_coeff (@id_func Cat_cart) nerve_native_arrow_target_coeff;

symbol triangle_target_coeff_naturality (C : Cat)
  : τ (@= (Hom (Functor_cart_cat (Op_cat C) Cat_cart)
      (nerve_triangle_fibres C) (@Const_catd (Op_cat C) C))
    (@comp_fapp0 (Functor_cart_cat (Op_cat C) Cat_cart)
      (nerve_triangle_fibres C) (@Const_catd (Op_cat C) (LaxArrow_cat C)) (@Const_catd (Op_cat C) C)
      (triangle_target_const_coeff C) (nerve_triangle_third_edge_funcd C))
    (@comp_fapp0 (Functor_cart_cat (Op_cat C) Cat_cart)
      (nerve_triangle_fibres C) (@PathOut_cat_func C) (@Const_catd (Op_cat C) C)
      (triangle_path_target_coeff C) (nerve_triangle_second_edge_funcd C)))
≔ @triangle_horizontal_whole_path Cat_cart (Op_cat C) Cat_cart Cat_cart
    (@PathOut_cat_func C) (@Const_catd (Op_cat C) C)
    nerve_native_arrow_coeff (@id_func Cat_cart)
    (triangle_path_target_coeff C) nerve_native_arrow_target_coeff;

// Distinct universal endpoint projections must not be identified.
assertnot [C : Cat] ⊢
  @eq_refl (Hom (Functor_cart_cat (Op_cat C) Cat_cart)
      (nerve_triangle_fibres C) (@Const_catd (Op_cat C) C))
    (@comp_fapp0 (Functor_cart_cat (Op_cat C) Cat_cart)
      (nerve_triangle_fibres C) (@PathOut_cat_func C) (@Const_catd (Op_cat C) C)
      (triangle_path_target_coeff C) (nerve_triangle_first_edge_funcd C))
  : τ (@= (Hom (Functor_cart_cat (Op_cat C) Cat_cart)
      (nerve_triangle_fibres C) (@Const_catd (Op_cat C) C))
    (@comp_fapp0 (Functor_cart_cat (Op_cat C) Cat_cart)
      (nerve_triangle_fibres C) (@PathOut_cat_func C) (@Const_catd (Op_cat C) C)
      (triangle_path_target_coeff C) (nerve_triangle_first_edge_funcd C))
    (@comp_fapp0 (Functor_cart_cat (Op_cat C) Cat_cart)
      (nerve_triangle_fibres C) (@PathOut_cat_func C) (@Const_catd (Op_cat C) C)
      (triangle_path_target_coeff C) (nerve_triangle_second_edge_funcd C)));
