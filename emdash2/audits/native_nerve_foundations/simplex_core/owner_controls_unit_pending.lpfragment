require open emdash.native_simplex_triangle_consumer;

// Whole-vs-preprojected action of the constant-family composition beta.
assert [K B : Cat] (F : τ (Functor Cat_cart B)) (C : Cat)
  (x y : τ (Obj K)) ⊢
  @fapp1_func K B (@comp_cat_fapp0 K Cat_cart B F (@Const_catd K C)) x y
  ≡ @comp_cat_fapp0 (Hom_cat K x y) (Functor_cart_cat C C) (Hom_cat B (fapp0 F C) (fapp0 F C))
      (@fapp1_func Cat_cart B F C C) (@fapp1_func K Cat_cart (@Const_catd K C) x y);
assert [K B : Cat] (F : τ (Functor Cat_cart B)) (C : Cat)
  (x y : τ (Obj K)) (p : τ (Hom K x y)) ⊢
  @fapp1_fapp0 Cat_cart B F C C (@fapp1_fapp0 K Cat_cart (@Const_catd K C) x y p)
  ≡ @id B (fapp0 F C);

// A genuine native square tests the canonical capability's operational fields.
assert [C : Cat] (x1 y1 x2 y2 : τ (Obj C))
  (u : τ (Hom C x1 x2)) (v : τ (Hom C y1 y2))
  (a : τ (Hom C x1 y1)) (b : τ (Hom C x2 y2))
  (alpha : τ (Obj (@homdc_square_fibre C x1 y1 x2 y2 u v a b))) ⊢
  @fapp1_fapp0 _ _ (@nerve_native_arrow_map C C (@id_func C))
    (@lax_edge C x1 x2 u) (@lax_edge C y1 y2 v)
    (@lax_square C x1 y1 x2 y2 u v a b alpha)
  ≡ @lax_square C x1 y1 x2 y2 u v a b alpha;
