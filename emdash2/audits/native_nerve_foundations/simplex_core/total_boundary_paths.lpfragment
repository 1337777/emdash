/* Carry the whole coefficient equation through the existing totalization.
   The resulting comparison still has its actual total-map owners. */
require open emdash.native_triangle_coefficient_boundary_proved;
require open emdash.native_higher_triangle_qualification;

symbol triangle_dual_sigma_map [K : Cat] [E D : τ (Catd K)]
  (U : τ (Hom (Functor_cart_cat K Cat_cart) E D))
  : τ (Functor (@Sigma_cat (CoAbove2_cat K) (@TotalOp_catd K E))
      (@Sigma_cat (CoAbove2_cat K) (@TotalOp_catd K D)))
≔ @fapp1_fapp0 (CoAbove2_cat (Functor_cart_cat K Cat_cart)) Cat_cart
    (@comp_cat_fapp0 (CoAbove2_cat (Functor_cart_cat K Cat_cart))
      (Functor_cart_cat (CoAbove2_cat K) Cat_cart) Cat_cart
      (@Sigma_coeff_func (CoAbove2_cat K)) (@TotalOp_catd_func K)) E D U;

symbol triangle_dual_sigma_comp_path [K : Cat] [E M D : τ (Catd K)]
  (F : τ (Hom (Functor_cart_cat K Cat_cart) E M))
  (G : τ (Hom (Functor_cart_cat K Cat_cart) M D))
  : τ (@= (Functor (@Sigma_cat (CoAbove2_cat K) (@TotalOp_catd K E))
      (@Sigma_cat (CoAbove2_cat K) (@TotalOp_catd K D)))
    (@triangle_dual_sigma_map K E D (@comp_fapp0 (Functor_cart_cat K Cat_cart) E M D G F))
    (@comp_cat_fapp0 _ _ _ (@triangle_dual_sigma_map K M D G) (@triangle_dual_sigma_map K E M F)))
≔ @functor_composition_path (CoAbove2_cat (Functor_cart_cat K Cat_cart)) Cat_cart
    (@comp_cat_fapp0 (CoAbove2_cat (Functor_cart_cat K Cat_cart))
      (Functor_cart_cat (CoAbove2_cat K) Cat_cart) Cat_cart
      (@Sigma_coeff_func (CoAbove2_cat K)) (@TotalOp_catd_func K)) E M D G F;

// The alias is precisely the old Sigma map of the total-dual coefficient map.
assert [K : Cat] (E D : τ (Catd K)) (U : τ (Hom (Functor_cart_cat K Cat_cart) E D)) ⊢
  @triangle_dual_sigma_map K E D U
  ≡ @sigma_map_func (CoAbove2_cat K) (@TotalOp_catd K E) (@TotalOp_catd K D)
      (@strict_transfor _ _ _ _ (@TotalOp_funcd K E D U));

symbol triangle_source_total_image_path (C : Cat)
  : τ (@= (Functor
      (@Sigma_cat (TotalOp_cat C) (nerve_triangle_dual_fibres C))
      (Product_cat (TotalOp_cat C) (TotalOp_cat C)))
    (@triangle_dual_sigma_map (Op_cat C) (nerve_triangle_fibres C) (@Const_catd (Op_cat C) C)
      (@comp_fapp0 (Functor_cart_cat (Op_cat C) Cat_cart)
        (nerve_triangle_fibres C) (@Const_catd (Op_cat C) (LaxArrow_cat C)) (@Const_catd (Op_cat C) C)
        (triangle_source_const_coeff C) (nerve_triangle_third_edge_funcd C)))
    (@triangle_dual_sigma_map (Op_cat C) (nerve_triangle_fibres C) (@Const_catd (Op_cat C) C)
      (@comp_fapp0 (Functor_cart_cat (Op_cat C) Cat_cart)
        (nerve_triangle_fibres C) (@PathOut_cat_func C) (@Const_catd (Op_cat C) C)
        (triangle_path_target_coeff C) (nerve_triangle_first_edge_funcd C))))
≔ @eq_ap
    (Hom (Functor_cart_cat (Op_cat C) Cat_cart) (nerve_triangle_fibres C) (@Const_catd (Op_cat C) C))
    (Functor (@Sigma_cat (TotalOp_cat C) (nerve_triangle_dual_fibres C))
      (Product_cat (TotalOp_cat C) (TotalOp_cat C)))
    (λ U, @triangle_dual_sigma_map (Op_cat C) (nerve_triangle_fibres C) (@Const_catd (Op_cat C) C) U)
    _ _ (triangle_source_coeff_naturality C);

symbol triangle_target_total_image_path (C : Cat)
  : τ (@= (Functor
      (@Sigma_cat (TotalOp_cat C) (nerve_triangle_dual_fibres C))
      (Product_cat (TotalOp_cat C) (TotalOp_cat C)))
    (@triangle_dual_sigma_map (Op_cat C) (nerve_triangle_fibres C) (@Const_catd (Op_cat C) C)
      (@comp_fapp0 (Functor_cart_cat (Op_cat C) Cat_cart)
        (nerve_triangle_fibres C) (@Const_catd (Op_cat C) (LaxArrow_cat C)) (@Const_catd (Op_cat C) C)
        (triangle_target_const_coeff C) (nerve_triangle_third_edge_funcd C)))
    (@triangle_dual_sigma_map (Op_cat C) (nerve_triangle_fibres C) (@Const_catd (Op_cat C) C)
      (@comp_fapp0 (Functor_cart_cat (Op_cat C) Cat_cart)
        (nerve_triangle_fibres C) (@PathOut_cat_func C) (@Const_catd (Op_cat C) C)
        (triangle_path_target_coeff C) (nerve_triangle_second_edge_funcd C))))
≔ @eq_ap
    (Hom (Functor_cart_cat (Op_cat C) Cat_cart) (nerve_triangle_fibres C) (@Const_catd (Op_cat C) C))
    (Functor (@Sigma_cat (TotalOp_cat C) (nerve_triangle_dual_fibres C))
      (Product_cat (TotalOp_cat C) (TotalOp_cat C)))
    (λ U, @triangle_dual_sigma_map (Op_cat C) (nerve_triangle_fibres C) (@Const_catd (Op_cat C) C) U)
    _ _ (triangle_target_coeff_naturality C);

// The actual total-map composites, with both intermediate totals retained.
symbol triangle_source_total_naturality (C : Cat)
  : τ (@= (Functor
      (@Sigma_cat (TotalOp_cat C) (nerve_triangle_dual_fibres C))
      (Product_cat (TotalOp_cat C) (TotalOp_cat C)))
    (@comp_cat_fapp0 _ _ _
      (@triangle_dual_sigma_map (Op_cat C)
        (@Const_catd (Op_cat C) (LaxArrow_cat C)) (@Const_catd (Op_cat C) C)
        (triangle_source_const_coeff C))
      (@triangle_dual_sigma_map (Op_cat C)
        (nerve_triangle_fibres C) (@Const_catd (Op_cat C) (LaxArrow_cat C))
        (nerve_triangle_third_edge_funcd C)))
    (@comp_cat_fapp0 _ _ _
      (@triangle_dual_sigma_map (Op_cat C)
        (@PathOut_cat_func C) (@Const_catd (Op_cat C) C) (triangle_path_target_coeff C))
      (@triangle_dual_sigma_map (Op_cat C)
        (nerve_triangle_fibres C) (@PathOut_cat_func C) (nerve_triangle_first_edge_funcd C))))
≔ @eq_trans _ _ _ _
    (@eq_sym _ _ _
      (@triangle_dual_sigma_comp_path (Op_cat C)
        (nerve_triangle_fibres C) (@Const_catd (Op_cat C) (LaxArrow_cat C)) (@Const_catd (Op_cat C) C)
        (nerve_triangle_third_edge_funcd C) (triangle_source_const_coeff C)))
    (@eq_trans _ _ _ _ (triangle_source_total_image_path C)
      (@triangle_dual_sigma_comp_path (Op_cat C)
        (nerve_triangle_fibres C) (@PathOut_cat_func C) (@Const_catd (Op_cat C) C)
        (nerve_triangle_first_edge_funcd C) (triangle_path_target_coeff C)));

// The actual total-map composites, with both intermediate totals retained.
symbol triangle_target_total_naturality (C : Cat)
  : τ (@= (Functor
      (@Sigma_cat (TotalOp_cat C) (nerve_triangle_dual_fibres C))
      (Product_cat (TotalOp_cat C) (TotalOp_cat C)))
    (@comp_cat_fapp0 _ _ _
      (@triangle_dual_sigma_map (Op_cat C)
        (@Const_catd (Op_cat C) (LaxArrow_cat C)) (@Const_catd (Op_cat C) C)
        (triangle_target_const_coeff C))
      (@triangle_dual_sigma_map (Op_cat C)
        (nerve_triangle_fibres C) (@Const_catd (Op_cat C) (LaxArrow_cat C))
        (nerve_triangle_third_edge_funcd C)))
    (@comp_cat_fapp0 _ _ _
      (@triangle_dual_sigma_map (Op_cat C)
        (@PathOut_cat_func C) (@Const_catd (Op_cat C) C) (triangle_path_target_coeff C))
      (@triangle_dual_sigma_map (Op_cat C)
        (nerve_triangle_fibres C) (@PathOut_cat_func C) (nerve_triangle_second_edge_funcd C))))
≔ @eq_trans _ _ _ _
    (@eq_sym _ _ _
      (@triangle_dual_sigma_comp_path (Op_cat C)
        (nerve_triangle_fibres C) (@Const_catd (Op_cat C) (LaxArrow_cat C)) (@Const_catd (Op_cat C) C)
        (nerve_triangle_third_edge_funcd C) (triangle_target_const_coeff C)))
    (@eq_trans _ _ _ _ (triangle_target_total_image_path C)
      (@triangle_dual_sigma_comp_path (Op_cat C)
        (nerve_triangle_fibres C) (@PathOut_cat_func C) (@Const_catd (Op_cat C) C)
        (nerve_triangle_second_edge_funcd C) (triangle_path_target_coeff C)));
