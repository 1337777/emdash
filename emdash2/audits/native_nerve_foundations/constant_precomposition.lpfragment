require open emdash.native_terminal_contraction;

// Whole constant-shape precomposition versus weakening after evaluation.
symbol nerve_constant_precomposition [A B C : Cat] (b : τ (Obj B))
  : τ (@= (Functor (Functor_cat B C) (Functor_cat A C))
      (@comp_cat_con_func A B C (@Const_func A B b))
      (@comp_cat_fapp0 (Functor_cat B C) C (Functor_cat A C)
        (@comp_cat_fapp0 C (Functor_cart_cat A C) (Functor_cat A C)
          (Functor_cart_include A C) (@Const_func_func A C))
        (@fapp0_func B C b)))
≔ @eq_refl _ _;

symbol nerve_terminal_mapping_eta (C : Cat)
  : τ (@= (Functor (Functor_cat Terminal_cat C) (Functor_cat Terminal_cat C))
      (@comp_cat_fapp0 (Functor_cat Terminal_cat C) C (Functor_cat Terminal_cat C)
        (@comp_cat_fapp0 C (Functor_cart_cat Terminal_cat C) (Functor_cat Terminal_cat C)
          (Functor_cart_include Terminal_cat C) (@Const_func_func Terminal_cat C))
        (@fapp0_func Terminal_cat C Terminal_obj))
      (@id_func (Functor_cat Terminal_cat C)))
≔ @eq_trans _ _ _ _
    (@eq_sym _ _ _ (@nerve_constant_precomposition Terminal_cat Terminal_cat C Terminal_obj))
    (nerve_terminal_precompose_contraction C);
