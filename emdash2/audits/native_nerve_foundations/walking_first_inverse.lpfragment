// Reconstruct the actual realized graph using whole endpoint/generator beta
// and source generation. No inverse equation is declared as a primitive.
symbol nerve_realize_graph_path [B C : Cat] [F G : τ (Functor B C)]
  (L : τ (@LaxTransfor B C F G))
  : τ (@= (Functor B (Functor_oplax_cat WalkingArrow_cat C))
      (@comp_cat_fapp0 B (@LaxArrow_cat C) (Functor_oplax_cat WalkingArrow_cat C)
        (nerve_walking_realize_func C) (@gray_transf_graph_func B C F G L))
      (@transf_arrow_diagram_func B C F G (@lax_transfor B C F G L)))
≔ @eq_trans (Functor B (Functor_oplax_cat WalkingArrow_cat C))
    (@comp_cat_fapp0 B (@LaxArrow_cat C) (Functor_oplax_cat WalkingArrow_cat C)
      (nerve_walking_realize_func C) (@gray_transf_graph_func B C F G L))
    (@transf_arrow_diagram_func B C F G
      (@diagram_oplax_family_transf B WalkingArrow_cat C
        (@comp_cat_fapp0 B (@LaxArrow_cat C) (Functor_oplax_cat WalkingArrow_cat C)
          (nerve_walking_realize_func C) (@gray_transf_graph_func B C F G L))
        walking_arrow_src walking_arrow_tgt walking_arrow_generator))
    (@transf_arrow_diagram_func B C F G (@lax_transfor B C F G L))
    (@eq_sym (Functor B (Functor_oplax_cat WalkingArrow_cat C)) _ _
      (@nerve_walking_oplax_family_reconstruction_path B C
        (@comp_cat_fapp0 B (@LaxArrow_cat C) (Functor_oplax_cat WalkingArrow_cat C)
          (nerve_walking_realize_func C) (@gray_transf_graph_func B C F G L))))
    (@eq_ap (@Transf B C F G) (Functor B (Functor_oplax_cat WalkingArrow_cat C))
      (λ eta : τ (@Transf B C F G), @transf_arrow_diagram_func B C F G eta)
      _ _ (@nerve_realize_graph_generator_path B C F G L));

// The same reconstruction specialized to the whole evaluator.
symbol nerve_walking_evaluator_reconstruction_path (C : Cat)
  : τ (@= (Functor (Functor_oplax_cat WalkingArrow_cat C)
      (Functor_oplax_cat WalkingArrow_cat C))
      (@transf_arrow_diagram_func (Functor_oplax_cat WalkingArrow_cat C) C
        (@diagram_oplax_evaluation_at_func WalkingArrow_cat C walking_arrow_src)
        (@diagram_oplax_evaluation_at_func WalkingArrow_cat C walking_arrow_tgt)
        (nerve_walking_eval_transf C))
      (@id_func (Functor_oplax_cat WalkingArrow_cat C)))
≔ @nerve_walking_oplax_family_reconstruction_path
    (Functor_oplax_cat WalkingArrow_cat C) C
    (@id_func (Functor_oplax_cat WalkingArrow_cat C));

symbol nerve_walking_realize_observe_path (C : Cat)
  : τ (@= (Functor (Functor_oplax_cat WalkingArrow_cat C)
      (Functor_oplax_cat WalkingArrow_cat C))
      (@comp_cat_fapp0 (Functor_oplax_cat WalkingArrow_cat C) (@LaxArrow_cat C)
        (Functor_oplax_cat WalkingArrow_cat C)
        (nerve_walking_realize_func C) (nerve_walking_observe_func C))
      (@id_func (Functor_oplax_cat WalkingArrow_cat C)))
≔ @eq_trans (Functor (Functor_oplax_cat WalkingArrow_cat C)
    (Functor_oplax_cat WalkingArrow_cat C))
    (@comp_cat_fapp0 (Functor_oplax_cat WalkingArrow_cat C) (@LaxArrow_cat C)
      (Functor_oplax_cat WalkingArrow_cat C)
      (nerve_walking_realize_func C) (nerve_walking_observe_func C))
    (@transf_arrow_diagram_func (Functor_oplax_cat WalkingArrow_cat C) C
      (@diagram_oplax_evaluation_at_func WalkingArrow_cat C walking_arrow_src)
      (@diagram_oplax_evaluation_at_func WalkingArrow_cat C walking_arrow_tgt)
      (@lax_transfor _ _ _ _ (nerve_walking_eval_lax C)))
    (@id_func (Functor_oplax_cat WalkingArrow_cat C))
    (@nerve_realize_graph_path (Functor_oplax_cat WalkingArrow_cat C) C
      (@diagram_oplax_evaluation_at_func WalkingArrow_cat C walking_arrow_src)
      (@diagram_oplax_evaluation_at_func WalkingArrow_cat C walking_arrow_tgt)
      (nerve_walking_eval_lax C))
    (@eq_trans (Functor (Functor_oplax_cat WalkingArrow_cat C)
      (Functor_oplax_cat WalkingArrow_cat C))
      (@transf_arrow_diagram_func (Functor_oplax_cat WalkingArrow_cat C) C
        (@diagram_oplax_evaluation_at_func WalkingArrow_cat C walking_arrow_src)
        (@diagram_oplax_evaluation_at_func WalkingArrow_cat C walking_arrow_tgt)
        (@lax_transfor _ _ _ _ (nerve_walking_eval_lax C)))
      (@transf_arrow_diagram_func (Functor_oplax_cat WalkingArrow_cat C) C
        (@diagram_oplax_evaluation_at_func WalkingArrow_cat C walking_arrow_src)
        (@diagram_oplax_evaluation_at_func WalkingArrow_cat C walking_arrow_tgt)
        (nerve_walking_eval_transf C))
      (@id_func (Functor_oplax_cat WalkingArrow_cat C))
      (@eq_ap (@Transf (Functor_oplax_cat WalkingArrow_cat C) C
          (@diagram_oplax_evaluation_at_func WalkingArrow_cat C walking_arrow_src)
          (@diagram_oplax_evaluation_at_func WalkingArrow_cat C walking_arrow_tgt))
        (Functor (Functor_oplax_cat WalkingArrow_cat C) (Functor_oplax_cat WalkingArrow_cat C))
        (λ eta : τ (@Transf (Functor_oplax_cat WalkingArrow_cat C) C
          (@diagram_oplax_evaluation_at_func WalkingArrow_cat C walking_arrow_src)
          (@diagram_oplax_evaluation_at_func WalkingArrow_cat C walking_arrow_tgt)),
          @transf_arrow_diagram_func (Functor_oplax_cat WalkingArrow_cat C) C
            (@diagram_oplax_evaluation_at_func WalkingArrow_cat C walking_arrow_src)
            (@diagram_oplax_evaluation_at_func WalkingArrow_cat C walking_arrow_tgt) eta)
        _ _ (@make_lax_transfor_carrier_path _ _ _ _ (nerve_walking_eval_transf C)
          (@nerve_default_lax_profile _ _ _ _ (nerve_walking_eval_transf C))))
      (nerve_walking_evaluator_reconstruction_path C));
