require open emdash.native_canonical_moving_stable;

// Existing Sigma fibre inclusion, specialized to its negative Hom total.
// This is a definition of a whole map, with no supplied equation or filler.
symbol nerve_sigma_arrow_fibre_func [K : Cat] (E : τ (Catd K))
  (x y : τ (Obj K)) (u : τ (Obj (@Fibre_cat K E x)))
  (v : τ (Obj (@Fibre_cat K E y))) (p : τ (Hom K x y))
  : τ (Functor
      (Hom_cat (@Fibre_cat K E y)
        (fapp0 (@catd_transport_func K E x y p) u) v)
      (Hom_cat (@Sigma_cat K E) (Struct_sigma x u) (Struct_sigma y v)))
≔ @TotalOp_func
    (TotalOp_cat (Hom_cat (@Fibre_cat K E y)
      (fapp0 (@catd_transport_func K E x y p) u) v))
    (@Sigma_cat (TotalOp_cat (Hom_cat K x y))
      (@TotalOp_catd (Op_cat (Hom_cat K x y)) (@homd_ K E E (@id_funcd K E) x u y v)))
    (@sigma_intro_tapp0_func (TotalOp_cat (Hom_cat K x y))
      (@TotalOp_catd (Op_cat (Hom_cat K x y)) (@homd_ K E E (@id_funcd K E) x u y v)) p);

symbol nerve_pathout_2cell_func [C : Cat]
  (x y z : τ (Obj C)) (u : τ (Hom C x y)) (t : τ (Hom C x z))
  (b b1 : τ (Hom C y z))
  (alpha : τ (Hom (Hom_cat C x z) (@comp_fapp0 C x y z b u) t))
  (beta : τ (Hom (Hom_cat C x z) (@comp_fapp0 C x y z b1 u) t))
  (B : τ (Hom (Hom_cat C y z) b b1))
  : τ (Functor
      (Hom_cat (Hom_cat (Hom_cat C x z) (@comp_fapp0 C x y z b u) t)
        alpha (@hom_precomp_along_fapp0 (Hom_cat C y z) (Hom_cat C x z)
          (@hom_precomp_along_func C C (@id_func C) z x y u) t b b1 B beta))
      (Hom_cat (Hom_cat (@PathOut_cat C x) (@pathout_obj C x y u) (@pathout_obj C x z t))
        (Struct_sigma b alpha) (Struct_sigma b1 beta)))
≔ @TotalOp_func _ _
    (@nerve_sigma_arrow_fibre_func (TotalOp_cat (Hom_cat C y z))
      (@TotalOp_catd (Op_cat (Hom_cat C y z))
        (@homd_ C (@hom_ C C (@id_func C) x) (@hom_ C C (@id_func C) x)
          (@id_funcd C (@hom_ C C (@id_func C) x)) y u z t))
      b1 b beta alpha B);
