// Direct scalar image presentation for contravariant precomposition.
// The original F and p remain on the precomposition side; the actual image
// is compared as data, rather than inferred backwards through F.
unif_rule @hom_precomp_along_fapp0 $A $B $F $Z $X $Y $p $v
  ≡ @hom_postcomp_fapp0 $B0 $B0 (@id Cat_cat $B0) $FX $FY $Z0 $v0 $image
  ↪ [ $B0 ≡ $B; $Z0 ≡ $Z; $v0 ≡ $v;
      $FX ≡ @fapp0 $A $B $F $X; $FY ≡ @fapp0 $A $B $F $Y;
      $image ≡ @fapp1_fapp0 $A $B $F $X $Y $p ];
