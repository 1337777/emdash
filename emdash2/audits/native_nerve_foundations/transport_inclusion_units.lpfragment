assert [K A : Cat] (k : τ (Obj K)) (u : τ (Obj (Terminal_cat))) ⊢
  @sigma_arrow K (@Const_catd K (Terminal_cat)) k k u u (@id K k) (@id (Terminal_cat) u)
  ≡ @id (@Sigma_cat K (@Const_catd K (Terminal_cat))) (Struct_sigma k u);
