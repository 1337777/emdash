require open emdash.emdash3_2;

// A section is a displayed map from the terminal family. Totalizing it
// therefore has this existing Sigma-map / product-unit presentation.
symbol nerve_section_total_via_sigma [K : Cat] (E : τ (Catd K))
  (s : τ (Obj (@Pi_cat K E))) : τ (Functor K (@Sigma_cat K E))
≔ @comp_cat_fapp0 K (@Sigma_cat K (@Const_catd K Terminal_cat)) (@Sigma_cat K E)
    (@sigma_map_func K (@Const_catd K Terminal_cat) E s)
    (@Product_pair (Functor_cat K K) (Functor_cat K Terminal_cat)
      (@id_func K) (@Const_func K Terminal_cat Terminal_obj));

assert [K : Cat] (E : τ (Catd K)) (s : τ (Obj (@Pi_cat K E)))
  (x : τ (Obj K)) ⊢
  @fapp0 K (@Sigma_cat K E) (@nerve_section_total_via_sigma K E s) x
  ≡ @fapp0 K (@Sigma_cat K E) (@section_total_func K E s) x;

assert [K : Cat] (E : τ (Catd K)) (s : τ (Obj (@Pi_cat K E)))
  (x y : τ (Obj K)) (p : τ (Hom K x y)) ⊢
  @fapp1_fapp0 K (@Sigma_cat K E) (@nerve_section_total_via_sigma K E s) x y p
  ≡ @fapp1_fapp0 K (@Sigma_cat K E) (@section_total_func K E s) x y p;
