/* Whole first-factor tensor action derived from the selected right closure.
   No tensor-action primitive, symmetry or coherence law is introduced. */
require open emdash.native_reverse_closure_objects;

symbol nerve_tensor_left_action_func (A D B : Cat)
  : τ (Functor (Functor_cat A D)
      (Functor_cat (GrayTensor_R A B) (GrayTensor_R D B)))
≔ @comp_cat_fapp0 _ _ _
    (@grayhom_lax_include_func (GrayTensor_R A B) (GrayTensor_R D B))
    (@comp_cat_fapp0 _ _ _
      (gray_uncurry_R_func A B (GrayTensor_R D B))
      (@comp_cat_fapp0 _ _ _
        (nerve_lax_profile_admit_func A (GrayHom_lax B (GrayTensor_R D B)))
        (@comp_cat_cov_func A D (GrayHom_lax B (GrayTensor_R D B))
          (gray_coevaluation_R_func D B))));

symbol nerve_tensor_left_map [A D B : Cat] (F : τ (Functor A D))
  : τ (Functor (GrayTensor_R A B) (GrayTensor_R D B))
≔ fapp0 (nerve_tensor_left_action_func A D B) F;

// Stage the existing represented/raw composition comparison before uncurry.
symbol nerve_postcomposition_value_path [X Y Z : Cat]
  (F : τ (Functor Y Z)) (D : τ (Functor X Y))
  : τ (@= (Functor X Z)
      (@fapp0 (Functor_cat X Y) (Functor_cat X Z) (@comp_cat_cov_func X Y Z F) D)
      (@comp_cat_fapp0 X Y Z F D))
≔ @eq_refl (Functor X Z) (@comp_cat_fapp0 X Y Z F D);

// The entire underlying tensor map is right-uncurry of the original F.
symbol nerve_tensor_left_map_body [A D B : Cat] (F : τ (Functor A D))
  : τ (@= (Functor (GrayTensor_R A B) (GrayTensor_R D B))
      (@nerve_tensor_left_map A D B F)
      (@gray_uncurry_R A B (GrayTensor_R D B)
        (@comp_cat_fapp0 A D (GrayHom_lax B (GrayTensor_R D B))
          (gray_coevaluation_R_func D B) F)))
≔ @eq_ap (Functor A (GrayHom_lax B (GrayTensor_R D B)))
    (Functor (GrayTensor_R A B) (GrayTensor_R D B))
    (λ H : τ (Functor A (GrayHom_lax B (GrayTensor_R D B))),
      @gray_uncurry_R A B (GrayTensor_R D B) H)
    (@fapp0 _ _
      (@comp_cat_cov_func A D (GrayHom_lax B (GrayTensor_R D B))
        (gray_coevaluation_R_func D B)) F)
    (@comp_cat_fapp0 A D (GrayHom_lax B (GrayTensor_R D B))
      (gray_coevaluation_R_func D B) F)
    (@nerve_postcomposition_value_path A D (GrayHom_lax B (GrayTensor_R D B))
      (gray_coevaluation_R_func D B) F);

// Identity uses the already retained closure inverse, not a new tensor law.
symbol nerve_tensor_left_identity (A B : Cat)
  : τ (@= (Functor (GrayTensor_R A B) (GrayTensor_R A B))
      (@nerve_tensor_left_map A A B (@id_func A))
      (@id_func (GrayTensor_R A B)))
≔ @eq_trans _ _ _ _
    (@nerve_tensor_left_map_body A A B (@id_func A))
    (@gray_uncurry_curry_R_at A B (GrayTensor_R A B) (@id_func (GrayTensor_R A B)));

// Whole right-curried readback retains F's complete higher action.
symbol nerve_tensor_left_curried [A D B : Cat] (F : τ (Functor A D))
  : τ (@= (Functor A (GrayHom_lax B (GrayTensor_R D B)))
      (@gray_curry_R A B (GrayTensor_R D B) (@nerve_tensor_left_map A D B F))
      (@comp_cat_fapp0 A D (GrayHom_lax B (GrayTensor_R D B))
        (gray_coevaluation_R_func D B) F))
≔ @eq_trans _ _ _ _
    (@eq_ap (Functor (GrayTensor_R A B) (GrayTensor_R D B))
      (Functor A (GrayHom_lax B (GrayTensor_R D B)))
      (λ H : τ (Functor (GrayTensor_R A B) (GrayTensor_R D B)),
        @gray_curry_R A B (GrayTensor_R D B) H)
      _ _ (@nerve_tensor_left_map_body A D B F))
    (@gray_curry_uncurry_R_at A B (GrayTensor_R D B)
      (@comp_cat_fapp0 A D (GrayHom_lax B (GrayTensor_R D B))
        (gray_coevaluation_R_func D B) F));

// The constructor is genuinely whole in its first-factor functor argument.
symbol nerve_tensor_left_parameter_hom [A D B : Cat]
  (F G : τ (Functor A D))
  : τ (Functor (@Transf_cat A D F G)
      (@Transf_cat (GrayTensor_R A B) (GrayTensor_R D B)
        (@nerve_tensor_left_map A D B F) (@nerve_tensor_left_map A D B G)))
≔ @fapp1_func _ _ (nerve_tensor_left_action_func A D B) F G;
