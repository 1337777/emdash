diff --git a/src/pure/pure.ml b/src/pure/pure.ml
index 419e6aa2..1d3cda53 100644
--- a/src/pure/pure.ml
+++ b/src/pure/pure.ml
@@ -134 +134 @@ type tactic_result =
-let t0 : Time.t Stdlib.ref = Stdlib.ref (Time.save ())
+let t0 : Time.t option Stdlib.ref = Stdlib.ref (Some (Time.save ()))
@@ -137 +137,9 @@ let set_initial_time : unit -> unit = fun _ ->
-  Stdlib.(t0 := Time.save ())
+  Stdlib.(t0 := Some (Time.save ()))
+
+let release_initial_time : unit -> unit = fun _ ->
+  Stdlib.(t0 := None)
+
+let initial_time : unit -> Time.t = fun _ ->
+  match Stdlib.(!t0) with
+  | Some t -> t
+  | None -> let t = Time.save () in Stdlib.(t0 := Some t); t
@@ -141 +149 @@ let initial_state : string -> state = fun fname ->
-  Time.restore Stdlib.(!t0);
+  Time.restore (initial_time ());
