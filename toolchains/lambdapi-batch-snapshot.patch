diff --git a/src/cli/lambdapi.ml b/src/cli/lambdapi.ml
index dbd3f19a..991196e5 100644
--- a/src/cli/lambdapi.ml
+++ b/src/cli/lambdapi.ml
@@ -99,2 +99,5 @@ let check_cmd : Config.t -> int option -> string list -> unit =
-    (* We save time to run each file in the same environment. *)
-    let time = Time.save () in
+    (* One input cannot return to the pre-check environment. Keeping a
